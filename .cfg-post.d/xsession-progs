#!/bin/bash

mkdir -p ~/.xsession-progs.d

for dir in $HOME/.kde{,4}/Autostart; do
    old=$dir/xsession-progs
    if [ -e $old ]; then
        if rm $old; then
            echo "Removed obsolete symlink $old"
        fi
    fi
done

[ -h ~/.XSP ] || ln -s .xsession-progs.d ~/.XSP

# Deliver the static parts of the shell environment to systemd --user.
#
# systemd --user is started by systemd-logind at login, before any X server
# exists, and reaches default.target within milliseconds. 00-systemd-user-env
# cannot run until the X session starts, so anything on default.target is
# guaranteed to start without the variables it sets -- not a race, a fixed
# ordering that default.target always loses. That left power-watcher dead
# (no ~/bin in PATH, so its nm-current-connection check failed) and
# network-watcher running every hook as a silent no-op (no ZDOTDIR, so
# setup-network sourced /.shared_env and found nothing).
#
# environment.d is read by systemd's environment generator before any unit
# starts, which removes the ordering problem rather than working around it.
# Only variables with no session dependency belong here; DISPLAY and
# XAUTHLOCALHOSTNAME stay in 00-systemd-user-env, since neither has a correct
# value until X is up.
#
# Generated rather than stowed because ZDOTDIR is derived (${ZDOTDIR:-$HOME})
# and supports running from another account, which a hardcoded path would
# silently break. mr/sh.d/cfg-post guarantees ZDOTDIR is set before it runs
# these hooks.
env_d=${XDG_CONFIG_HOME:-$HOME/.config}/environment.d
mkdir -p "$env_d"
cat > "$env_d/60-shell-env.conf" <<CONF
# Generated by .cfg-post.d/xsession-progs -- do not edit by hand.
#
# Static shell environment for systemd --user services, needed before the X
# session starts. See the generating hook for why this exists.
PATH=$ZDOTDIR/bin:/usr/local/bin:/usr/X11R6/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
ZDOTDIR=$ZDOTDIR
ZDOT_FIND_HOOKS=$ZDOT_FIND_HOOKS
ZDOT_RUN_HOOKS=$ZDOT_RUN_HOOKS
CONF
