[Unit]
Description=Apply the keyboard map and reapply it when keyboards are plugged in

# setup-keyboard ends up in keymap-menu, which runs setxkbmap, so this needs a
# graphical session. It binds to fluxbox-session.target rather than
# graphical-session.target because the latter never deactivates here: it goes
# active at boot and stays active across session restarts, so PartOf= never
# propagates a stop and WantedBy= never retriggers a start. The watcher then
# survives with a stale DISPLAY and silently stops applying the keymap on
# session restart, leaving the localectl default (gb) in place -- which maps
# backslash to numbersign. fluxbox-session.target does cycle with the session.
PartOf=fluxbox-session.target
After=fluxbox-session.target

[Service]
SyslogIdentifier=keyboard-watcher
ExecStart=/bin/sh -c ${HOME}/bin/keyboard-watcher
Restart=always
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=fluxbox-session.target
