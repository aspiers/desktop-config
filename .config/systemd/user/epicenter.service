[Unit]
Description=Epicenter (Whispering) dictation app

# graphical-session.target rather than a window-manager specific target:
# Epicenter is a Tauri app with a tray icon, so it needs a graphical session
# but is not tied to fluxbox. Same reasoning as keyboard-watcher.service.
PartOf=graphical-session.target
After=graphical-session.target

# Epicenter and sussurro both grab super+8 and super+9 as global hotkeys.
# X allows only one client per grab, so whichever starts second dies with
# BadAccess on GrabKey (request code 33) -- see dc-9yi. Conflicts= makes
# starting either one stop the other, so the collision cannot happen.
Conflicts=sussurro.service

[Service]
SyslogIdentifier=epicenter

# ~/bin/whispering is generated by 'mrf whispering' from the heredoc in
# ~/.config/mr/groups.d/26-AI, so it is deliberately called rather than
# reimplemented here: it would be overwritten on the next fixups run. It
# sets PATH for the pinned node, cds to the checkout, and runs the app.
#
# The manager's environment lacks the X/DBus session, so go via
# run-with-local-X-display to source ~/.Xdisplay.$host (DISPLAY, XAUTHORITY,
# DBUS_SESSION_BUS_ADDRESS, ...).
ExecStart=%h/bin/run-with-local-X-display %h/bin/whispering

Restart=on-failure
RestartSec=5s

# 'bun run dev:epicenter' is a dev server: it forks a tree of bun and Tauri
# child processes, none of which is the main PID, so the whole control group
# has to be killed or they outlive the unit and hold the hotkey grabs.
KillMode=control-group
TimeoutStopSec=20s

StandardOutput=journal
StandardError=journal

# Deliberately no [Install] section: enabling both this and sussurro.service
# would have them race at login, with Conflicts= stopping whichever lost.
# sussurro is the one that autostarts; start this by hand when wanted, and
# Conflicts= will stop sussurro to free the hotkeys:
#
#     systemctl --user start epicenter
