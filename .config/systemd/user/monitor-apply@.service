[Unit]
Description=Keyed explicit monitor profile application (%I)
CollectMode=inactive-or-failed

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
PassEnvironment=DISPLAY XAUTHORITY
UnsetEnvironment=BASH_ENV ENV LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONINSPECT PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE
ExecStart=%h/.local/share/monitor-controller/venv/bin/python -I -m monitor_controller.cli internal apply --transaction-root %t/monitor-controller/active/transactions --action-id %I --unit %n --sysfs-root /sys/class/drm
ExecStopPost=%h/.local/share/monitor-controller/venv/bin/python -I -m monitor_controller.workers.common record-systemd-result --transaction-root %t/monitor-controller/active/transactions --action-id %I --unit %n --action-kind application --service-result ${SERVICE_RESULT} --exit-code ${EXIT_CODE} --exit-status ${EXIT_STATUS}
TimeoutStartSec=120s
TimeoutStartFailureMode=terminate
TimeoutStopSec=5s
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=no
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
UMask=0077
