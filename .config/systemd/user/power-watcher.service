[Unit]
Description=Reapply screen lock profile when switching between AC and battery

# No graphical dependency: the hook this runs calls xfconf-query, which needs
# only the session bus and works with no DISPLAY set. So this hangs off
# default.target and keeps the lock profile correct whether or not a desktop
# is running.

[Service]
SyslogIdentifier=power-watcher
ExecStart=/bin/sh -c ${HOME}/bin/power-watcher
Restart=always
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
