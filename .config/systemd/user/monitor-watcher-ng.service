[Unit]
Description=Experimental autorandr-based monitor watcher (PoC)
# Bidirectional in systemd: starting either watcher stops the other,
# so the legacy unit file needs no changes.
Conflicts=monitor-watcher.service

# Needs DISPLAY in the systemd --user environment, which only exists
# once the X session has pushed it in (see 00-systemd-user-env).
# fluxbox-session.target is raised after that, so ordering after it is
# what makes WantedBy= safe here -- default.target would be too early.
# PartOf= additionally stops this watcher when the session ends.
PartOf=fluxbox-session.target
After=fluxbox-session.target

[Service]
SyslogIdentifier=monitor-watcher-ng
ExecStart=/bin/sh -c ${HOME}/bin/monitor-watcher-ng
Restart=always
StandardOutput=journal
StandardError=journal
# Deliberately no NoNewPrivileges=true (unlike the legacy unit): the
# postswitch hook spawns the whole setup-monitor pipeline (nm-applet,
# fluxbox restarts which launch AppImages), and NoNewPrivs=1 is a
# one-way latch that breaks setuid fusermount -- see the comment in
# .xsession-progs.d/person-adam.spiers/01-window-manager.

[Install]
# Enable exactly one of monitor-watcher / monitor-watcher-ng; Conflicts=
# is a safety net rather than the selection mechanism.
WantedBy=fluxbox-session.target
