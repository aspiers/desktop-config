[Unit]
Description=Restart nm-applet once the system tray settles after a relayout
CollectMode=inactive-or-failed
PartOf=fluxbox-session.target
After=fluxbox-session.target

[Service]
SyslogIdentifier=monitor-nm-applet-retry
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
PassEnvironment=DISPLAY XAUTHORITY
UnsetEnvironment=BASH_ENV ENV LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONINSPECT PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE
ExecStart=%h/.local/share/monitor-controller/venv/bin/python -I -m monitor_controller.cli internal nm-applet-retry
TimeoutStartSec=150s
TimeoutStartFailureMode=terminate
TimeoutStopSec=5s
KillMode=control-group
Restart=no
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
UMask=0077
