# Overrides /etc/xdg/autostart/gnome-keyring-ssh.desktop to stop GNOME
# Keyring from starting a second ssh-agent through XDG autostart.
#
# XFCE has another independent route: /compat/LaunchGNOME makes
# xfce4-session run bare `gnome-keyring-daemon --start`.  GNOME Keyring 50
# interprets the missing --components argument as pkcs11,secrets,ssh, so
# Hidden=true alone did not fix the duplicate.  .cfg-post.d/desktop-config
# sets LaunchGNOME=false to block that route; this file blocks the XDG one.
#
# The remaining agent comes from openSUSE's 11-ssh-agent Xsession hook.  It
# sets both SSH_AUTH_SOCK and SSH_AGENT_PID and matches the existing ~/.ssh
# setup.  GNOME Keyring still provides secrets and PKCS#11 through their
# dedicated autostart entries.

[Desktop Entry]
Type=Application
Name=SSH Key Agent
Comment=GNOME Keyring: SSH Agent (disabled - see comment above)
Exec=/usr/bin/gnome-keyring-daemon --start --components=ssh
OnlyShowIn=GNOME;Unity;MATE;XFCE;
X-GNOME-AutoRestart=false
X-GNOME-Autostart-Notify=true
Hidden=true
