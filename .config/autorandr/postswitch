#!/bin/bash

# autorandr postswitch hook: autorandr has just applied the xrandr
# configuration for $AUTORANDR_CURRENT_PROFILE; run the rest of the
# desktop pipeline (overlay, panels, DPI, terminals, fluxbox, ...) via
# setup-monitor --skip-xrandr.  See specs/autorandr-hybrid-monitor-plan.md.

profile=$AUTORANDR_CURRENT_PROFILE
if [ -z "$profile" ]; then
    echo "postswitch: no AUTORANDR_CURRENT_PROFILE set; nothing to do" >&2
    exit 0
fi

# A keyed controller application owns its own completion and fresh-observation
# lifecycle.  It must never create the legacy pending marker, launch
# setup-monitor, or notify itself through the manual-change path.  The
# transaction-local profile normally shadows this global hook with its own
# evidence-only postswitch; this guard is the fail-safe for any hook lookup
# difference across autorandr versions.
if [ -n "${MONITOR_CONTROLLER_AUTORANDR_ACTION_ID:-}" ]; then
    echo "postswitch: controller-owned application ${MONITOR_CONTROLLER_AUTORANDR_ACTION_ID}; desktop work remains keyed" >&2
    exit 0
fi

# Merely running the non-authoritative shadow never changes manual autorandr
# behaviour.  Only an explicit active postswitch policy removes this hook's
# legacy finalization authority.  A manual load then leaves a bounded atomic
# notification for the active controller, or logs that notification was
# deferred when the controller-owned runtime directory is unavailable.
postswitch_policy=${MONITOR_CONTROLLER_POSTSWITCH_POLICY:-legacy}
if [ "$postswitch_policy" = active ]; then
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
        echo "postswitch: active policy; controller notification deferred because XDG_RUNTIME_DIR is unset" >&2
        exit 0
    fi
    notification_file=${MONITOR_CONTROLLER_POSTSWITCH_NOTIFICATION_FILE:-$XDG_RUNTIME_DIR/monitor-controller/active/autorandr-postswitch}
    case $notification_file in
        /*) ;;
        *)
            echo "postswitch: active policy; controller notification deferred because its path is not absolute" >&2
            exit 0
            ;;
    esac
    case $profile:${AUTORANDR_MONITORS:-} in
        *$'\n'*)
            echo "postswitch: active policy; controller notification deferred because its evidence is malformed" >&2
            exit 0
            ;;
    esac
    notification_dir=$(dirname "$notification_file")
    if [ ! -d "$notification_dir" ] || [ -L "$notification_dir" ]; then
        echo "postswitch: active policy; controller notification deferred because $notification_dir is unavailable" >&2
        exit 0
    fi
    notification_tmp=$notification_file.$$
    umask 077
    if ! printf 'profile=%s\nmonitors=%s\n' \
        "$profile" "${AUTORANDR_MONITORS:-}" > "$notification_tmp" ||
       ! mv -f "$notification_tmp" "$notification_file"; then
        rm -f "$notification_tmp"
        echo "postswitch: active policy; could not notify controller for profile $profile" >&2
        exit 0
    fi
    echo "postswitch: active policy; notified controller of manual profile $profile" >&2
    exit 0
fi
if [ "$postswitch_policy" != legacy ]; then
    echo "postswitch: unknown MONITOR_CONTROLLER_POSTSWITCH_POLICY=$postswitch_policy; refusing unkeyed desktop work" >&2
    exit 1
fi

# monitor-watcher-ng may need several autorandr applications before a slow
# DisplayPort link remains active.  Record each applied profile atomically but
# defer the expensive desktop pipeline until the watcher verifies convergence.
# Direct/manual autorandr invocations do not set this flag and retain the usual
# immediate postswitch behaviour.
if [ "${MONITOR_WATCHER_NG_DEFER_POSTSWITCH:-0}" = 1 ]; then
    pending_profile_file=${MONITOR_WATCHER_NG_PENDING_PROFILE_FILE:-}
    if [ -z "$pending_profile_file" ]; then
        echo "postswitch: deferral requested without a pending-profile file" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$pending_profile_file")"
    pending_tmp=$pending_profile_file.$$
    if ! printf '%s\n' "$profile" > "$pending_tmp" ||
       ! mv -f "$pending_tmp" "$pending_profile_file"; then
        rm -f "$pending_tmp"
        echo "postswitch: could not record deferred profile $profile" >&2
        exit 1
    fi
    echo "postswitch: deferred desktop reconfiguration for profile $profile" >&2
    exit 0
fi

# Profile -> fluxbox layout mapping.  autorandr needs a distinct profile
# per physical EDID set, but several monitors can share one layout
# (e.g. celtic+external), so a profile dir may contain a one-line
# `layout` file naming the layout.  Default: profile name == layout name.
layout=$profile
layout_file=~/.config/autorandr/$profile/layout
if [ -r "$layout_file" ]; then
    layout=$(cat "$layout_file")
fi

# Kill any stale in-flight setup-monitor before launching a new one:
# TERM the process group, grace period, then KILL -- mirroring the
# legacy monitor-watcher's request_stop_setup/enforce_stop_timeout.
STOP_GRACE_SECONDS=5
piddir=${XDG_RUNTIME_DIR:-/tmp}/monitor-system
mkdir -p "$piddir"
pidfile=$piddir/setup-monitor.pid

if pid=$(cat "$pidfile" 2>/dev/null) && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "postswitch: stopping stale setup-monitor (pid $pid)" >&2
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 "$STOP_GRACE_SECONDS"); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "postswitch: force-killing stale setup-monitor after ${STOP_GRACE_SECONDS}s" >&2
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
    fi
fi

# xrandr state just changed: recompute the libdpy caches and the topology
# staleness token that setup-monitor's assert_expected_state checks.  Prefer
# the shared connector/model identity, which ignores transient mode changes;
# fall back to the old inxi MD5 exactly as setup-monitor does.
"$HOME"/bin/clear-dpy-cache
~/lib/libdpy.py --inxi-json >/dev/null
expected_token=$("$HOME"/bin/monitor-identity 2>/dev/null)
if [ -z "$expected_token" ]; then
    expected_token=$(cat ~/.cache/libdpy/inxi-Gxx.monitors.json.md5 2>/dev/null)
fi

echo "postswitch: launching setup-monitor for layout $layout (token ${expected_token:-unknown})" >&2
# Async so `autorandr --change` returns quickly; the setsid child
# inherits the service's journal fds, so output stays visible under
# SyslogIdentifier=monitor-watcher-ng.
setsid "$HOME"/bin/setup-monitor --skip-xrandr \
    --layout "$layout" --expected-layout "$layout" \
    ${expected_token:+--expected-md5 "$expected_token"} &
echo $! > "$pidfile"
