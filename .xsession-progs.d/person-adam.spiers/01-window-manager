#!/bin/bash

# Serialize every Fluxbox launcher with bin/fluxbox-restart. This prevents a
# session startup and failed-restart recovery from both passing their ownership
# checks before either process has acquired the WM selection.
canonical_display=${DISPLAY:-unknown}
canonical_display=${canonical_display%.0}
display_key=$(printf '%s' "$canonical_display" | tr -c 'A-Za-z0-9_.-' '_')
fluxbox_lock="${XDG_RUNTIME_DIR:-/run/user/$UID}/fluxbox-desktop.$display_key.lock"
mkdir -p "$(dirname "$fluxbox_lock")" || exit 1
exec 8>"$fluxbox_lock" || exit 1
if ! flock -w 30 8; then
    echo >&2 "Timed out acquiring desktop Fluxbox mutation lock"
    exit 1
fi

unrecorded_fluxbox_unit=
cleanup_unrecorded_fluxbox_unit() {
    [ -n "$unrecorded_fluxbox_unit" ] || return 0
    echo >&2 "Stopping unrecorded desktop Fluxbox unit $unrecorded_fluxbox_unit"
    systemctl --user stop "$unrecorded_fluxbox_unit" ||
        echo >&2 "Failed to stop unrecorded desktop Fluxbox unit $unrecorded_fluxbox_unit"
    if systemctl --user is-active --quiet "$unrecorded_fluxbox_unit"; then
        echo >&2 "Unrecorded desktop Fluxbox unit remains active: $unrecorded_fluxbox_unit"
    fi
}

if pgrep xfwm4; then
    echo "Found xfwm4; trying to replace with fluxbox"
    if pkill xfwm4; then
        # Transient service, NOT --scope: the systemd --user manager
        # forks it (NoNewPrivs=0), so fluxbox escapes the caller's
        # NoNewPrivs=1 latch, which breaks fusermount setuid / AppImage
        # FUSE mounts.  --scope would inherit the caller's latch instead.
        # (fluxbox's own -log still writes ~/.log/fluxbox.log; stdout/
        # stderr go to the journal: journalctl --user -u fluxbox-\*.)
        # bin/fluxbox-restart launches it the same way.
        #
        # KillMode=process keeps everything fluxbox launches -- which lands
        # in this unit's cgroup -- alive when the unit is stopped. The
        # default control-group mode killed Chrome on every layout change,
        # since each one restarts the window manager.
        fluxbox_shell=$HOME/bin/fluxbox-shell
        if [ ! -x "$fluxbox_shell" ]; then
            echo >&2 "Fluxbox command shell is missing or not executable: $fluxbox_shell"
            exit 1
        fi
        if fluxbox_pids=$(pgrep -x fluxbox); then
            echo >&2 "Refusing to start a second Fluxbox process: $fluxbox_pids"
            exit 1
        elif [ "$?" -ne 1 ]; then
            echo >&2 "Could not prove that no Fluxbox process survives"
            exit 1
        fi
        fluxbox_unit="fluxbox-$(date +%s%N)$$.service"
        unrecorded_fluxbox_unit=$fluxbox_unit
        trap cleanup_unrecorded_fluxbox_unit EXIT
        trap 'exit 1' HUP INT TERM
        if systemd-run --user --unit="${fluxbox_unit%.service}" \
            -p StandardOutput=journal -p StandardError=journal \
            -p KillMode=process \
            -E "SHELL=$fluxbox_shell" \
            fluxbox -log ~/.log/fluxbox.log; then
            unit_file="${XDG_RUNTIME_DIR:-/run/user/$UID}/fluxbox-desktop-unit.$display_key"
            unit_file_tmp="$unit_file.$$"
            if printf '%s\n' "$fluxbox_unit" > "$unit_file_tmp" &&
                mv -f "$unit_file_tmp" "$unit_file"; then
                unrecorded_fluxbox_unit=
                trap - EXIT HUP INT TERM
            else
                echo >&2 "Failed to record desktop Fluxbox unit $fluxbox_unit"
                exit 1
            fi
        else
            echo >&2 "Failed to start desktop Fluxbox unit $fluxbox_unit"
            exit 1
        fi

        # Stop xfdesktop grabbing mouse clicks away from fluxbox
        ( exec 8>&-; xfdesktop -Q ) &
    else
        echo >&2 "Failed to kill xfwm4"
    fi
fi
flock -u 8

# See also 50-keyboard

here=`dirname $0`
. $here/00-systemd-user-env
session_id=$XDG_SESSION_ID

# Raise graphical-session.target, which is RefuseManualStart=yes and so
# can only be activated via a per-session target that BindsTo= it. Desktop
# environments ship their own; Fluxbox has none. Register this script's exact
# logind session only after 00-systemd-user-env has validated and published
# DISPLAY and XDG_SESSION_ID; a user-global show-user fallback could bind the
# wrong concurrent session.
#
# The supervised watcher reference-counts registered Fluxbox sessions and
# stops fluxbox-session.target after the last one closes. Its flock serializes
# teardown with concurrent registration, and routine Fluxbox WM restarts are
# deliberately outside this lifecycle.
lifetime_unit=fluxbox-session-lifetime@watch.service
if ! systemctl --user start "$lifetime_unit"; then
    echo >&2 "Failed to start $lifetime_unit"
    exit 1
fi
if ! ~/bin/fluxbox-session-lifetime register "$session_id"; then
    echo >&2 "Failed to register Fluxbox logind session $session_id"
    exit 1
fi
