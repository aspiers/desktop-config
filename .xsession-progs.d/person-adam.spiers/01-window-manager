#!/bin/bash

if pgrep xfwm4; then
    echo "Found xfwm4; trying to replace with fluxbox"
    if pkill xfwm4; then
        # Transient service, NOT --scope: the systemd --user manager
        # forks it (NoNewPrivs=0), so fluxbox escapes the caller's
        # NoNewPrivs=1 latch, which breaks fusermount setuid / AppImage
        # FUSE mounts.  --scope would inherit the caller's latch instead.
        # (fluxbox's own -log still writes ~/.log/fluxbox.log; stdout/
        # stderr go to the journal: journalctl --user -u fluxbox-\*.)
        # bin/fluxbox-restart launches it the same way.
        #
        # KillMode=process keeps everything fluxbox launches -- which lands
        # in this unit's cgroup -- alive when the unit is stopped. The
        # default control-group mode killed Chrome on every layout change,
        # since each one restarts the window manager.
        fluxbox_unit="fluxbox-$$.service"
        if systemd-run --user --unit="${fluxbox_unit%.service}" \
            -p StandardOutput=journal -p StandardError=journal \
            -p KillMode=process \
            fluxbox -log ~/.log/fluxbox.log; then
            display_key=$(printf '%s' "${DISPLAY:-unknown}" | tr -c 'A-Za-z0-9_.-' '_')
            unit_file="${XDG_RUNTIME_DIR:-/run/user/$UID}/fluxbox-desktop-unit.$display_key"
            unit_file_tmp="$unit_file.$$"
            if printf '%s\n' "$fluxbox_unit" > "$unit_file_tmp" &&
                mv -f "$unit_file_tmp" "$unit_file"; then
                :
            else
                echo >&2 "Failed to record desktop Fluxbox unit $fluxbox_unit"
                exit 1
            fi
        else
            echo >&2 "Failed to start desktop Fluxbox unit $fluxbox_unit"
            exit 1
        fi

        # Stop xfdesktop grabbing mouse clicks away from fluxbox
        xfdesktop -Q &
    else
        echo >&2 "Failed to kill xfwm4"
    fi
fi

# See also 50-keyboard

here=`dirname $0`
. $here/00-systemd-user-env

# Raise graphical-session.target, which is RefuseManualStart=yes and so
# can only be activated via a session target that BindsTo= it.  Desktop
# environments ship their own; fluxbox has none, so without this nothing
# raises it and units with PartOf=graphical-session.target never start
# (and never get stopped when the session ends).  Must follow
# 00-systemd-user-env so DISPLAY is already in the systemd --user
# environment when session units start.
#
# The monitor watchers are WantedBy= this target, so whichever one is
# enabled starts here -- no separate resume step, and no mode file:
# systemctl --user enable/disable is the switch.
systemctl --user start fluxbox-session.target
