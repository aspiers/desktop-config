#!/bin/bash
#
# bt-trace - record Bluetooth HCI commands and events to ~/.log/bt-trace/
# so slow reconnects (dc-t4i) can be timed from history rather than
# reproduced on demand.  Read the results with bt-reconnect-report.
#
# Only HCI command/event, MGMT and note blocks are kept.  ACL, SCO and ISO
# data blocks are dropped before reaching disk, because they carry HID
# reports: keystrokes from Bluetooth keyboards must never be logged.
# Pairing keys printed in command/event blocks are redacted.
#
# One file per day; files older than $keep_days are pruned, and a day's
# file stops growing at $max_bytes, so the log cannot fill the disk even
# if something starts a noisy discovery scan.

set -euo pipefail

dir=${BT_TRACE_DIR:-$HOME/.log/bt-trace}
keep_days=${BT_TRACE_KEEP_DAYS:-14}
max_bytes=${BT_TRACE_MAX_BYTES:-$((50 * 1024 * 1024))}

umask 077
mkdir -p "$dir"
chmod 700 "$dir"

hci_stream() {
    # --stdin filters already-captured btmon -T text, for testing.
    if [ "${1:-}" = --stdin ]; then
        cat
    else
        # btmon needs CAP_NET_RAW for the HCI monitor channel.  stdbuf stops
        # it block-buffering into the pipe, which would delay and, on a
        # kill, lose the last events.  Without -C it assumes 80 columns
        # when piped and truncates event names ("Connect Co..").
        sudo -n stdbuf -oL btmon -T -M -P -C 250 -c never
    fi
}

# Log the controller's USB runtime-PM transitions to usb-YYYYMMDD.log.
# btmon cannot show these, yet an advert that sits in a runtime-suspended
# controller looks exactly like a mouse that was late to advertise.  A
# separate file, because lines interleaved into the btmon stream could land
# mid-block and change which data lines the filter keeps.
watch_usb_pm() {
    local dev state last=
    while sleep 1; do
        dev=$(grep -lx 0e8d /sys/bus/usb/devices/*/idVendor 2>/dev/null | head -n1) || true
        state=$(cat "${dev%/idVendor}/power/runtime_status" 2>/dev/null) || state=absent
        [ -n "$dev" ] || state=absent
        [ "$state" = "$last" ] && continue
        printf '= bt-trace: USB controller runtime %s  %(%Y-%m-%d %H:%M:%S)T.%s\n' \
            "$state" -1 "$(date +%6N)" >> "$dir/usb-$(date +%Y%m%d).log"
        last=$state
    done
}

if [ "${1:-}" != --stdin ]; then
    watch_usb_pm &
    trap 'kill $! 2>/dev/null' EXIT
fi

hci_stream "$@" |
    gawk -v dir="$dir" -v keep_days="$keep_days" -v max_bytes="$max_bytes" '
        function open_day(   day) {
            day = strftime("%Y%m%d")
            if (day == current) return
            if (out) close(out)
            current = day
            out = dir "/" day ".log"
            # Count what earlier runs wrote today, so restarts cannot
            # each start afresh under the cap.
            written = 0
            size_cmd = "stat -c %s \"" out "\" 2>/dev/null"
            size_cmd | getline written
            close(size_cmd)
            capped = 0
            system("find \"" dir "\" -maxdepth 1 -name \"*.log\" -mtime +" keep_days " -delete")
        }

        # Block headers are unindented (MGMT ones carry a "process[pid]: "
        # prefix); continuation lines are indented and inherit the decision
        # made for their header.  Anything unrecognised is dropped.
        /^[^ \t]/ {
            keep = ($0 !~ /ACL|SCO|ISO Data/ &&
                    $0 ~ /^[<>] HCI (Command|Event)|^([^ ]+: )?@ MGMT|^= /)
        }

        keep {
            open_day()
            if (capped) next
            # -C pads headers out to the timestamp column.
            if ($0 ~ /^[^ \t]/) gsub(/ {3,}/, "  ")
            # HCI and MGMT print pairing keys in clear ("LE Start
            # Encryption" carries the long term key).  Redact any key
            # field, and any bare 128-bit value in case one is labelled
            # differently.
            else if ($0 ~ /[Kk]ey[^:]*: / || $0 ~ /[0-9a-fA-F]{32}/)
                sub(/: .*/, ": [redacted]")
            if (written + length($0) + 1 > max_bytes) {
                print "= bt-trace: daily size cap reached, dropping until midnight" >> out
                fflush(out)
                capped = 1
                next
            }
            print >> out
            fflush(out)
            written += length($0) + 1
        }
    '
