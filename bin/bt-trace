#!/bin/bash
#
# bt-trace - record Bluetooth HCI commands and events to ~/.log/bt-trace/
# so slow reconnects (dc-t4i) can be timed from history rather than
# reproduced on demand.  Read the results with bt-reconnect-report.
#
# Only HCI command/event, MGMT and note blocks are kept in full.  ACL, SCO
# and ISO data blocks are dropped before reaching disk, because they carry
# HID reports: keystrokes from Bluetooth keyboards must never be logged.
# Pairing keys printed in command/event blocks are redacted.
#
# The one exception: for $mouse_window seconds after a paired mouse
# connects, ACL blocks on that mouse's link only are kept as ATT metadata
# (opcode, attribute handle, error, value length), with every value
# stripped except notification-enable (CCC) writes.  That shows whether
# HID++ queries sent during driver probe get any reply, without recording
# what the mouse reports.
#
# btmon stops at bluetoothd, so kernel probes (watch_hid) follow an HID++
# reply on from there into the Logitech driver, logging only event types,
# sizes, device numbers and return codes.

# One file per day; files older than $keep_days are pruned, and a day's
# file stops growing at $max_bytes, so the log cannot fill the disk even
# if something starts a noisy discovery scan.

set -euo pipefail

dir=${BT_TRACE_DIR:-$HOME/.log/bt-trace}
keep_days=${BT_TRACE_KEEP_DAYS:-14}
max_bytes=${BT_TRACE_MAX_BYTES:-$((50 * 1024 * 1024))}
mouse_window=${BT_TRACE_MOUSE_WINDOW:-60}

umask 077
mkdir -p "$dir"
chmod 700 "$dir"

hci_stream() {
    # --stdin filters already-captured btmon -T text, for testing.
    if [ "${1:-}" = --stdin ]; then
        cat
    else
        # btmon needs CAP_NET_RAW for the HCI monitor channel.  stdbuf stops
        # it block-buffering into the pipe, which would delay and, on a
        # kill, lose the last events.  Without -C it assumes 80 columns
        # when piped and truncates event names ("Connect Co..").
        sudo -n stdbuf -oL btmon -T -M -P -C 250 -c never
    fi
}

# Log the controller's USB runtime-PM transitions to usb-YYYYMMDD.log.
# btmon cannot show these, yet an advert that sits in a runtime-suspended
# controller looks exactly like a mouse that was late to advertise.  A
# separate file, because lines interleaved into the btmon stream could land
# mid-block and change which data lines the filter keeps.
watch_usb_pm() {
    local dev state last=
    while sleep 1; do
        dev=$(grep -lx 0e8d /sys/bus/usb/devices/*/idVendor 2>/dev/null | head -n1) || true
        state=$(cat "${dev%/idVendor}/power/runtime_status" 2>/dev/null) || state=absent
        [ -n "$dev" ] || state=absent
        [ "$state" = "$last" ] && continue
        printf '= bt-trace: USB controller runtime %s  %(%Y-%m-%d %H:%M:%S)T.%s\n' \
            "$state" -1 "$(date +%6N)" >> "$dir/usb-$(date +%Y%m%d).log"
        last=$state
    done
}

tracefs=/sys/kernel/tracing
instance=$tracefs/instances/bt-trace

# "name definition|filter".  uhid_write is bluetoothd handing an input
# report to the kernel (type 12 = UHID_INPUT2), hid_input the HID core
# receiving it, hidpp_rx the Logitech driver; hidpp_sync is the driver's
# own request, whose return is -110 when it gave up after 5s.  Size 20 is
# an HID++ long report with its ID, so the filters keep mouse movement out.
# shellcheck disable=SC2016  # $arg2 and $retval are tracefs syntax
hid_probes=(
    'uhid_write uhid_char_write type=+u0($arg2):u32 size=+u4($arg2):u16|type != 12 || size == 20'
    'uhid_event uhid_queue_event id=uhid->hid->id event=event'
    'hid_input __hid_input_report id=hid->id size=size|size == 20'
    'hid_input_ret __hid_input_report%return ret=$retval:s32|ret != 0'
    'hidpp_rx hidpp_raw_event id=hdev->id size=size|size == 20'
    'hidpp_sync hidpp_send_message_sync id=hidpp->hid_dev->id'
    'hidpp_sync_ret hidpp_send_message_sync%return ret=$retval:s32'
)

root_write() {
    printf '%s\n' "$2" | sudo -n tee -a "$1" >/dev/null
}

hid_probe_teardown() {
    local ev
    if sudo -n test -d "$instance"; then
        root_write "$instance/tracing_on" 0
        sudo -n rmdir "$instance"
    fi
    for ev in $(sudo -n grep -o 'bttrace/[a-z_]*' "$tracefs/dynamic_events"); do
        root_write "$tracefs/dynamic_events" "-:$ev"
    done
}

hid_probe_setup() {
    local probe def name
    hid_probe_teardown
    sudo -n mkdir "$instance" || return 1
    # A private instance, so other tracing users are unaffected; boot
    # clock, so the wall-clock offset survives suspend; and a small
    # buffer, since the filters leave little to hold.
    root_write "$instance/trace_clock" boot
    root_write "$instance/buffer_size_kb" 64
    for probe in "${hid_probes[@]}"; do
        def=${probe%%|*}
        name=${def%% *}
        if ! root_write "$tracefs/dynamic_events" "f:bttrace/$name ${def#* }"; then
            echo "bt-trace: cannot probe $name; continuing without it" >&2
            continue
        fi
        [[ $probe == *'|'* ]] && root_write "$instance/events/bttrace/$name/filter" "${probe#*|}"
        root_write "$instance/events/bttrace/$name/enable" 1
    done
}

# Trace timestamps use the boot clock; a marker carrying the wall-clock
# time lets the filter convert them, and repeating it tracks NTP steps.
hid_stream() {
    while root_write "$instance/trace_marker" "bt-trace sync $EPOCHREALTIME"; do
        sleep 300
    done &
    sudo -n cat "$instance/trace_pipe"
}

watch_hid() {
    hid_probe_setup || { echo "bt-trace: kernel probes unavailable" >&2; return 0; }
    hid_stream | gawk -v dir="$dir" -v prefix=hid- -v keep_days="$keep_days" \
        -v max_bytes="$max_bytes" "$awk_log_lib"'
        match($0, /([0-9]+\.[0-9]+): ([a-z_]+): (.*)$/, m) {
            if (m[2] == "tracing_mark_write") {
                if (match(m[3], /bt-trace sync ([0-9.]+)/, s)) offset = s[1] - m[1]
                next
            }
            if (offset == "") next
            rest = m[3]
            sub(/^\([^)]*\) ?/, "", rest)
            w = m[1] + offset
            emit(sprintf("= bt-hid: %s %s  %s.%06d", m[2], rest,
                         strftime("%Y-%m-%d %H:%M:%S", int(w)), (w - int(w)) * 1000000))
        }
    '
}

# Shared by both log writers: one file per day per $prefix, pruned after
# $keep_days and capped at $max_bytes.
awk_log_lib='
    function open_day(   day, size_cmd) {
        day = strftime("%Y%m%d")
        if (day == current) return
        if (out) close(out)
        current = day
        out = dir "/" prefix day ".log"
        # Count what earlier runs wrote today, so restarts cannot
        # each start afresh under the cap.
        written = 0
        size_cmd = "stat -c %s \"" out "\" 2>/dev/null"
        size_cmd | getline written
        close(size_cmd)
        capped = 0
        system("find \"" dir "\" -maxdepth 1 -name \"*.log\" -mtime +" keep_days " -delete")
    }

    function emit(line) {
        open_day()
        if (capped) return
        if (written + length(line) + 1 > max_bytes) {
            print "= bt-trace: daily size cap reached, dropping until midnight" >> out
            fflush(out)
            capped = 1
            return
        }
        print line >> out
        fflush(out)
        written += length(line) + 1
    }
'

# Paired devices BlueZ classes as mice, read at start: a mouse paired
# later is covered from the next restart.
paired_mice() {
    local addr
    for addr in $(bluetoothctl devices Paired 2>/dev/null | awk '{print $2}'); do
        if bluetoothctl info "$addr" 2>/dev/null | grep -q 'Icon: input-mouse'; then
            printf '%s ' "$addr"
        fi
    done
}

if [ "${1:-}" = --teardown ]; then
    hid_probe_teardown
    exit
elif [ "${1:-}" = --stdin ]; then
    mice=${BT_TRACE_MICE:-}
else
    mice=$(paired_mice)
    echo "ATT metadata window for mice: ${mice:-none found}" >&2
    watch_usb_pm &
    watchers=$!
    watch_hid &
    watchers+=" $!"
    # Without a TERM trap bash skips the EXIT trap when systemd stops it,
    # leaving the probes enabled.
    trap 'exit 143' TERM INT
    trap 'kill $watchers 2>/dev/null; hid_probe_teardown' EXIT
fi

hci_stream "$@" |
    gawk -v dir="$dir" -v prefix= -v keep_days="$keep_days" -v max_bytes="$max_bytes" \
         -v mice="$mice" -v mouse_window="$mouse_window" "$awk_log_lib"'
        BEGIN {
            n = split(mice, list, " ")
            for (i = 1; i <= n; i++) is_mouse[list[i]] = 1
        }

        # Block headers are unindented (MGMT ones carry a "process[pid]: "
        # prefix); continuation lines are indented and inherit the decision
        # made for their header.  Anything unrecognised is dropped.
        /^[^ \t]/ {
            acl = 0
            ccc = 0
            conn_event = ($0 ~ /LE Meta Event/)
            disc_event = ($0 ~ /Disconnect Complete/)
            if ($0 ~ /^[<>] ACL Data/) {
                acl = match($0, /Handle ([0-9]+)/, h) &&
                      (h[1] in mouse_until) && systime() < mouse_until[h[1]]
                keep = acl
            } else {
                keep = ($0 !~ /SCO|ISO Data/ &&
                        $0 ~ /^[<>] HCI (Command|Event)|^([^ ]+: )?@ MGMT|^= /)
            }
        }

        # Open a mouse link window: Handle precedes Peer address in
        # LE (Enhanced) Connection Complete.
        conn_event && /^[ \t]+Handle: [0-9]+/ { conn_handle = $2 }
        conn_event && /^[ \t]+Peer address: / && ($3 in is_mouse) {
            mouse_until[conn_handle] = systime() + mouse_window
        }

        # Handles are reused, so close the window when the link goes.
        disc_event && /^[ \t]+Handle: [0-9]+/ { delete mouse_until[$2] }

        # Mouse ACL: keep a whitelist of metadata lines only.
        acl && /^[ \t]/ {
            if ($0 ~ /Client Characteristic Configuration/) ccc = 1
            if ($0 ~ /Data(\[[0-9]+\])?: /) {
                if (!ccc) sub(/: .*/, "")
            } else if ($0 !~ /ATT: |L2CAP: |Handle: 0x|Error: /) {
                next
            }
        }

        keep {
            # -C pads headers out to the timestamp column.
            if ($0 ~ /^[^ \t]/) gsub(/ {3,}/, "  ")
            # HCI and MGMT print pairing keys in clear ("LE Start
            # Encryption" carries the long term key).  Redact any key
            # field, and any bare 128-bit value in case one is labelled
            # differently.
            else if ($0 ~ /[Kk]ey[^:]*: / || $0 ~ /[0-9a-fA-F]{32}/)
                sub(/: .*/, ": [redacted]")
            emit($0)
        }
    '
