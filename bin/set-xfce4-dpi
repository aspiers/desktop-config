#!/bin/bash

set_dpi () {
    xfconf-query -c xsettings -p /Xft/DPI -s "$1" -t int
}

# XSettings only reaches clients that ask for it.  Xft clients that scale
# point sizes themselves read Xft.dpi from the X resource database instead,
# and kitty is one of them.  That database is merged once at session start,
# so without this a monitor change leaves it stale: a 192 left over from
# login rendered size-12 cells 19px wide instead of 14px on a 139 DPI
# ultrawide.  Keep both sources agreeing on every DPI change.
set_xft_dpi () {
    command -v xrdb >/dev/null 2>&1 || return 0
    printf 'Xft.dpi: %s\n' "$1" | xrdb -merge
}

if [ $# -ne 1 ]; then
    echo "Usage: $0 <dpi_value>" >&2
    exit 1
fi

set_dpi "$1"
set_xft_dpi "$1"