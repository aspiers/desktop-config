#!/bin/bash
#
# rofi launcher for Chrome tab switching.
# Pipes `chrome-session-tabs --rofi` lines into rofi-themed -dmenu, then
# focuses the chosen tab via `chrome-session-tabs --focus-rofi-line`.
#
# Optional argument: initial regex pre-filled in rofi. A leading `^` anchors
# the match to the start of the tab title, after rofi's window metadata.
#
# Usually spaces in the initial query are there to separate it from the extra
# conjunctive terms typed next, so rofi must keep tokenizing on whitespace.
# `--no-tokenize` is for the minority of queries whose own spaces are part of
# a single regex, which tokenizing would split into invalid fragments.

set -euo pipefail

rofi_matching_args=()
if [ "${1:-}" = --no-tokenize ]; then
    rofi_matching_args=(-no-tokenize)
    shift
fi

initial_query="${1:-}"
rofi_filter="$initial_query"

tabs=$(chrome-session-tabs --rofi)

# If the initial query already narrows to a single match, skip rofi and
# focus directly. Otherwise show rofi for interactive selection.
#
# This pre-check must match exactly what rofi itself would match, or a query
# narrowing to one tab still stops for an Enter. Rofi tokenizes the filter on
# whitespace and requires every token to match, so without `-no-tokenize` we
# must apply the tokens conjunctively rather than as one contiguous regex.
if [ -n "$initial_query" ]; then
    # Rofi prefixes each title with window metadata ending in ` -~- `.
    # Translate a title anchor to that delimiter, and keep regex spaces intact.
    if [[ $rofi_filter == ^* ]]; then
        rofi_filter=" -~- ${rofi_filter#^}"
    fi

    matches="$tabs"
    if [ ${#rofi_matching_args[@]} -gt 0 ]; then
        matches=$(printf '%s\n' "$matches" | grep -iE -- "$rofi_filter" || true)
    else
        # Tokenize as rofi does, but keep the ` -~- ` title anchor attached to
        # the first token: split apart, it would degrade to a bare `-~-` that
        # every line contains, letting later tokens match the window name or
        # URL that the anchor exists to exclude. Tokenize the original query,
        # since $rofi_filter already carries the rewritten anchor.
        first_token=1
        for token in ${initial_query#^}; do
            if [ "$first_token" = 1 ] && [[ $initial_query == ^* ]]; then
                token=" -~- $token"
            fi
            first_token=0
            matches=$(printf '%s\n' "$matches" | grep -iE -- "$token" || true)
            [ -n "$matches" ] || break
        done
    fi

    match_count=$(printf '%s\n' "$matches" | grep -c . || true)
    if [ "$match_count" = "1" ]; then
        exec chrome-session-tabs --focus-rofi-line "$matches"
    fi
fi

choice=$(
    printf '%s\n' "$tabs" |
        rofi-themed -F large -dmenu \
            -i \
            -p 'Tab' \
            -matching regex \
            "${rofi_matching_args[@]}" \
            -theme-str 'window {width: 90%;} listview {lines: 30; fixed-height: false;}' \
            -kb-secondary-copy '' \
            -kb-cancel 'Escape,Control+c,Control+g' \
            -filter "$rofi_filter"
)

[ -n "$choice" ] || exit 1

exec chrome-session-tabs --focus-rofi-line "$choice"
