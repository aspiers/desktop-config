#!/bin/zsh

INITIAL_SLEEP=0.2
MAX_SLEEP=4
FLUXBOX_DISPLAY_KEY=$(printf '%s' "${DISPLAY:-unknown}" | tr -c 'A-Za-z0-9_.-' '_')
FLUXBOX_DESKTOP_UNIT_FILE=${FLUXBOX_DESKTOP_UNIT_FILE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/fluxbox-desktop-unit.$FLUXBOX_DISPLAY_KEY}

debug () {
    echo "\e[1;33m$*\e[0m"
}

error () {
    echo "\e[1;31mERROR: $*\e[0m" >&2
}

info () {
    echo "\e[1;34m$*\e[0m"
    notify-send -a "$me" -t 8000 "$*"
}

is_running () {
    local pids

    pids=$(pgrep -x "$1") || return 1
    printf '%s\n' "$pids" | paste -sd, -
}

ensure_stopped () {
    local proc="$1"
    local timeout="${2:-20}"
    local secs=$INITIAL_SLEEP
    local waited=0
    local remaining
    while pid=$( is_running "$proc" ); do
        remaining=$(echo "$timeout - $waited" | bc -l)
        if (( $(echo "$secs > $remaining" | bc -l) )); then
            secs=$remaining
        fi
        debug "Waiting ${secs}s for $proc (pid $pid) to stop running (waited ${waited}s, timeout ${timeout}s)"
        sleep "$secs"
        waited=$(echo "$waited + $secs" | bc -l)
        if ! is_running "$proc"; then
            return 0
        fi
        if (( $(echo "$waited >= $timeout" | bc -l) )); then
            error "Timeout waiting for $proc to stop (waited $waited >= $timeout seconds)"
            return 1
        fi
        if (( $(echo "$secs < $MAX_SLEEP" | bc -l) )); then
            secs=$(echo "$secs * 2" | bc)
            debug "Doubled sleep to $secs seconds"
        fi
    done
}

desktop_fluxbox_window () {
    local wm_window

    wm_window=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null |
        awk '/window id/ { print $NF }')
    [ -n "$wm_window" ] || return 1
    xprop -id "$wm_window" _NET_WM_NAME 2>/dev/null |
        grep -q '= "Fluxbox"$' || return 1
    print -r -- "$wm_window"
}

desktop_is_fluxbox () {
    desktop_fluxbox_window >/dev/null
}

desktop_fluxbox_pid () {
    local wm_window current_pid base mask

    wm_window=$(desktop_fluxbox_window) || return 1
    while read -r current_pid base mask; do
        if (( (wm_window & ~mask) == base )); then
            print -r -- "$current_pid"
            return 0
        fi
    done < <(
        xrestop -b -m 1 2>/dev/null |
            awk '
                /\( PID:[0-9]+ \):$/ {
                    pid = $0
                    sub(/^.*\( PID:/, "", pid)
                    sub(/ \):$/, "", pid)
                    base = ""
                }
                /res_base[[:space:]]*:/ { base = $3 }
                /res_mask[[:space:]]*:/ && pid != "" && base != "" {
                    print pid, base, $3
                }
            '
    )
    return 1
}

find_desktop_fluxbox_unit () {
    local unit wm_pid unit_pid

    wm_pid=$(desktop_fluxbox_pid) || return 1
    [ -r "$FLUXBOX_DESKTOP_UNIT_FILE" ] || return 1
    unit=$(<"$FLUXBOX_DESKTOP_UNIT_FILE")
    case "$unit" in
        fluxbox-[0-9]*.service) ;;
        *)
            error "Invalid desktop Fluxbox unit record: $unit"
            return 2
            ;;
    esac
    systemctl --user is-active --quiet "$unit" || return 1
    unit_has_fluxbox_main_process "$unit" || return 1
    unit_pid=$(unit_main_pid "$unit")
    if [ "$unit_pid" != "$wm_pid" ]; then
        error "Recorded unit $unit owns PID $unit_pid, not desktop Fluxbox PID $wm_pid"
        return 2
    fi
    print -r -- "$unit"
}

record_desktop_fluxbox_unit () {
    local unit="$1"
    local tmp="${FLUXBOX_DESKTOP_UNIT_FILE}.$$"

    print -r -- "$unit" > "$tmp" || return 1
    mv -f "$tmp" "$FLUXBOX_DESKTOP_UNIT_FILE"
}

unit_main_pid () {
    systemctl --user show "$1" --property=MainPID --value 2>/dev/null
}

unit_is_running () {
    local pid

    pid=$(unit_main_pid "$1")
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 0 ] && kill -0 "$pid" 2>/dev/null
}

unit_has_fluxbox_main_process () {
    local unit="$1"
    local pid

    pid=$(unit_main_pid "$unit")
    unit_is_running "$unit" || return 1
    [ "$(<"/proc/$pid/comm")" = fluxbox ] || return 1
    grep -Fq "/$unit" "/proc/$pid/cgroup"
}

ensure_unit_stopped () {
    local unit="$1"
    local timeout="${2:-20}"
    local secs=$INITIAL_SLEEP
    local waited=0
    local pid remaining

    while unit_is_running "$unit"; do
        remaining=$(echo "$timeout - $waited" | bc -l)
        if (( $(echo "$secs > $remaining" | bc -l) )); then
            secs=$remaining
        fi
        pid=$(unit_main_pid "$unit")
        debug "Waiting ${secs}s for $unit (pid $pid) to stop running (waited ${waited}s, timeout ${timeout}s)"
        sleep "$secs"
        waited=$(echo "$waited + $secs" | bc -l)
        if ! unit_is_running "$unit"; then
            return 0
        fi
        if (( $(echo "$waited >= $timeout" | bc -l) )); then
            error "Timeout waiting for $unit to stop (waited $waited >= $timeout seconds)"
            return 1
        fi
        if (( $(echo "$secs < $MAX_SLEEP" | bc -l) )); then
            secs=$(echo "$secs * 2" | bc)
            debug "Doubled sleep to $secs seconds"
        fi
    done
}

ensure_unit_started () {
    local unit="$1"
    local timeout="${2:-20}"
    local secs=$INITIAL_SLEEP
    local waited=0
    local remaining

    while ! unit_is_running "$unit"; do
        remaining=$(echo "$timeout - $waited" | bc -l)
        if (( $(echo "$secs > $remaining" | bc -l) )); then
            secs=$remaining
        fi
        info "Waiting ${secs}s for $unit to start (waited ${waited}s, timeout ${timeout}s)"
        sleep "$secs"
        waited=$(echo "$waited + $secs" | bc -l)
        if unit_is_running "$unit"; then
            break
        fi
        if (( $(echo "$waited >= $timeout" | bc -l) )); then
            error "Timeout waiting for $unit to start (waited $waited >= $timeout seconds)"
            return 1
        fi
        if (( $(echo "$secs < $MAX_SLEEP" | bc -l) )); then
            secs=$(echo "$secs * 2" | bc)
            debug "Doubled sleep to $secs seconds"
        fi
    done
    info "$unit started (pid $(unit_main_pid "$unit"))"
}

signal_fluxbox_unit () {
    local unit="$1"
    local signal="$2"

    systemctl --user kill --kill-whom=main --signal="$signal" "$unit"
}

ensure_fluxbox_stopped () {
    local unit="$1"

    info "Attempting to stop $unit via systemd-scoped SIGTERM"
    signal_fluxbox_unit "$unit" TERM
    if ensure_unit_stopped "$unit" 3; then
        return 0
    fi

    info "Attempting to stop $unit via systemd-scoped SIGKILL"
    signal_fluxbox_unit "$unit" KILL
    if ensure_unit_stopped "$unit" 10; then
        return 0
    fi

    error "Failed to stop $unit via multiple methods"
    exit 1
}

ensure_started () {
    local proc="$1"
    local timeout="${2:-20}"
    local secs=$INITIAL_SLEEP
    local waited=0
    local remaining
    while ! pid=$( is_running "$proc" ); do
        remaining=$(echo "$timeout - $waited" | bc -l)
        if (( $(echo "$secs > $remaining" | bc -l) )); then
            secs=$remaining
        fi
        info "Waiting ${secs}s for $proc to start (waited ${waited}s, timeout ${timeout}s)"
        sleep "$secs"
        waited=$(echo "$waited + $secs" | bc -l)
        if is_running "$proc"; then
            break
        fi
        if (( $(echo "$waited >= $timeout" | bc -l) )); then
            error "Timeout waiting for $proc to start (waited $waited >= $timeout seconds)"
            exit 1
        fi
        if (( $(echo "$secs < $MAX_SLEEP" | bc -l) )); then
            secs=$(echo "$secs * 2" | bc)
            debug "Doubled sleep to $secs seconds"
        fi
    done
    info "$proc started (pid $$)"
}

retry_with_backoff () {
    local initial_sleep=0.2
    local max_wait=5
    local secs=$initial_sleep
    local waited=0
    local success=0

    while (( $(echo "$waited < $max_wait" | bc -l) )); do
        if "$@"; then
            success=1
            break
        fi
        debug "Command failed: $*, retrying in ${secs}s (waited ${waited}s)"
        sleep $secs
        waited=$(echo "$waited + $secs" | bc -l)
        secs=$(echo "$secs * 2" | bc -l)
    done

    if (( ! success )); then
        error "Command failed after ${waited}s: $*"
        return 1
    fi
    return 0
}

main () {
    local fluxbox_unit

    me=$(basename $0)

    : $0 pid is $$

    if [ -n "$SSH_CONNECTION" ]; then
        error "\$SSH_CONNECTION is set to $SSH_CONNECTION; cowardly aborting."
        exit 1
    fi

    # Needed to fix corrupted xfce4-panel which happens after display
    # reconfiguration.  Solution is to switch back to xfwm4 for a
    # second, then back to fluxbox.

    if fluxbox_unit=$(find_desktop_fluxbox_unit); then
        ensure_fluxbox_stopped "$fluxbox_unit"

        if [ -z "$no_xfwm" ]; then
            info "Replacing fluxbox with xfwm4"
            ( xfwm4 >& ~/.log/fluxbox-restart-xfwm4.log & )
            ensure_started xfwm4 10
        fi
    elif desktop_is_fluxbox; then
        error "Fluxbox owns the desktop but its exact recorded systemd unit could not be verified"
        exit 1
    fi

    if is_running xfwm4; then
        if ! retry_with_backoff set-session-restart-style xfwm4 never; then
            error "Proceeding despite set-session-restart-style failure"
        fi
        info "Stopping xfwm4"
        pkill xfwm4
        ensure_stopped xfwm4 5
    fi

    info "Starting fluxbox"
    # Transient service, NOT --scope: the systemd --user manager forks
    # it (NoNewPrivs=0), so fluxbox escapes the caller terminal's
    # NoNewPrivs=1 latch, which breaks fusermount setuid / AppImage FUSE
    # mounts.  --scope would inherit the caller's latch instead.
    # (fluxbox's own -log still writes ~/.log/fluxbox.log; stdout/stderr
    # go to the journal: journalctl --user -u fluxbox-\*.)
    #
    # KillMode=process is essential. Everything fluxbox launches -- from its
    # menu, its keybindings, or a session script -- is forked as a child and
    # so joins this unit's cgroup. Under the default KillMode=control-group,
    # stopping the unit kills that entire cgroup, so every layout change took
    # Chrome and friends down with the window manager. KillMode=process kills
    # only fluxbox itself and leaves its children running across the restart.
    fluxbox_unit="fluxbox-$$.service"
    systemd-run --user --unit="${fluxbox_unit%.service}" \
        -p StandardOutput=journal -p StandardError=journal \
        -p KillMode=process \
        fluxbox -log ~/.log/fluxbox.log
    ensure_unit_started "$fluxbox_unit" 10 || exit 1
    record_desktop_fluxbox_unit "$fluxbox_unit" || {
        error "Failed to record desktop Fluxbox unit $fluxbox_unit"
        exit 1
    }

    sleep 1
    dismiss_panel_plugin_dialogs
}

# Dismiss xfce4-panel's "plugin restarted more than once, run it again or
# leave it unloaded?" dialog, which appears after a fluxbox restart and needs
# clicking away for no useful purpose.
#
# That dialog is emitted by the crashed plugin's own wrapper process, so it
# carries the same Wrapper-2.0 class as every ordinary panel widget and cannot
# be told apart by class alone.  It differs by being a managed top-level
# dialog: it sets WM_TRANSIENT_FOR and/or _NET_WM_WINDOW_TYPE_DIALOG, and its
# WM_NAME is the dialog title rather than the bare "wrapper-2.0" that panel
# widgets report.  Any one of those three is taken as sufficient.
#
# Previously this killed every window matching Wrapper-2.0 - eleven of them on
# this desktop, the systray included.  Killing the systray forces it to
# re-register while the display geometry is still settling, which is a suspect
# for tray icons returning undersized and positioned off-screen (dc-fka).
# Scoping was lost by accident: d7d975c (2022) limited the search with
# --desktop 0, 4368a3e dropped that, and 086b877 turned --class 'Wrapper-2.0'
# into a bare --class, which in xdotool names the property to match rather
# than taking a value, so Wrapper-2.0 then matched both class and classname.
dismiss_panel_plugin_dialogs () {
    local win name type transient is_dialog

    xdotool search --onlyvisible --screen 0 --class --classname 'Wrapper-2.0' \
        2>/dev/null |
        while read -r win; do
            # xprop prints "PROP:  not found." when a property is absent, so
            # only treat a value as present when the "= " separator appears.
            # Getting this wrong killed the systray, whose window reports no
            # WM_NAME at all.
            name=$(xprop -id "$win" WM_NAME 2>/dev/null |
                sed -n 's/^WM_NAME(STRING) = //p; s/^WM_NAME(UTF8_STRING) = //p' |
                sed 's/"//g')
            type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null |
                sed -n 's/^_NET_WM_WINDOW_TYPE(ATOM) = //p')
            transient=$(xprop -id "$win" WM_TRANSIENT_FOR 2>/dev/null |
                grep -o 'window id # 0x[0-9a-f]*')

            # Require positive evidence of a dialog. A window with no WM_NAME
            # is not evidence of anything, and panel widgets are exactly that.
            is_dialog=0
            case "$type" in
                *DIALOG*) is_dialog=1 ;;
            esac
            [ -n "$transient" ] && is_dialog=1
            [ -n "$name" ] && [ "$name" != "wrapper-2.0" ] && is_dialog=1

            [ "$is_dialog" -eq 1 ] || continue

            debug "Dismissing panel plugin dialog $win ($name)"
            xdotool windowkill "$win" 2>/dev/null
        done
}

if [ -z "$FLUXBOX_RESTART_LIB_ONLY" ]; then
    main "$@"
fi
