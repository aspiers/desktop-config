#!/usr/bin/python3

import os
import sys
import subprocess
import json
import re
import argparse

# Simplified sys.path modification
sys.path.append(os.path.join(os.getenv('HOME'), 'lib'))
sys.path.append(os.path.join(os.getenv('HOME'), 'bin'))

import libdpy


debug = False
state_mode = False


def debug_print(msg):
    if debug:
        print(f"DEBUG: {msg}", file=sys.stderr)


def fatal(msg):
    if state_mode:
        print(f"error\t{msg}")
        sys.exit(0)
    sys.stderr.write(f"ERROR: {msg}\n")
    sys.exit(1)

def active_controller_layout():
    """Return the finalized layout path from the active monitor-controller.

    Returns None whenever the controller state is absent, unreadable, or not
    finalized, so every legacy environment falls through unchanged.
    """
    state_home = os.environ.get(
        "XDG_STATE_HOME", os.path.expanduser("~/.local/state")
    )
    state_path = os.path.join(
        state_home, "monitor-controller", "active", "state.json"
    )
    try:
        with open(state_path) as f:
            state = json.load(f)
        profile = state.get("desktop_finalized_profile")
        if not isinstance(profile, str) or not profile:
            return None
        profile_dir = os.path.expanduser(f"~/.config/autorandr/{profile}")
        layout = profile
        layout_path = os.path.join(profile_dir, "layout")
        if os.path.exists(layout_path):
            with open(layout_path) as f:
                layout = f.read().strip() or profile
        candidate = os.path.expanduser(f"~/.fluxbox/layouts/{layout}.yaml")
        if os.path.exists(candidate):
            return candidate
    except (OSError, ValueError):
        return None
    return None


def get_localhost_nickname():
    zdotdir = os.environ.get('ZDOTDIR', os.path.expanduser('~')) # Default to ~ if ZDOTDIR not set
    host_name_file = os.path.join(zdotdir, '.localhost-nickname')
    if not os.path.exists(host_name_file):
        sys.stderr.write(f"Put host nickname in {host_name_file}\n")
        sys.exit(1)

    with open(host_name_file, 'r') as f:
        localhost_nickname = f.read().strip()
    if localhost_nickname:
        return localhost_nickname

    sys.stderr.write(".localhost-nickname empty?!")
    sys.exit(1)


def layout_file(layout_name_suffix):
    layout = os.path.join(os.path.expanduser('~/.fluxbox/layouts'), f"{layout_name_suffix}.yaml")
    # Write cache so subsequent `get-layout` (without --no-cache) skips the
    # full xrandr/inxi probe.  clear-dpy-cache wipes this alongside the other
    # libdpy caches, so staleness is bounded by the next monitor change.
    try:
        with open(libdpy.LAYOUT_CACHE_FILE, 'w') as f:
            f.write(layout + '\n')
    except OSError:
        pass
    if state_mode:
        print(f"ready\t{layout}")
    else:
        print(layout)
    sys.exit(0)


def wait_reason(reason):
    if state_mode:
        print(f"wait\t{reason}")
        sys.exit(0)
    fatal(reason)


def ensure_primary_set_by_prop(find_by_attribute, search_value):
    if state_mode:
        return

    inxi_monitors = libdpy.get_hybrid_monitors()
    desired_monitor_info = libdpy.find_monitor_by_attribute(find_by_attribute, search_value)

    if not desired_monitor_info:
        print(f"WARNING: Monitor not found via inxi: {find_by_attribute}='{search_value}'; "
              f"cannot set primary", file=sys.stderr)
        return

    desired_output_name = (desired_monitor_info.get('mapped') or
                           desired_monitor_info.get('Monitor'))
    if not desired_output_name:
        print(f"WARNING: Monitor {desired_monitor_info.get('model', 'Unknown')} found but has "
              f"no 'mapped' or 'Monitor' in inxi data; cannot set primary", file=sys.stderr)
        return

    current_primary_info = libdpy.get_xrandr_primary_monitor()
    current_primary_name = current_primary_info.get('name') if current_primary_info else None

    if current_primary_name == desired_output_name:
        debug_print(f"{desired_output_name} is already primary (according to xrandr)")
        return

    set_primary(desired_output_name)


def set_primary(desired_output_name):
    if state_mode:
        return

    debug_print(f"Setting {desired_output_name} as primary...")
    subprocess.run(['xrandr', '--output', desired_output_name, '--primary'], check=True, capture_output=True, text=True)
    libdpy.clear_cache()
    debug_print(f"Successfully set {desired_output_name} as primary.")


def edid_unavailable_reason(monitor):
    """
    Detect a DisplayPort output whose link has trained but whose EDID is not
    yet readable, and return a human-readable reason (or None if the monitor
    looks genuine).

    A monitor in this state misreports itself as a tiny generic display: no
    model (or "Unknown"), zero physical size, and either the 640x480 VGA
    fallback mode or no mode at all ("N/A").  Committing to it picks a layout
    for a monitor that does not exist and derives DPI, panel size and font
    scaling from the bogus geometry.

    Both halves of the test matter.  A genuine small external monitor reports
    a real model string *and* real physical dimensions, so it is unaffected;
    only the EDID-less fallback has neither.  Physical size alone would be too
    eager, since some virtual//remote outputs legitimately report 0mm.
    """
    res = monitor.get("res", "")
    model = (monitor.get("model") or "").strip()
    has_model = bool(model) and model.lower() != "unknown"

    # No usable mode at all: inxi reports "N/A" between link training and
    # mode-setting.  Parsing this as WIDTHxHEIGHT would raise ValueError.
    if "x" not in res:
        return f"no mode yet (res={res or 'missing'})"

    if has_model:
        return None

    props = libdpy.get_monitor_properties(monitor)
    width_mm = props.get("width_mm", 0) if props else 0
    height_mm = props.get("height_mm", 0) if props else 0

    if width_mm == 0 and height_mm == 0:
        return f"no EDID yet (model unknown, 0mm physical size, res={res})"

    return None


def benq_bl3200_connected():
    inxi_monitors = libdpy.get_hybrid_monitors()
    monitor = libdpy.find_monitor_by_attribute('model', 'BenQ BL3200')
    if monitor:
        return monitor
    return libdpy.find_monitor_by_attribute('res', '2560x1440')


def main():
    global debug, state_mode
    parser = argparse.ArgumentParser(description="Get monitor layout.")
    parser.add_argument('--debug', action='store_true', help='Enable debug output')
    parser.add_argument('--state', action='store_true', help='Print machine-readable state instead of only the layout path')
    parser.add_argument('--no-cache', action='store_true', help='Skip the cached layout written by monitor-watcher and recompute')
    args = parser.parse_args()
    debug = args.debug
    state_mode = args.state

    # Authority path: when the active monitor-controller has finalized the
    # desktop, its persisted state names the applied profile, and the
    # profile's autorandr `layout` file maps it to the layout.  The legacy
    # libdpy cache below is only written by the old pipeline, so after a
    # controller-driven relayout it is stale (dc-d8p).
    controller_layout = active_controller_layout()
    if controller_layout is not None and not state_mode:
        debug_print(f"layout from active monitor-controller: {controller_layout}")
        print(controller_layout)
        sys.exit(0)

    # Fast path: cached layout written by a previous successful run via
    # layout_file().  Plain `get-layout` (no --state) just needs the path,
    # so short-circuit unless --no-cache is given.  --state callers need
    # full probe semantics (ready/wait/error), so they bypass the cache.
    # clear-dpy-cache wipes this file alongside other libdpy caches.
    if not args.no_cache and not state_mode and os.path.exists(libdpy.LAYOUT_CACHE_FILE):
        with open(libdpy.LAYOUT_CACHE_FILE, 'r') as f:
            cached = f.read().strip()
        if cached:
            print(cached)
            sys.exit(0)

    localhost_nickname = get_localhost_nickname()
    debug_print(f"localhost_nickname: {localhost_nickname}")

    if localhost_nickname == "celtic":
        debug_print("Finding layout for celtic")

        num_monitors = libdpy.monitors_connected()
        debug_print(f"{num_monitors} monitor(s) connected")

        if benq_bl3200_connected():
            debug_print(f"benq_bl3200_connected: True")
            # if num_monitors == 2:
            #     ensure_primary_set_by_prop("model", "BenQ")
            #     layout_file("celtic+BenQ")
            if num_monitors == 3:
                ensure_primary_set_by_prop("model", "BenQ")
                layout_file("celtic+BenQ+Dell")
            wait_reason(
                "BenQ detected on celtic but waiting for full dock topology before applying layout"
            )

        elif (external_monitor := libdpy.external_monitor_connected()):
            debug_print(
                f"external monitor connected: "
                f"{external_monitor.get('model') or 'Unknown'}"
            )

            # A DP link re-trains from scratch whenever the monitor powers back
            # on -- after DPMS blanking as much as after a real hotplug -- and
            # reports garbage until EDID arrives.  Wait it out rather than
            # committing to a layout for a monitor that isn't really there.
            if (reason := edid_unavailable_reason(external_monitor)):
                wait_reason(
                    f"external monitor present but not ready: {reason}"
                )

            monitor_res = external_monitor["res"]
            # Parse resolution (format: "WIDTHxHEIGHT")
            width, height = (int(n) for n in monitor_res.split("x"))
            aspect = width / height
            debug_print(
                f"external monitor resolution: {monitor_res}, "
                f"aspect ratio: {aspect:.2f}"
            )
            # Ultrawide aspect ratio (21:9 ≈ 2.33 or wider, e.g. Samsung
            # Odyssey G75F at 32:9; 16:9 ≈ 1.78 doesn't qualify) gets the
            # 3-column celtic+ultrawide layout.
            if aspect > 2:
                ensure_primary_set_by_prop("res", monitor_res)
                layout_file("celtic+ultrawide")
            # Other wide externals (> 2000px) are primary with the 2-col layout.
            elif width > 2000:
                ensure_primary_set_by_prop("res", monitor_res)
                layout_file("celtic+external")
            else:
                # Small external monitor - keep laptop as primary
                layout_file("celtic+external-secondary")

        elif num_monitors == 1:
            screens_data = libdpy.get_xrandr_screen_geometries()
            debug_print(f"single monitor, screens_data: {screens_data}")
            if screens_data:
                output_name = screens_data[0]['name']
                if screens_data[0].get('primary') != 'primary':
                    set_primary(output_name)
                layout_file(localhost_nickname)
            else:
                fatal("Monitor count was 1 but failed to get screen data for primary setting.")

        else:
            # Multiple monitors connected but none recognised; apply laptop-only
            # layout ignoring the unrecognised screens, but ensure laptop is primary.
            # In state mode this is a wait state since the topology is unexpected.
            if state_mode:
                wait_reason(
                    "Unrecognised monitor topology on celtic; ignoring extra screens and using laptop-only layout"
                )
            screens_data = libdpy.get_xrandr_screen_geometries()
            debug_print(f"screens_data: {screens_data}")
            if screens_data:
                edp_screen = next(
                    (s for s in screens_data if s['name'].startswith('eDP')),
                    screens_data[0]
                )
                if edp_screen.get('primary') != 'primary':
                    set_primary(edp_screen['name'])
                layout_file(localhost_nickname)
            else:
                fatal("Failed to get screen data.")

    elif localhost_nickname == "ionian":
        if libdpy.monitors_connected() == 2:
            debug_print("ionian: 2 monitors connected")
            # Assuming "BenQ" is the desired primary
            ensure_primary_set_by_prop("model", "BenQ")
            layout_file(localhost_nickname)

    elif localhost_nickname == "aegean":
        if libdpy.monitors_connected() == 1:
            debug_print("aegean: 1 monitor connected")
            layout_file(localhost_nickname)

    fatal(f"Couldn't figure out which layout to apply for {localhost_nickname}!")


if __name__ == "__main__":
    main()
