#!/bin/bash

# Terminal setup - called from setup-monitor, at login, and from set-colour-theme.
# Handles BOTH font initialization AND theme application for all terminals.
#
# Usage: setup-terminals [dark|Dark|light|Light|Bright]
#        setup-terminals --exact FONT SIZE
#
# --exact is the monitor controller's font-only entry point. The theme still
# comes from ~/.config/theme, which set-colour-theme owns: a copy held by the
# controller went stale and reverted the theme on relayout (dc-cf9h).

current_theme() {
    cat "$HOME/.config/theme" 2>/dev/null || echo "dark"
}

# set-colour-theme passes profile names (Bright/Dark), not theme names.
gnome_profile_for() {
    case "$1" in
        light|Light|Bright)
            echo "Bright"
            ;;
        *)
            echo "Dark"
            ;;
    esac
}

if [[ "${1:-}" == --exact ]]; then
    [[ "$#" -eq 3 ]] || {
        echo >&2 "Usage: $0 --exact FONT SIZE"
        exit 2
    }
    font_name=$2
    font_size=$3
    [[ "$font_size" =~ ^[1-9][0-9]*$ && -n "$font_name" ]] || {
        echo >&2 "Invalid exact terminal font"
        exit 2
    }
    [[ -n "${MONITOR_CONTROLLER_LEAF_BIN:-}" ]] || {
        echo >&2 "Missing exact leaf binding"
        exit 2
    }
    theme=$(current_theme)
    gnome_terminal_profile=$(gnome_profile_for "$theme")
    medium_font_gnome="$font_name $font_size"

    echo "Running gnome-terminal-config with exact font ..."
    "$MONITOR_CONTROLLER_LEAF_BIN/gnome-terminal-config" \
        --exact-font "$medium_font_gnome" || exit

    echo gnome-terminal-profile --exact "$gnome_terminal_profile"
    "$MONITOR_CONTROLLER_LEAF_BIN/gnome-terminal-profile" \
        --exact "$gnome_terminal_profile" || exit
    printf '%s\n' "$gnome_terminal_profile" > "$HOME/.config/gnome-terminal-profile" || exit

    echo "Running xfce4-terminal-config with exact font and $theme theme ..."
    "$MONITOR_CONTROLLER_LEAF_BIN/xfce4-terminal-config" \
        --exact-font "$medium_font_gnome" "$theme" || exit

    echo "Running kitty-theme-config with exact font and $theme theme ..."
    "$MONITOR_CONTROLLER_LEAF_BIN/kitty-theme-config" \
        --exact "$theme" "$font_size"
    exit $?
fi

[[ "$#" -le 1 ]] || {
    echo >&2 "Usage: $0 [dark|Dark|light|Light|Bright]"
    exit 2
}

# shellcheck source=/home/adam/lib/libhost.sh
. "$ZDOTDIR/lib/libhost.sh"

theme="${1:-$(current_theme)}"
gnome_terminal_profile=$(gnome_profile_for "$theme")

echo "Running gnome-terminal-config ..."
gnome-terminal-config

echo gnome-terminal-profile "$gnome_terminal_profile"
gnome-terminal-profile "$gnome_terminal_profile"
echo "$gnome_terminal_profile" > "$HOME/.config/gnome-terminal-profile"

div

echo "Running xfce4-terminal-config $theme ..."
# Apply theme (this also sets fonts via set_common)
xfce4-terminal-config "$theme"

div

echo "Running kitty-theme-config $theme ..."
kitty-theme-config "$theme"
