#!/bin/sh
. "$ZDOTDIR/lib/libfonts.sh"

#Eterm -t top
unset COLUMNS

geometry=140x60

while true; do
    case "$1" in
        --geometry)
            geometry="$2"
            shift 2
            ;;
        --title)
            title="$2"
            shift 2
            ;;
        --large)
            font_size=large
            shift
            ;;
        --xl)
            font_size=xl
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

title=${title:-"$*"}
cmd="${1:-top}"
[ -n "$1" ] && shift

case "$font_size" in
    "")
        kitty_font_size=$small_font_size
        ;;
    large)
        kitty_font_size=$large_font_size
        ;;
    xl)
        kitty_font_size=$xl_font_size
        ;;
esac

geometry_width=${geometry%%x*}
geometry_height=${geometry#*x}

# --title fixes the OS window title, giving Fluxbox a stable identifier.
kitty \
    --override "font_size=$kitty_font_size" \
    --override "initial_window_width=${geometry_width}c" \
    --override "initial_window_height=${geometry_height}c" \
    --title "$title" \
    -- \
    "$cmd" "$@"
