#!/bin/bash

# Autorandr-based monitor watcher and convergence controller.
# See specs/autorandr-hybrid-monitor-plan.md for the design.
#
# Runs under .config/systemd/user/monitor-watcher-ng.service, which
# Conflicts= with the legacy monitor-watcher.service so the two can
# never run together. Switch between the systems by enabling exactly
# one of them, e.g.
#
#   systemctl --user disable --now monitor-watcher-ng.service
#   systemctl --user enable  --now monitor-watcher.service
#
# autorandr owns profile matching and xrandr configuration. This watcher
# supplies the missing event/convergence layer: it keeps listening while
# autorandr runs, retries profiles that do not remain current, and only
# permits the expensive postswitch desktop pipeline after the display has
# been quiet for a short period.

# The Samsung/hub emitted a final link-training event 4.3s after the initial
# reconnect event, so shorter intervals can start setup-monitor prematurely.
QUIET_SECONDS=${QUIET_SECONDS:-5}
# An active xrandr mode can precede the Samsung becoming visibly usable. Keep
# verifying the selected profile after DRM quiescence before disruptive
# postswitch work (Fluxbox/panel restarts) is allowed to begin.
PROFILE_STABILITY_SECONDS=${PROFILE_STABILITY_SECONDS:-10}
PROFILE_STABILITY_POLL_SECONDS=${PROFILE_STABILITY_POLL_SECONDS:-1}
# Resuming from suspend is not an ordinary hotplug.  A DisplayPort link can
# take minutes to retrain after s2idle exit, during which the external output
# is simply absent -- indistinguishable from an unplugged monitor.  Ten
# seconds of "stability" is then met by a laptop-only topology that is not
# settled at all, and converging on it runs the full desktop pipeline, moving
# every window onto the laptop (dc-38w: resume 00:48:59, converged on celtic
# 00:49:19, external finally arrived 00:53:35).
#
# So demand far more settling evidence, but only while a resume is recent and
# only when the topology has no external output -- the case that is actually
# ambiguous.  Ordinary hotplugs, and resumes where the external came back
# promptly, keep the normal window.
POST_RESUME_STABILITY_SECONDS=${POST_RESUME_STABILITY_SECONDS:-90}
POST_RESUME_GRACE_SECONDS=${POST_RESUME_GRACE_SECONDS:-300}
RETRY_DELAY_SECONDS=${RETRY_DELAY_SECONDS:-1}
RECONCILE_TIMEOUT_SECONDS=${RECONCILE_TIMEOUT_SECONDS:-30}
MAX_RECONCILE_ATTEMPTS=${MAX_RECONCILE_ATTEMPTS:-12}
# Redshift owns the live CRTC gamma ramps, so they are not display-profile
# state and must not prevent autorandr from recognising a current profile.
AUTORANDR_SKIP_OPTIONS=${AUTORANDR_SKIP_OPTIONS:-gamma}
# Reconcile once at login / service restart. An already-current profile is
# detected as such and does not run the postswitch desktop pipeline.
INITIAL_CHANGE=${INITIAL_CHANGE:-1}

log=${MONITOR_WATCHER_NG_LOG:-$HOME/.log/udev-drm-ng.log}
runtime_dir=${MONITOR_WATCHER_NG_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/monitor-system}
drm_sysfs_dir=${MONITOR_WATCHER_NG_DRM_SYSFS_DIR:-/sys/class/drm}
pending_profile_file=${MONITOR_WATCHER_NG_PENDING_PROFILE_FILE:-$runtime_dir/autorandr-pending-profile}
output_mapping_file=${MONITOR_WATCHER_NG_OUTPUT_MAPPING_FILE:-$runtime_dir/autorandr-output-mappings}
postswitch_hook=${MONITOR_WATCHER_NG_POSTSWITCH_HOOK:-$HOME/.config/autorandr/postswitch}

DRM_EVENT_FD=
DRM_MONITOR_PID=
LAST_CONVERGED_PROFILE=
# Cumulative seconds spent suspended, as of the last reconciliation.  A jump
# means the machine resumed since then.
LAST_SUSPENDED_SECONDS=
# Seconds-since-resume, sampled once per reconciliation so every decision
# within it sees a consistent value.
SECONDS_SINCE_RESUME=

check_deps () {
    local cmd
    for cmd in autorandr udevadm xrandr; do
        if ! command -v "$cmd" >&/dev/null; then
            echo "ERROR: Couldn't find $cmd; aborting." >&2
            [ "$cmd" = autorandr ] && echo "Try: sudo zypper in autorandr" >&2
            exit 1
        fi
    done

    if [[ ! $PROFILE_STABILITY_SECONDS =~ ^(0|[1-9][0-9]*)$ ]] ||
       [[ ! $PROFILE_STABILITY_POLL_SECONDS =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: PROFILE_STABILITY_SECONDS must be a non-negative integer and PROFILE_STABILITY_POLL_SECONDS a positive integer" >&2
        exit 1
    fi

    if [[ ! $POST_RESUME_STABILITY_SECONDS =~ ^(0|[1-9][0-9]*)$ ]] ||
       [[ ! $POST_RESUME_GRACE_SECONDS =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "ERROR: POST_RESUME_STABILITY_SECONDS and POST_RESUME_GRACE_SECONDS must be non-negative integers" >&2
        exit 1
    fi
}

load_display_env () {
    local localhost_nickname=""
    local display_conf

    # shellcheck source=/home/adam/lib/libhost.sh
    . "$HOME/lib/libhost.sh"
    read_localhost_nickname
    display_conf="$HOME/.Xdisplay.$localhost_nickname"

    echo "Loading $display_conf" >&2
    # shellcheck disable=SC1090
    source "$display_conf"
}

record_monitor_line () {
    printf '%s\n' "$1" >> "$log"
}

start_udev_monitor () {
    local line

    mkdir -p "$(dirname "$log")"
    : > "$log"

    # Keep one monitor alive for the service lifetime. Its pipe buffers DRM
    # events while autorandr or postswitch is running, unlike repeatedly
    # arming inotifywait around synchronous autorandr invocations.
    exec {DRM_EVENT_FD}< <(exec udevadm monitor -u -s drm)
    DRM_MONITOR_PID=$!

    # Do not start the initial reconciliation until udevadm confirms that its
    # netlink listener is ready; otherwise an event in this tiny startup
    # window could still be lost.
    while IFS= read -r -t 5 -u "$DRM_EVENT_FD" line; do
        record_monitor_line "$line"
        if [[ $line == "UDEV - "* ]]; then
            return 0
        fi
    done

    echo "ERROR: udevadm monitor did not become ready" >&2
    return 1
}

stop_udev_monitor () {
    if [[ -n $DRM_MONITOR_PID ]]; then
        kill "$DRM_MONITOR_PID" 2>/dev/null || true
    fi
}

read_drm_event () {
    local timeout=${1:-}
    local line
    local -a read_args=(-u "$DRM_EVENT_FD")

    if [[ -n $timeout ]]; then
        read_args+=(-t "$timeout")
    fi

    while IFS= read -r "${read_args[@]}" line; do
        record_monitor_line "$line"
        if [[ $line == UDEV*"(drm)" ]]; then
            REPLY=$line
            return 0
        fi
    done

    if [[ -n $DRM_MONITOR_PID ]] && kill -0 "$DRM_MONITOR_PID" 2>/dev/null; then
        return 1                    # timeout
    fi

    echo "ERROR: udevadm monitor exited" >&2
    return 2
}

wait_for_quiescence () {
    local status

    read_drm_event "$QUIET_SECONDS"
    status=$?
    if [[ $status -eq 0 ]]; then
        echo "DRM event received before quiescence; retrying" >&2
        while true; do
            read_drm_event 0.05
            status=$?
            [[ $status -ne 0 ]] && break
            echo "Draining queued DRM event" >&2
        done
        [[ $status -eq 2 ]] && return 2
        return 1                    # topology changed
    fi

    [[ $status -eq 1 ]] && return 0 # quiet timeout elapsed
    return 2
}

autorandr_command () {
    local -a args=(--match-edid "$@")

    if [[ -n $AUTORANDR_SKIP_OPTIONS ]]; then
        args+=(--skip-options "$AUTORANDR_SKIP_OPTIONS")
    fi
    autorandr "${args[@]}"
}

record_output_mappings () {
    local diagnostics_file=$1
    local detected_profiles=$2
    local additions tmp line profile saved_output live_output _edid

    additions=$(mktemp "$runtime_dir/output-mappings-additions.XXXXXX") || return 1
    tmp=$(mktemp "$runtime_dir/output-mappings.XXXXXX") || {
        rm -f "$additions"
        return 1
    }

    # Refresh identity mappings for every detected profile first, so returning
    # a monitor to its originally saved connector supersedes an older rename.
    while IFS= read -r profile; do
        [[ -n $profile ]] || continue
        while read -r saved_output _edid; do
            [[ -n $saved_output && $saved_output != \#* ]] || continue
            printf '%s %s %s\n' "$profile" "$saved_output" "$saved_output" \
                >> "$additions"
        done < "$HOME/.config/autorandr/$profile/setup"
    done <<< "$detected_profiles"

    # Rename diagnostics follow identity entries, so the last-value-wins merge
    # below records autorandr's actual connector choice.
    while IFS= read -r line; do
        if [[ $line =~ ^([^:]+):\ renaming\ display\ ([^[:space:]]+)\ to\ ([^[:space:]]+)$ ]]; then
            profile=${BASH_REMATCH[1]}
            saved_output=${BASH_REMATCH[2]}
            live_output=${BASH_REMATCH[3]}
            printf '%s %s %s\n' "$profile" "$saved_output" "$live_output" \
                >> "$additions"
        fi
    done < "$diagnostics_file"

    if [[ -s $additions ]]; then
        {
            [[ -r $output_mapping_file ]] && cat "$output_mapping_file"
            cat "$additions"
        } | awk '
            { key=$1 SUBSEP $2; mapping[key]=$0 }
            END { for (key in mapping) print mapping[key] }
        ' > "$tmp"
        mv -f "$tmp" "$output_mapping_file"
    else
        rm -f "$tmp"
    fi
    rm -f "$additions"
}

autorandr_recording_mappings () {
    local diagnostics status

    diagnostics=$(mktemp "$runtime_dir/autorandr-command.XXXXXX") || return 1
    autorandr_command "$@" 2>"$diagnostics"
    status=$?
    cat "$diagnostics" >&2
    # A mode-set may make the EDID unavailable before the next --detected
    # query. Persist any rename learned by this application immediately so an
    # explicit retry still targets the live connector.
    record_output_mappings "$diagnostics" "" || true
    rm -f "$diagnostics"
    return "$status"
}

resolve_profile_outputs () {
    local profile=$1
    local setup_file="$HOME/.config/autorandr/$profile/setup"
    local query expected_output _expected_edid resolved
    local -A used=()

    [[ -r $setup_file ]] || return 1
    query=$(xrandr --query 2>/dev/null) || return 1

    while read -r expected_output _expected_edid; do
        [[ -n $expected_output && $expected_output != \#* ]] || continue
        resolved=

        # Consume autorandr's own --match-edid rename decision rather than
        # independently approximating its serial/EDID/wildcard semantics.
        if [[ -r $output_mapping_file ]]; then
            resolved=$(awk -v profile="$profile" -v output="$expected_output" \
                '$1 == profile && $2 == output { mapped=$3 }
                 END { print mapped }' "$output_mapping_file")
        fi

        # Profiles whose connector names did not change have no rename record.
        [[ -n $resolved ]] || resolved=$expected_output
        [[ -z ${used[$resolved]:-} ]] || return 1
        if ! awk -v wanted="$resolved" \
             '$1 == wanted && $2 == "connected" { found=1 }
              END { exit !found }' <<< "$query"; then
            return 1
        fi

        used[$resolved]=1
        printf '%s\n' "$resolved"
    done < "$setup_file"
}

profile_output_state_matches () {
    local profile=$1
    local require_active=$2
    local require_exact=$3
    local query resolved_outputs

    query=$(xrandr --query 2>/dev/null) || return 1
    resolved_outputs=$(resolve_profile_outputs "$profile") || return 1
    [[ -n $resolved_outputs ]] || return 1

    awk -v require_active="$require_active" -v require_exact="$require_exact" '
        NR == FNR { expected[$1]=1; next }
        $2 == "connected" {
            connected[$1]=1
            for (i=3; i<=NF; i++) {
                if ($i ~ /^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$/) active[$1]=1
            }
        }
        END {
            for (output in expected) {
                if (!connected[output]) exit 1
                if (require_active && !active[output]) exit 1
            }
            if (require_exact) {
                for (output in connected) {
                    if (!expected[output]) exit 1
                }
            }
        }
    ' <(printf '%s\n' "$resolved_outputs") <(printf '%s\n' "$query")
}

profile_outputs_connected () {
    profile_output_state_matches "$1" 0 0
}

profile_matches_connected_outputs () {
    profile_output_state_matches "$1" 0 1
}

profile_matches_active_outputs () {
    # Autorandr may temporarily identify the internal-only profile while an
    # external output is connected but has no usable EDID. Reject that
    # lower-topology match. Also require every profile output to have an active
    # mode; "connected" alone still includes the disabled state which caused
    # the Samsung recovery failure.
    profile_output_state_matches "$1" 1 1
}

edid_is_complete () {
    local edid=$1
    local extension_count expected_length byte sum block i

    ((${#edid} >= 256 && ${#edid} % 256 == 0)) || return 1
    [[ $edid =~ ^[[:xdigit:]]+$ ]] || return 1
    extension_count=$((16#${edid:252:2}))
    expected_length=$(((extension_count + 1) * 256))
    ((${#edid} == expected_length)) || return 1

    for ((block = 0; block <= extension_count; block++)); do
        sum=0
        for ((i = block * 256; i < (block + 1) * 256; i += 2)); do
            byte=${edid:i:2}
            sum=$((sum + 16#$byte))
        done
        ((sum % 256 == 0)) || return 1
    done
}

edid_base_is_valid () {
    local edid=$1
    local base byte sum=0 i

    ((${#edid} >= 256)) || return 1
    base=${edid:0:256}
    [[ $base =~ ^00ffffffffffff00[[:xdigit:]]{240}$ ]] || return 1
    for ((i = 0; i < 256; i += 2)); do
        byte=${base:i:2}
        sum=$((sum + 16#$byte))
    done
    ((sum % 256 == 0))
}

get_drm_edid_for_output () {
    local output=$1
    local props connector_id connector_file

    props=$(xrandr --props 2>/dev/null) || return 1
    connector_id=$(awk -v wanted="$output" '
        $1 == wanted && $2 == "connected" { in_output=1; next }
        in_output && /^[^[:space:]]/ { exit }
        in_output && $1 == "CONNECTOR_ID:" { print $2; exit }
    ' <<< "$props")
    [[ $connector_id =~ ^[0-9]+$ ]] || return 1

    for connector_file in "$drm_sysfs_dir"/card*-*/connector_id; do
        [[ -r $connector_file ]] || continue
        if [[ $(<"$connector_file") == "$connector_id" ]]; then
            od -An -v -tx1 "${connector_file%/connector_id}/edid" 2>/dev/null | tr -d ' \n'
            return ${PIPESTATUS[0]}
        fi
    done
    return 1
}

profile_live_edids_ready () {
    local profile=$1
    local fingerprints resolved_outputs output x_edid drm_edid

    fingerprints=$(autorandr --fingerprint 2>/dev/null) || return 1
    resolved_outputs=$(resolve_profile_outputs "$profile") || return 1
    [[ -n $resolved_outputs ]] || return 1
    while IFS= read -r output; do
        x_edid=$(awk -v wanted="$output" '$1 == wanted { print $2 }' <<< "$fingerprints")
        [[ -n $x_edid ]] && edid_base_is_valid "$x_edid" || return 1
        drm_edid=$(get_drm_edid_for_output "$output") || return 1
        edid_is_complete "$drm_edid" || return 1
        [[ ${x_edid:0:256} == "${drm_edid:0:256}" ]] || return 1
    done <<< "$resolved_outputs"
}

connected_external_present () {
    local status_file query

    # Kernel presence wins even while X is still catching up. Conversely, an
    # X query failure is uncertainty, never positive proof of laptop-only.
    for status_file in "$drm_sysfs_dir"/card*-*/status; do
        [[ -r $status_file ]] || continue
        [[ $status_file == *-eDP-* || $status_file == *-LVDS-* ||
            $status_file == *-DSI-* || $status_file == *-Writeback-* ]] && continue
        [[ $(<"$status_file") == connected ]] && return 0
    done

    query=$(xrandr --query 2>/dev/null) || return 0
    awk '
        $2 == "connected" && $1 !~ /^(eDP|LVDS|DSI)/ { found=1 }
        END { exit !found }
    ' <<< "$query"
}

get_exact_connected_profiles () {
    local profiles=$1
    local profile

    while IFS= read -r profile; do
        [[ -n $profile ]] || continue
        profile_matches_connected_outputs "$profile" && printf '%s\n' "$profile"
    done <<< "$profiles"
}

find_activation_probe_candidate () {
    local query fingerprints output internal_output live_edid drm_edid preferred_mode
    local external_connected_count
    local setup_file profile saved_output saved_edid resolved_saved_output candidate_profile=""
    local candidate_count=0
    local -a inactive_outputs=() internal_outputs=()

    query=$(xrandr --query 2>/dev/null) || return 1
    fingerprints=$(autorandr --fingerprint 2>/dev/null) || return 1
    while IFS= read -r output; do
        [[ -n $output ]] && inactive_outputs+=("$output")
    done < <(awk '
        $2 == "connected" {
            active=0
            for (i=3; i<=NF; i++) {
                if ($i ~ /^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$/) active=1
            }
            if (!active && $1 !~ /^(eDP|LVDS|DSI)/) print $1
        }
    ' <<< "$query")
    while IFS= read -r output; do
        [[ -n $output ]] && internal_outputs+=("$output")
    done < <(awk '
        $2 == "connected" && $1 ~ /^(eDP|LVDS|DSI)/ {
            for (i=3; i<=NF; i++) {
                if ($i ~ /^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$/) {
                    print $1
                    next
                }
            }
        }
    ' <<< "$query")

    external_connected_count=$(awk '
        $2 == "connected" && $1 !~ /^(eDP|LVDS|DSI)/ { count++ }
        END { print count + 0 }
    ' <<< "$query")
    ((external_connected_count == 1 &&
        ${#inactive_outputs[@]} == 1 && ${#internal_outputs[@]} == 1)) || return 1
    output=${inactive_outputs[0]}
    internal_output=${internal_outputs[0]}
    live_edid=$(awk -v wanted="$output" '$1 == wanted { print $2 }' <<< "$fingerprints")
    [[ -n $live_edid ]] && edid_base_is_valid "$live_edid" || return 1
    drm_edid=$(get_drm_edid_for_output "$output") || return 1
    [[ ${live_edid:0:256} == "${drm_edid:0:256}" ]] || return 1
    ! edid_is_complete "$drm_edid" || return 1
    preferred_mode=$(awk -v wanted="$output" '
        $1 == wanted && $2 == "connected" { in_output=1; next }
        in_output && $1 !~ /^[0-9]+x[0-9]+$/ { exit }
        in_output && $0 ~ /\+/ { print $1; exit }
    ' <<< "$query")
    [[ -n $preferred_mode ]] || return 1

    for setup_file in "$HOME"/.config/autorandr/*/setup; do
        [[ -r $setup_file ]] || continue
        profile=${setup_file%/setup}
        profile=${profile##*/}
        profile_matches_connected_outputs "$profile" || continue

        while read -r saved_output saved_edid; do
            [[ -n $saved_output && $saved_output != \#* ]] || continue
            resolved_saved_output=$saved_output
            if [[ -r $output_mapping_file ]]; then
                resolved_saved_output=$(awk -v profile="$profile" -v output="$saved_output" '
                    $1 == profile && $2 == output { mapped=$3 }
                    END { print mapped }
                ' "$output_mapping_file")
                [[ -n $resolved_saved_output ]] || resolved_saved_output=$saved_output
            fi
            [[ $resolved_saved_output == "$output" ]] || continue
            ((${#saved_edid} >= 256)) || continue
            if [[ ${saved_edid:0:256} == "${live_edid:0:256}" ]]; then
                candidate_profile=$profile
                candidate_count=$((candidate_count + 1))
                break
            fi
        done < "$setup_file"
    done

    ((candidate_count == 1)) || return 1
    printf '%s %s %s %s\n' "$candidate_profile" "$output" "$internal_output" "$preferred_mode"
}

run_activation_probe () {
    local profile=$1
    local output=$2
    local internal_output=$3
    local preferred_mode=$4

    echo "Activating known $profile output $output at preferred mode $preferred_mode to refresh incomplete EDID" >&2
    xrandr --output "$output" --mode "$preferred_mode" --right-of "$internal_output"
}

apply_profile () {
    local retry_profile=${1:-}

    # Invalidate get-layout and staleness-token caches before every attempt.
    # Any old setup-monitor process will then abort if it observes the new
    # topology while this controller is still converging.
    "$HOME/bin/clear-dpy-cache" </dev/null

    if [[ -n $retry_profile ]]; then
        if ! profile_matches_connected_outputs "$retry_profile"; then
            echo "Refusing stale explicit profile $retry_profile because its connected topology no longer matches" >&2
            return 1
        fi
        # Some slow monitors expose their full EDID long enough for the first
        # match, then temporarily expose a truncated EDID after the mode-set.
        # Autorandr can no longer auto-detect the profile at that point, but an
        # explicit second load wakes the same still-connected outputs (#402).
        echo "Reloading previously matched autorandr profile $retry_profile (desktop postswitch deferred)" >&2
        MONITOR_WATCHER_NG_DEFER_POSTSWITCH=1 \
            MONITOR_WATCHER_NG_PENDING_PROFILE_FILE="$pending_profile_file" \
            autorandr_recording_mappings --load "$retry_profile" </dev/null
    else
        echo "Running autorandr --change (desktop postswitch deferred)" >&2
        MONITOR_WATCHER_NG_DEFER_POSTSWITCH=1 \
            MONITOR_WATCHER_NG_PENDING_PROFILE_FILE="$pending_profile_file" \
            autorandr_recording_mappings --change </dev/null
    fi
}

get_detected_profiles () {
    local diagnostics output status

    diagnostics=$(mktemp "$runtime_dir/autorandr-detected.XXXXXX") || return 1
    output=$(autorandr_command --detected </dev/null 2>"$diagnostics")
    status=$?
    record_output_mappings "$diagnostics" "$output" || true
    rm -f "$diagnostics"
    printf '%s\n' "$output"
    return "$status"
}

get_current_profiles () {
    autorandr_command --current </dev/null 2>/dev/null
}

profile_in_list () {
    local wanted=$1
    local profiles=$2
    local profile

    while IFS= read -r profile; do
        [[ -n $profile && $profile == "$wanted" ]] && return 0
    done <<< "$profiles"
    return 1
}

first_common_profile () {
    local detected=$1
    local current=$2
    local profile

    while IFS= read -r profile; do
        if [[ -n $profile ]] && profile_in_list "$profile" "$current"; then
            printf '%s\n' "$profile"
            return 0
        fi
    done <<< "$detected"
    return 1
}

read_pending_profile () {
    local profile

    if [[ -s $pending_profile_file ]] && IFS= read -r profile < "$pending_profile_file"; then
        printf '%s\n' "$profile"
    fi
}

finalize_postswitch () {
    local profile=$1

    echo "Converged on autorandr profile $profile; running desktop postswitch" >&2
    AUTORANDR_CURRENT_PROFILE="$profile" \
        AUTORANDR_PROFILE_FOLDER="$HOME/.config/autorandr/$profile" \
        MONITOR_WATCHER_NG_DEFER_POSTSWITCH=0 \
        "$postswitch_hook" </dev/null
}

wait_before_retry () {
    local status

    read_drm_event "$RETRY_DELAY_SECONDS"
    status=$?
    if [[ $status -eq 0 ]]; then
        echo "DRM event received while waiting to retry" >&2
        return 0
    fi
    [[ $status -eq 1 ]] && return 0
    return 2
}

# Cumulative seconds this boot has spent suspended.  CLOCK_BOOTTIME counts
# suspended time and CLOCK_MONOTONIC does not, so their difference only ever
# grows, and only across a suspend.  This needs no root, no journal parsing
# and no system sleep hook, and cannot race a resume the way a timestamp file
# written by a hook would.
suspended_seconds () {
    python3 -c 'import time
print(int(time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)))' 2>/dev/null
}

# Refresh SECONDS_SINCE_RESUME.  Called once per reconciliation so that a long
# reconciliation does not see the grace period expire underneath it.
note_resume_state () {
    local now

    now=$(suspended_seconds)
    if [[ -z $now ]]; then
        # Without a usable clock, assume no recent resume rather than
        # applying the long window to every ordinary hotplug.
        SECONDS_SINCE_RESUME=""
        return 0
    fi

    if [[ -z $LAST_SUSPENDED_SECONDS ]]; then
        # First observation this run: nothing to compare against.
        LAST_SUSPENDED_SECONDS=$now
        SECONDS_SINCE_RESUME=""
        return 0
    fi

    if (( now > LAST_SUSPENDED_SECONDS )); then
        echo "Resume detected ($((now - LAST_SUSPENDED_SECONDS))s suspended); requiring longer settling for an external-free topology" >&2
        LAST_SUSPENDED_SECONDS=$now
        SECONDS_SINCE_RESUME=0
        RESUME_OBSERVED_AT=$SECONDS
        return 0
    fi

    if [[ -n ${RESUME_OBSERVED_AT:-} ]]; then
        SECONDS_SINCE_RESUME=$((SECONDS - RESUME_OBSERVED_AT))
    fi
}

# How long $profile must stay put before it is treated as settled.  A profile
# with an external output is self-evidently settled: the hardware is present.
# The ambiguous case is an external-free profile shortly after resume, which
# looks identical whether the monitor is unplugged or still retraining.
required_stability_seconds () {
    local profile=$1

    if [[ -z ${SECONDS_SINCE_RESUME:-} ]] ||
       (( SECONDS_SINCE_RESUME >= POST_RESUME_GRACE_SECONDS )); then
        printf '%s\n' "$PROFILE_STABILITY_SECONDS"
        return 0
    fi

    if profile_outputs_connected "$profile"; then
        printf '%s\n' "$PROFILE_STABILITY_SECONDS"
        return 0
    fi

    if (( POST_RESUME_STABILITY_SECONDS <= PROFILE_STABILITY_SECONDS )); then
        printf '%s\n' "$PROFILE_STABILITY_SECONDS"
        return 0
    fi

    printf '%s\n' "$POST_RESUME_STABILITY_SECONDS"
}

wait_for_profile_stability () {
    local profile=$1
    local elapsed=0
    local interval status detected current required

    required=$(required_stability_seconds "$profile")

    if (( required > 0 )); then
        echo "Verifying autorandr profile $profile remains active for ${required}s" >&2
    fi

    while (( elapsed < required )); do
        interval=$PROFILE_STABILITY_POLL_SECONDS
        if (( elapsed + interval > required )); then
            interval=$((required - elapsed))
        fi

        read_drm_event "$interval"
        status=$?
        if [[ $status -eq 0 ]]; then
            echo "DRM event received during profile stability window; retrying" >&2
            return 1
        fi
        [[ $status -eq 2 ]] && return 2

        if ! detected=$(get_detected_profiles) ||
           ! current=$(get_current_profiles) ||
           ! profile_in_list "$profile" "$current" ||
           { ! profile_in_list "$profile" "$detected" &&
             ! profile_outputs_connected "$profile"; } ||
           ! profile_matches_active_outputs "$profile"; then
            echo "Autorandr profile $profile did not remain active during stability window; retrying" >&2
            return 1
        fi

        elapsed=$((elapsed + interval))
    done

    if (( required > 0 )); then
        # Close the final query-to-postswitch gap too. An event arriving while
        # the last autorandr/xrandr queries ran can otherwise remain queued
        # while those queries still describe the old state.
        read_drm_event 0.05
        status=$?
        if [[ $status -eq 0 ]]; then
            echo "DRM event received after profile stability verification; retrying" >&2
            return 1
        fi
        [[ $status -eq 2 ]] && return 2
    fi

    return 0
}

reconcile () {
    local reason=${1:-DRM event}
    local finalize_changed_profile=${2:-1}
    local started=$SECONDS
    local attempt=0
    local apply_failed=0
    local detected current common pending_from_hook probe_candidate confirmed_probe_candidate
    local exact_profiles exact_profile_count
    local probe_profile="" probe_output="" probe_internal_output="" probe_mode=""
    local pending_profile=""
    local probe_attempted=0
    local status

    mkdir -p "$runtime_dir"
    note_resume_state
    pending_profile=$(read_pending_profile)
    if [[ -n $pending_profile ]]; then
        echo "Resuming previously matched autorandr profile $pending_profile" >&2
    fi
    echo "Starting display reconciliation ($reason)" >&2

    while (( attempt < MAX_RECONCILE_ATTEMPTS && SECONDS - started < RECONCILE_TIMEOUT_SECONDS )); do
        attempt=$((attempt + 1))
        echo "Reconciliation attempt $attempt/$MAX_RECONCILE_ATTEMPTS" >&2

        if connected_external_present; then
            if ! detected=$(get_detected_profiles); then
                echo "Could not query detected autorandr profiles before external action; retrying" >&2
                wait_before_retry || return 1
                continue
            fi
            exact_profiles=$(get_exact_connected_profiles "$detected")
            exact_profile_count=$(awk 'NF { count++ } END { print count + 0 }' <<< "$exact_profiles")

            if ((exact_profile_count == 1)) &&
               profile_live_edids_ready "$exact_profiles"; then
                if [[ -n $probe_profile && $exact_profiles != "$probe_profile" ]]; then
                    echo "Activation probe expected $probe_profile but fresh evidence selected $exact_profiles; refusing application" >&2
                    wait_before_retry || return 1
                    continue
                fi
                [[ -n $probe_profile ]] &&
                    echo "Activation probe exposed checksum-valid $exact_profiles EDID data" >&2
                pending_profile=$exact_profiles
                probe_profile=""
            elif ((exact_profile_count > 1)); then
                echo "Multiple autorandr profiles exactly match the connected external topology; refusing probe or application" >&2
                wait_before_retry || return 1
                continue
            elif ((probe_attempted == 0)) &&
                 probe_candidate=$(find_activation_probe_candidate); then
                read -r probe_profile probe_output probe_internal_output probe_mode <<< "$probe_candidate"
                read_drm_event 0.05
                status=$?
                if [[ $status -eq 0 ]]; then
                    echo "DRM event received before activation probe; re-observing" >&2
                    continue
                fi
                [[ $status -eq 2 ]] && return 1

                confirmed_probe_candidate=$(find_activation_probe_candidate) || {
                    echo "Activation-probe evidence changed during admission; re-observing" >&2
                    continue
                }
                if [[ $confirmed_probe_candidate != "$probe_candidate" ]]; then
                    echo "Activation-probe evidence changed during admission; re-observing" >&2
                    continue
                fi
                read_drm_event 0.05
                status=$?
                if [[ $status -eq 0 ]]; then
                    echo "DRM event received during activation-probe admission; re-observing" >&2
                    continue
                fi
                [[ $status -eq 2 ]] && return 1

                probe_attempted=1
                if ! run_activation_probe "$probe_profile" "$probe_output" "$probe_internal_output" "$probe_mode"; then
                    echo "Activation probe for $probe_profile failed; full profile application remains blocked" >&2
                fi
                wait_before_retry || return 1
                continue
            else
                if [[ -n $probe_profile ]]; then
                    echo "Waiting for checksum-valid $probe_profile EDID data after activation probe" >&2
                else
                    echo "External hardware is unresolved; refusing unrestricted autorandr fallback" >&2
                fi
                wait_before_retry || return 1
                continue
            fi
        else
            probe_profile=""
            if [[ -n $pending_profile ]] &&
               ! profile_matches_connected_outputs "$pending_profile"; then
                echo "Discarding stale pending profile $pending_profile after external topology disappeared" >&2
                pending_profile=""
                : > "$pending_profile_file"
            fi
        fi

        # Do not dispatch even an explicitly selected profile across a queued
        # topology event. Re-observe and re-authorize it instead.
        read_drm_event 0.05
        status=$?
        if [[ $status -eq 0 ]]; then
            echo "DRM event received before autorandr application; re-observing" >&2
            continue
        fi
        [[ $status -eq 2 ]] && return 1

        apply_failed=0
        if ! apply_profile "$pending_profile"; then
            apply_failed=1
            echo "autorandr --change failed on attempt $attempt; will verify and retry" >&2
        fi

        pending_from_hook=$(read_pending_profile)
        if [[ -n $pending_from_hook ]]; then
            if [[ -z $pending_profile || $pending_from_hook == "$pending_profile" ]]; then
                pending_profile=$pending_from_hook
            elif profile_matches_connected_outputs "$pending_from_hook" &&
                 ! profile_matches_connected_outputs "$pending_profile"; then
                # The first marker can itself be a transient lower-topology
                # profile. Let a later marker replace it only when the later
                # profile exactly describes the now-connected outputs.
                echo "Replacing deferred profile $pending_profile with topology match $pending_from_hook" >&2
                pending_profile=$pending_from_hook
            else
                # Conversely, do not let an internal-only fallback replace a
                # previously matched external profile while that external
                # output remains connected or is still link-training.
                echo "Ignoring transient deferred profile $pending_from_hook; preserving $pending_profile" >&2
                printf '%s\n' "$pending_profile" > "$pending_profile_file"
            fi
        fi

        wait_for_quiescence
        status=$?
        if [[ $status -ne 0 ]]; then
            [[ $status -eq 2 ]] && return 1
            continue
        fi

        if ! detected=$(get_detected_profiles); then
            echo "Could not query detected autorandr profiles; retrying" >&2
            wait_before_retry || return 1
            continue
        fi
        if ! current=$(get_current_profiles); then
            echo "Could not query current autorandr profiles; retrying" >&2
            wait_before_retry || return 1
            continue
        fi

        common=$(first_common_profile "$detected" "$current")
        if [[ -z $common && -n $pending_profile ]] &&
           profile_in_list "$pending_profile" "$current" &&
           profile_outputs_connected "$pending_profile"; then
            # The explicit retry can be current even while a temporarily
            # truncated EDID prevents --detected from matching it.
            common=$pending_profile
        fi
        if [[ -n $common && $apply_failed -eq 0 ]]; then
            if ! profile_matches_active_outputs "$common"; then
                echo "Autorandr profile $common does not exactly match the active outputs; retrying" >&2
                wait_before_retry || return 1
                continue
            fi

            # Close the small gap between the quiet wait and profile queries.
            read_drm_event 0.05
            status=$?
            if [[ $status -eq 0 ]]; then
                echo "DRM event received during profile verification; retrying" >&2
                continue
            fi
            [[ $status -eq 2 ]] && return 1

            wait_for_profile_stability "$common"
            status=$?
            if [[ $status -ne 0 ]]; then
                [[ $status -eq 2 ]] && return 1
                continue
            fi

            if [[ -n $pending_profile ]] && \
               profile_in_list "$pending_profile" "$current" && \
               { profile_in_list "$pending_profile" "$detected" ||
                 profile_outputs_connected "$pending_profile"; }; then
                finalize_postswitch "$pending_profile"
                LAST_CONVERGED_PROFILE=$pending_profile
            elif [[ $finalize_changed_profile == 1 &&
                    $common != "$LAST_CONVERGED_PROFILE" ]]; then
                # X may automatically disable an unplugged output before
                # autorandr runs.  In that case the new profile is already
                # current and autorandr legitimately skips its hook, but the
                # non-xrandr desktop pipeline still needs the new layout.
                finalize_postswitch "$common"
                LAST_CONVERGED_PROFILE=$common
            else
                echo "Autorandr profile $common is already current; no desktop relayout needed" >&2
                LAST_CONVERGED_PROFILE=$common
            fi
            : > "$pending_profile_file"
            return 0
        fi

        if [[ -z $detected ]]; then
            # A dock can temporarily expose an EDID/topology which matches no
            # saved profile and then emit no final DRM event. Keep polling
            # within this bounded reconciliation cycle; applying nothing is
            # still the safe behaviour for a genuinely unknown monitor.
            echo "No autorandr profile matches yet after attempt $attempt; retrying" >&2
        else
            echo "Detected profile(s) [${detected//$'\n'/, }] not current after attempt $attempt" >&2
        fi
        wait_before_retry || return 1
    done

    echo "Display did not converge within ${RECONCILE_TIMEOUT_SECONDS}s/${MAX_RECONCILE_ATTEMPTS} attempts; preserving any matched profile and waiting for the next DRM event" >&2
    return 0
}

main () {
    check_deps
    load_display_env
    start_udev_monitor || exit 1
    trap stop_udev_monitor EXIT
    trap 'exit 0' INT TERM

    if [[ $INITIAL_CHANGE == 1 ]]; then
        reconcile "service startup" 0
    fi

    while read_drm_event; do
        echo "DRM change: $REPLY" >&2
        reconcile "DRM event" 1
    done

    exit 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
