#!/bin/bash

# Harmless command-adapter tests for the active finalizer's Fluxbox health check.

set -u

repo=$(cd "$(dirname "$0")/.." && pwd)
check=$repo/bin/fluxbox-health-check
expected_state='8000x2160;DisplayPort-1=5120x2160+2880+0:primary,eDP=2880x1920+0+0:secondary'
failures=0

run_test() {
    local name=$1
    shift
    if "$@"; then
        printf 'ok - %s\n' "$name"
    else
        printf 'not ok - %s\n' "$name" >&2
        failures=$((failures + 1))
    fi
}

prepare_case() {
    local root=$1

    mkdir -p "$root/bin" "$root/runtime"
    cat > "$root/bin/xrandr" <<'EOF'
#!/bin/bash
printf '%s\n' \
    'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
    'eDP connected 2880x1920+0+0' \
    'DisplayPort-1 connected primary 5120x2160+2880+0'
EOF
    cat > "$root/bin/xprop" <<'EOF'
#!/bin/bash
[[ $* == *-remove* || $* == *-set* ]] && exit 0
[ "${STUB_ACTUAL_GEOMETRY:-}" != unavailable ] || exit 1
printf '_NET_DESKTOP_GEOMETRY(CARDINAL) = %s\n' \
    "${STUB_ACTUAL_GEOMETRY/x/, }"
EOF
    cat > "$root/bin/xev" <<'EOF'
#!/bin/bash
printf '    atom 0x200 (_MONITOR_CONTROLLER_RESTART_ARM), state PropertyNewValue\n'
if [ "${STUB_PRE_REQUEST_SUPPORT:-}" = yes ]; then
    printf '    atom 0x201 (_NET_SUPPORTING_WM_CHECK), state PropertyNewValue\n'
fi
if [ "${STUB_WATCHER_ERROR:-}" = yes ]; then
    printf 'xev diagnostic mentioning (_NET_SUPPORTING_WM_CHECK)\n' >&2
fi
while [ ! -e "${STUB_RESTART_EVENT:-/nonexistent}" ]; do
    /usr/bin/sleep 0.001
done
printf '    atom 0x202 (_FLUXBOX_ACTION), state PropertyNewValue\n'
if [ "${STUB_RESTART:-}" = confirmed ]; then
    printf '    atom 0x201 (_NET_SUPPORTING_WM_CHECK), state PropertyNewValue\n'
fi
while :; do /usr/bin/sleep 1; done
EOF
    cat > "$root/bin/fluxbox-remote" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >> "$FLUXBOX_REMOTE_LOG"
if [ "${1:-}" = Restart ]; then
    [ "${STUB_RESTART:-}" != request-failed ] || exit 1
    touch "$STUB_RESTART_EVENT"
elif [ "${1:-}" = Reconfigure ] && [ "${STUB_RESPONSE:-}" = eventual ]; then
    count=0
    [ ! -r "$FLUXBOX_REMOTE_COUNT" ] || count=$(cat "$FLUXBOX_REMOTE_COUNT")
    printf '%s\n' "$((count + 1))" > "$FLUXBOX_REMOTE_COUNT"
elif [ "${1:-}" = result ]; then
    if [ "${STUB_RESPONSE:-}" = eventual ]; then
        [ "$(cat "$FLUXBOX_REMOTE_COUNT")" -ge 2 ] && printf '0\n'
    elif [ "${STUB_RESPONSE:-}" != none ]; then
        printf '%s\n' "$STUB_RESPONSE"
    fi
fi
EOF
    cat > "$root/bin/sleep" <<'EOF'
#!/bin/bash
:
EOF
    chmod 755 "$root/bin"/*
}

run_case() (
    local actual_geometry=$1
    local response=$2
    local expected_status=$3
    local expected_reason=$4
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=$actual_geometry
    export STUB_RESPONSE=$response
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"

    output=$($check check "$expected_state")
    status=$?

    [ "$status" -eq "$expected_status" ] &&
        grep -q "$expected_reason" <<< "$output" &&
        grep -qx 'Reconfigure' "$FLUXBOX_REMOTE_LOG" &&
        grep -q '^ClientPatternTest ' "$FLUXBOX_REMOTE_LOG"
)

test_success() {
    run_case 8000x2160 0 0 "result=healthy state=$expected_state"
}

test_geometry_mismatch() {
    run_case 7999x2160 0 13 'reason=geometry_mismatch expected=8000x2160 actual=7999x2160'
}

test_unresponsive_fluxbox() {
    run_case 8000x2160 none 11 'reason=fluxbox_unresponsive'
}

test_unavailable_desktop_geometry() {
    run_case unavailable 0 12 'reason=desktop_geometry_unavailable'
}

test_xrandr_change_is_reported() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    cat > "$root/bin/xrandr" <<'EOF'
#!/bin/bash
count=0
[ ! -r "$XRANDR_COUNT" ] || count=$(cat "$XRANDR_COUNT")
count=$((count + 1))
printf '%s\n' "$count" > "$XRANDR_COUNT"
if [ "$count" -eq 1 ]; then
    printf '%s\n' \
        'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
        'eDP connected 2880x1920+0+0' \
        'DisplayPort-1 connected primary 5120x2160+2880+0'
else
    printf '%s\n' \
        'Screen 0: minimum 320 x 200, current 2880 x 1920, maximum 16384 x 16384' \
        'eDP connected primary 2880x1920+0+0'
fi
EOF
    chmod 755 "$root/bin/xrandr"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export XRANDR_COUNT="$root/xrandr-count"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"

    output=$($check check "$expected_state")
    status=$?

    [ "$status" -eq 14 ] && grep -q 'reason=xrandr_changed' <<< "$output"
)

test_equal_size_output_swap_is_rejected() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    cat > "$root/bin/xrandr" <<'EOF'
#!/bin/bash
printf '%s\n' \
    'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
    'DisplayPort-1 connected 5120x2160+0+0' \
    'eDP connected primary 2880x1920+5120+0'
EOF
    chmod 755 "$root/bin/xrandr"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"

    output=$($check check "$expected_state")
    status=$?

    [ "$status" -eq 14 ] &&
        grep -q 'reason=xrandr_changed' <<< "$output" &&
        [ ! -e "$FLUXBOX_REMOTE_LOG" ]
)

test_wait_retries_until_fluxbox_is_healthy() (
    local root output

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=eventual
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_REMOTE_COUNT="$root/fluxbox-remote.count"
    export FLUXBOX_HEALTH_WAIT_SECONDS=2

    output=$($check wait "$expected_state")

    grep -q "result=healthy state=$expected_state" <<< "$output" &&
        [ "$(cat "$FLUXBOX_REMOTE_COUNT")" -eq 2 ]
)

test_restart_requires_positive_incarnation_proof() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=unconfirmed
    export STUB_RESTART_EVENT="$root/restart-event"
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=0

    output=$($check restart "$expected_state")
    status=$?

    [ "$status" -eq 15 ] &&
        grep -q 'reason=restart_unconfirmed' <<< "$output" &&
        grep -qx 'Restart' "$FLUXBOX_REMOTE_LOG" &&
        ! grep -q '^Reconfigure$' "$FLUXBOX_REMOTE_LOG"
)

test_restart_waits_for_incarnation_then_health() (
    local root output

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=confirmed
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export STUB_RESTART_EVENT="$root/restart-event"
    export FLUXBOX_HEALTH_WAIT_SECONDS=2

    output=$($check restart "$expected_state")

    grep -q 'FLUXBOX_RESTART result=healthy mode=in-place' <<< "$output" &&
        grep -qx 'Restart' "$FLUXBOX_REMOTE_LOG" &&
        grep -qx 'Reconfigure' "$FLUXBOX_REMOTE_LOG" &&
        grep -q '^ClientPatternTest ' "$FLUXBOX_REMOTE_LOG"
)

test_restart_request_failure_is_distinct() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=request-failed
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=0

    output=$($check restart "$expected_state")
    status=$?

    [ "$status" -eq 15 ] &&
        grep -q 'reason=restart_request_failed' <<< "$output"
)

test_pre_request_support_event_is_not_credited() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=unconfirmed
    export STUB_PRE_REQUEST_SUPPORT=yes
    export STUB_RESTART_EVENT="$root/restart-event"
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=1

    output=$($check restart "$expected_state")
    status=$?

    [ "$status" -eq 15 ] &&
        grep -q 'reason=restart_unconfirmed' <<< "$output"
)

test_watcher_stderr_cannot_satisfy_restart_proof() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=confirmed
    export STUB_WATCHER_ERROR=yes
    export STUB_RESTART_EVENT="$root/restart-event"
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=2

    output=$($check restart "$expected_state")
    status=$?

    [ "$status" -eq 15 ] &&
        grep -q 'reason=restart_probe_unavailable' <<< "$output" &&
        [ -z "$(find "$root/runtime" -name 'fluxbox-restart-events.*' -print -quit)" ]
)

test_interruption_cleans_restart_watcher() (
    local root command_pid watcher_pid status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=0
    export STUB_RESTART=unconfirmed
    export STUB_RESTART_EVENT="$root/restart-event"
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=10

    $check restart "$expected_state" > "$root/restart.out" &
    command_pid=$!
    watcher_pid=
    for _attempt in {1..100}; do
        watcher_pid=$(pgrep -P "$command_pid" -x xev | head -1)
        [ -n "$watcher_pid" ] && break
        /usr/bin/sleep 0.01
    done
    [ -n "$watcher_pid" ] || return 1

    kill -TERM "$command_pid"
    wait "$command_pid"
    status=$?

    [ "$status" -ne 0 ] &&
        ! kill -0 "$watcher_pid" 2>/dev/null &&
        [ -z "$(find "$root/runtime" -name 'fluxbox-restart-events.*' -print -quit)" ]
)

test_wait_returns_final_failure_at_deadline() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export STUB_RESPONSE=none
    export FLUXBOX_REMOTE_LOG="$root/fluxbox-remote.log"
    export FLUXBOX_HEALTH_WAIT_SECONDS=0

    output=$($check wait "$expected_state")
    status=$?

    [ "$status" -eq 11 ] && grep -q 'reason=fluxbox_unresponsive' <<< "$output"
)

test_real_fluxbox_restart_preserves_pid_and_proves_incarnation() (
    local root display_number display xvfb_pid fluxbox_pid output
    local expected_xvfb_state='1280x720;screen=1280x720+0+0:secondary'

    root=$(mktemp -d)
    xvfb_pid=
    fluxbox_pid=
    cleanup() {
        [ -z "$fluxbox_pid" ] || kill "$fluxbox_pid" 2>/dev/null || true
        [ -z "$xvfb_pid" ] || kill "$xvfb_pid" 2>/dev/null || true
        [ -z "$fluxbox_pid" ] || wait "$fluxbox_pid" 2>/dev/null || true
        [ -z "$xvfb_pid" ] || wait "$xvfb_pid" 2>/dev/null || true
        rm -rf "$root"
    }
    trap cleanup EXIT

    display=
    for display_number in $(seq 90 110); do
        if [ ! -e "/tmp/.X11-unix/X$display_number" ]; then
            display=":$display_number"
            break
        fi
    done
    [ -n "$display" ] || return 1

    mkdir -p "$root/.fluxbox" "$root/.log" "$root/runtime"
    printf 'session.screen0.allowRemoteActions: true\n' > "$root/.fluxbox/init"
    Xvfb "$display" -screen 0 1280x720x24 -nolisten tcp \
        > "$root/xvfb.log" 2>&1 &
    xvfb_pid=$!
    for _attempt in {1..100}; do
        DISPLAY=$display xdpyinfo >/dev/null 2>&1 && break
        /usr/bin/sleep 0.01
    done
    DISPLAY=$display xdpyinfo >/dev/null 2>&1 || return 1

    HOME=$root XDG_RUNTIME_DIR=$root/runtime DISPLAY=$display \
        fluxbox -log "$root/.log/fluxbox.log" \
        > "$root/fluxbox.stdout" 2> "$root/fluxbox.stderr" &
    fluxbox_pid=$!
    for _attempt in {1..100}; do
        DISPLAY=$display xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null |
            grep -q 'window id' && break
        /usr/bin/sleep 0.01
    done

    output=$(HOME=$root XDG_RUNTIME_DIR=$root/runtime DISPLAY=$display \
        FLUXBOX_HEALTH_WAIT_SECONDS=5 \
        "$check" restart "$expected_xvfb_state") || return 1
    kill -0 "$fluxbox_pid" 2>/dev/null &&
        [ "$(cat "/proc/$fluxbox_pid/comm")" = fluxbox ] &&
        grep -q 'FLUXBOX_RESTART result=healthy mode=in-place' <<< "$output"
)

test_restart_uses_canonical_mutation_lock() (
    local root output status

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    mkdir -p "$root/runtime"
    exec 8>"$root/runtime/fluxbox-desktop._77.lock"
    flock -n 8
    set +e
    output=$(XDG_RUNTIME_DIR="$root/runtime" DISPLAY=:77.0 \
        FLUXBOX_DESKTOP_LOCK_WAIT_SECONDS=0 \
        "$check" restart "$expected_state")
    status=$?
    set -e

    [ "$status" -eq 11 ] &&
        grep -q 'reason=mutation_lock_timeout' <<< "$output"
)

test_probe_lock_serializes_command_exchange() (
    local root first second

    root=$(mktemp -d)
    trap 'rm -rf "$root"' EXIT
    prepare_case "$root"
    cat > "$root/bin/fluxbox-remote" <<'EOF'
#!/bin/bash
if [ "${1:-}" = Reconfigure ]; then
    if ! mkdir "$EXCHANGE_GUARD" 2>/dev/null; then
        touch "$EXCHANGE_OVERLAP"
    fi
    /usr/bin/sleep 0.2
    rmdir "$EXCHANGE_GUARD" 2>/dev/null || true
elif [ "${1:-}" = result ]; then
    printf '0\n'
fi
EOF
    chmod 755 "$root/bin/fluxbox-remote"
    export PATH="$root/bin:/usr/bin:/bin"
    export XDG_RUNTIME_DIR="$root/runtime"
    export STUB_ACTUAL_GEOMETRY=8000x2160
    export FLUXBOX_REMOTE_LOG="$root/unused.log"
    export EXCHANGE_GUARD="$root/exchange-active"
    export EXCHANGE_OVERLAP="$root/exchange-overlap"

    $check check "$expected_state" > "$root/first.out" &
    first=$!
    $check check "$expected_state" > "$root/second.out" &
    second=$!
    wait "$first" "$second"

    [ ! -e "$EXCHANGE_OVERLAP" ] &&
        grep -q 'result=healthy' "$root/first.out" &&
        grep -q 'result=healthy' "$root/second.out"
)

run_test 'healthy geometry and command channel pass' test_success
run_test 'desktop geometry mismatch fails' test_geometry_mismatch
run_test 'unresponsive Fluxbox fails' test_unresponsive_fluxbox
run_test 'missing desktop geometry fails' test_unavailable_desktop_geometry
run_test 'RandR change during probe fails stale' test_xrandr_change_is_reported
run_test 'equal-size output swap fails staged layout' test_equal_size_output_swap_is_rejected
run_test 'wait retries until Fluxbox is healthy' test_wait_retries_until_fluxbox_is_healthy
run_test 'restart rejects old-process health without incarnation proof' test_restart_requires_positive_incarnation_proof
run_test 'restart proves a new incarnation before health' test_restart_waits_for_incarnation_then_health
run_test 'restart request failure is distinct' test_restart_request_failure_is_distinct
run_test 'pre-request supporting event is not credited' test_pre_request_support_event_is_not_credited
run_test 'watcher stderr cannot satisfy restart proof' test_watcher_stderr_cannot_satisfy_restart_proof
run_test 'interruption cleans restart watcher' test_interruption_cleans_restart_watcher
run_test 'wait returns failure at its deadline' test_wait_returns_final_failure_at_deadline
run_test 'real Fluxbox restart preserves PID and proves incarnation' test_real_fluxbox_restart_preserves_pid_and_proves_incarnation
run_test 'display aliases share the Fluxbox mutation lock' test_restart_uses_canonical_mutation_lock
run_test 'probe lock serializes command exchange' test_probe_lock_serializes_command_exchange

if [ "$failures" -ne 0 ]; then
    printf '%d test(s) failed\n' "$failures" >&2
    exit 1
fi
printf 'all tests passed\n'
