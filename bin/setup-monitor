#!/bin/bash

#exec >& ~/.log/setup-monitor.log

STALE_EXIT_CODE=75

layout=""
expected_layout=""
expected_md5=""
skip_xrandr=0
terminated=0
localhost_nickname=""
screen_0_name=""
screen_1_name=""
screen_2_name=""
timing_started_us=0

start_timing() {
    timing_started_us=${EPOCHREALTIME/./}
    echo "TIMING setup-monitor +0.000s: started"
}

timing_mark() {
    local now_us=${EPOCHREALTIME/./}
    local elapsed_us=$((10#$now_us - 10#$timing_started_us))

    printf 'TIMING setup-monitor +%d.%03ds: %s\n' \
        $((elapsed_us / 1000000)) $(((elapsed_us / 1000) % 1000)) "$*"
}

# shellcheck source=/home/adam/lib/libhost.sh
. ~/lib/libhost.sh
read_localhost_nickname

usage() {
    cat <<EOF
Usage: setup-monitor [--layout LAYOUT] [--expected-layout LAYOUT] [--expected-md5 MD5] [--skip-xrandr]

--skip-xrandr skips the xrandr invocation, for when something else
(e.g. autorandr; see specs/autorandr-hybrid-monitor-plan.md) has
already applied it.
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --layout)
                layout="$2"
                shift 2
                ;;
            --expected-layout)
                expected_layout="$2"
                shift 2
                ;;
            --expected-md5)
                expected_md5="$2"
                shift 2
                ;;
            --skip-xrandr)
                skip_xrandr=1
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                echo "ERROR: Unknown argument: $1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

monitor_md5_file=~/.cache/libdpy/inxi-Gxx.monitors.json.md5

# Which monitors are attached, ignoring the mode they are currently in.  The
# inxi MD5 covers "res", so it churns while a DisplayPort monitor negotiates
# its final mode and would abort this run as stale for a topology that has not
# actually changed.  monitor-watcher fingerprints the same way, so the value it
# passes as --expected-md5 is comparable with this one.
current_monitor_md5() {
    local identity

    ~/lib/libdpy.py --inxi-json >/dev/null

    if identity=$( ~/bin/monitor-identity 2>/dev/null ) && [ -n "$identity" ]; then
        echo "$identity"
        return 0
    fi

    if [ -f "$monitor_md5_file" ]; then
        cat "$monitor_md5_file"
    fi
}

current_layout_name() {
    local current_layout_file

    if ! current_layout_file=$(get-layout); then
        return 1
    fi

    basename -s .yaml "$current_layout_file"
}

stale_exit() {
    echo "STALE: $1" >&2
    exit "$STALE_EXIT_CODE"
}

assert_expected_state() {
    local current_md5
    local current_layout

    if [ "$terminated" -ne 0 ]; then
        stale_exit "termination requested"
    fi

    if [ -n "$expected_md5" ]; then
        current_md5=$(current_monitor_md5)
        if [ -z "$current_md5" ]; then
            stale_exit "failed to determine current monitor md5"
        fi
        if [ "$current_md5" != "$expected_md5" ]; then
            stale_exit "monitor md5 changed from $expected_md5 to $current_md5"
        fi
    fi

    if [ -n "$expected_layout" ]; then
        current_layout=$(current_layout_name) || stale_exit "failed to determine current layout"
        if [ "$current_layout" != "$expected_layout" ]; then
            stale_exit "layout changed from $expected_layout to $current_layout"
        fi
    fi
}

handle_term() {
    terminated=1
}

trap handle_term TERM

get_layout() {
    if [ -n "$layout" ]; then
        echo "$layout"
        return 0
    fi

    echo -n "Getting layout ... "
    if ! layout=$( get-layout ); then
        exit 1
    fi

    layout=$(basename -s .yaml "$layout")
    echo "$layout"
}

load_display_data() {
    eval "$(~/lib/libdpy.py)"
}

validate_layout() {
    if ! ~/lib/liblayout.py --check-screen-counts "$layout" >/dev/null; then
        echo "ERROR: Layout '$layout' validation failed" >&2
        echo "This usually means 'xrandr --auto' hasn't been run to activate all connected monitors" >&2
        echo "Run 'xrandr --auto' and clear the libdpy cache, or check monitor-watcher logs" >&2
        exit 1
    fi
}

# Check whether OUTPUT advertises MODE at roughly RATE Hz, so we only
# request an explicit mode/rate combo which actually exists (e.g. the
# ultrawide via a dock may not offer 5120x2160@60).
output_has_mode_rate() {
    local output="$1" mode="$2" rate="$3"

    xrandr --query | awk -v output="$output" -v mode="$mode" -v rate="$rate" '
        /^[^ ]/ { in_output = ($1 == output) }
        in_output && $1 == mode {
            # Rate fields may carry current/preferred markers, e.g.
            # "60.00*+"; awk numeric coercion strips them.
            for (i = 2; i <= NF; i++)
                if ($i + 0 >= rate - 0.5 && $i + 0 < rate + 0.5) {
                    found = 1
                    exit
                }
        }
        END { exit !found }
    '
}

setup_xrandr() {
    celtic_width=2880
    celtic_height=1920
    celtic_size="${celtic_width}x${celtic_height}"
    BenQ_width=2560

    case "$layout" in
        celtic)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --primary --auto
            ;;
        celtic+external)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto
            ;;
        celtic+ultrawide)
            local ultrawide_mode_args=()
            if output_has_mode_rate "${screen_1_name}" 5120x2160 60; then
                ultrawide_mode_args=(--rate 60 --mode 5120x2160)
            else
                echo "WARNING: ${screen_1_name} doesn't offer 5120x2160@60; using preferred mode" >&2
            fi
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto "${ultrawide_mode_args[@]}"
            ;;
        celtic+external-secondary)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --primary --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --auto
            ;;
        celtic+BenQ)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto
            ;;
        celtic+BenQ+Dell)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto \
                --output "${screen_2_name}" --pos "$(( celtic_width + BenQ_width ))x0" --scale 1 --auto
            # Alternate setup where laptop screen is off
            # xrandr \
            #     --output ${screen_0_name} --pos 0x0 --scale 1 --off \
            #     --output ${screen_1_name} --pos 0x0 --scale 1 --primary --auto \
            #     --output ${screen_2_name} --pos ${BenQ_width}x0 --scale 1 --auto
            ;;
        ionian)
            xrandr \
                --output DP-0 --pos 0x0 --scale 1 --primary --auto \
                --output DP-2.8 --pos 2560x0 --scale 1 --auto
            ;;
        *)
            echo "setup-monitor: don't know how to handle layout $layout"
            exit 1
            ;;
    esac

    # xrandr state changed; invalidate stale cache so subsequent
    # commands (e.g. setup-panels) see the correct primary.
    clear-dpy-cache
}

refresh_display_cache() {
    # Keep the raw inxi cache warm for legacy fallback/identity diagnostics,
    # but never present its stale connector names or res=N/A values as the
    # authoritative live topology. The hybrid path resolves hwinfo identities
    # onto current XRandR outputs and geometries.
    ~/lib/libdpy.py --inxi-json >/dev/null
    PYTHONPATH="$HOME/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -c \
        'import json, libdpy; print(json.dumps(libdpy.get_hybrid_monitors(use_cache=False), indent=2))'
    eval "$(~/lib/libdpy.py)"
}

setup_overlay() {
    local layout="$1"

    # Highest priority: layout-specific overlay
    if [ -e ~/.fluxbox/overlay."$layout" ]; then
        ln -sf "overlay.$layout" ~/.fluxbox/overlay
        return
    fi

    # Second priority: the host overlay, but ONLY for the bare host layout.
    #
    # The host overlay is sized for this host's internal panel alone.  On a
    # host whose nickname is also a layout name (celtic), an unqualified
    # match here silently captures every multi-monitor layout that lacks its
    # own overlay file, applying laptop HiDPI font sizes to an external
    # monitor.  Requiring an exact layout match sends those layouts on to the
    # DPI-aware generator below instead.
    if [ "$layout" = "$localhost_nickname" ] &&
           [ -e ~/.fluxbox/overlay."$localhost_nickname" ]; then
        ln -sf "overlay.$localhost_nickname" ~/.fluxbox/overlay
        return
    fi

    # Fallback: generate dynamically based on DPI
    echo "Generating dynamic overlay"
    local scale_factor
    # Matches the hand-written external-monitor overlays, which all settled on
    # sans-12:bold (celtic+BenQ, celtic+BenQ+Dell, celtic+external).  Fluxbox
    # sizes these in points and Xft.dpi now carries the monitor's real DPI, so
    # a fixed base stays the same physical size as monitors change.
    local base_font=12
    local title_font
    local menu_font

    scale_factor=$(~/lib/libdpy.py --calculate-ui-scale)
    title_font=$(printf "%.0f" "$(echo "$base_font * $scale_factor" | bc)")
    menu_font=$(printf "%.0f" "$(echo "($base_font + 1) * $scale_factor" | bc)")

    # A previous relayout may have left ~/.fluxbox/overlay as a symlink to a
    # checked-in overlay.<layout> file.  Writing without removing it first
    # follows the link and overwrites that source file with generated content.
    rm -f ~/.fluxbox/overlay

    cat > ~/.fluxbox/overlay <<EOF
window.borderWidth:               1
window.handleWidth:               8
window.font:                      sans-${title_font}:bold
window.title.height:              $(( 32 + (title_font - 12) * 2 ))
menu.title.font:                  sans-${title_font}:bold
menu.frame.font:                  sans-${menu_font}
menu.titleHeight:                 $(( 26 + (title_font - 12) * 2 ))
menu.itemHeight:                  10
EOF
}

setup_keyboard () {
    if host-has-prop laptop; then
        if BenQ-connected; then
            # Connect to Kinesis Advantage 360 over Bluetooth
            adv &
        else
            adv off &
        fi
    fi
}

main () {
    parse_args "$@"
    start_timing

    get_layout
    assert_expected_state

    load_display_data
    validate_layout
    if [ "$skip_xrandr" -eq 1 ]; then
        echo "Skipping xrandr setup (already applied, e.g. by autorandr)"
    else
        setup_xrandr
    fi
    assert_expected_state

    refresh_display_cache
    assert_expected_state
    timing_mark "display state validated and caches refreshed"

    setup_overlay "$layout"
    setup-panels
    setup_keyboard
    set-layout-dpi "$layout"

    # Reloading Emacs fonts after a DPI change is cold-cache work (~1.85s on
    # celtic), but it is independent of terminal configuration and Fluxbox
    # config generation.  Overlap those synchronous operations, then join
    # before moving windows so Emacs has its final geometry.
    echo "Loading as-fonts via emacsclient ..."
    emacsclient -e '(load "as-fonts")' &
    fonts_pid=$!

    setup-terminals
    fluxbox-reconfigure  # update ~/.fluxbox/keys
    if ! wait "$fonts_pid"; then
        echo "WARNING: failed to reload as-fonts via emacsclient" >&2
    fi
    assert_expected_state
    timing_mark "desktop properties, terminal config, Fluxbox config, and fonts ready"

    # The historical sleeps around Fluxbox reconfiguration and font loading
    # are no longer synchronization: every preceding operation is synchronous
    # (including the explicit wait above), and live state assertions guard the
    # transition.  Proceed immediately to the visible window layout.
    echo "Fluxbox layout ..."
    run-with-local-X-display ly
    assert_expected_state
    timing_mark "window layout applied"

    echo "Fluxbox restart ..."
    fr
    timing_mark "Fluxbox restarted"

    echo "Restarting xfce4-panel ..."
    if command -v xfce4-panel-debug-ensure >/dev/null 2>&1; then
        xfce4-panel-debug-ensure >/dev/null 2>&1 || true
    fi
    if command -v panel-debug-status >/dev/null 2>&1; then
        panel-debug-status --mark-boundary "setup-monitor ${layout:-unknown}" \
            >/dev/null 2>&1 || true
    fi
    xfce4-panel -r
    assert_expected_state

    wait_for_stable_tray
    systemctl --user restart nm-applet.service
    timing_mark "panel and system tray settled; nm-applet service restarted"

    capture_tray_diag
    capture_shadow_trace
}

# Report the window owning the system tray selection, or nothing when there is
# no owner.
#
# The tray is an X SELECTION, not a root window property, so
# 'xprop -root _NET_SYSTEM_TRAY_S0' always reports "not found" no matter what
# and must never be used for this.
tray_selection_owner() {
    python3 - <<'EOF' 2>/dev/null
from ctypes import CDLL, c_void_p, c_char_p, c_int, c_ulong
import os

x = CDLL('libX11.so.6')
x.XOpenDisplay.argtypes = [c_char_p]
x.XOpenDisplay.restype = c_void_p
x.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
x.XInternAtom.restype = c_ulong
x.XGetSelectionOwner.argtypes = [c_void_p, c_ulong]
x.XGetSelectionOwner.restype = c_ulong

display = x.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
if not display:
    raise SystemExit(1)
atom = x.XInternAtom(display, b'_NET_SYSTEM_TRAY_S0', 1)
owner = x.XGetSelectionOwner(display, atom) if atom else 0
if owner:
    print(hex(owner))
EOF
}

# Wait for the system tray to exist and stop moving before starting nm-applet.
#
# nm-applet negotiates its icon size once, at dock time, and never
# re-negotiates. Docking against a tray which is subsequently torn down leaves
# it re-docked to the replacement but still carrying the size it agreed with
# the old one, producing a 21x21 icon positioned one pixel below the bottom
# edge of the screen: present in the tray, correctly reported by xwininfo, and
# completely invisible.
#
# Watching the selection owner alone is NOT enough, which an earlier version
# of this function got wrong. 'xfce4-panel -r' restarts the panel process
# first and respawns its plugin wrappers several seconds later, so the
# selection can be held by an instance that is about to die. Observed:
#
#   23:06:24  xfce4-panel starts
#   23:06:27  selection owner stable, nm-applet starts and docks
#   23:06:30  every plugin wrapper respawns, systray included
#
# The icon was wrong despite panel-1 already having correct geometry when
# nm-applet docked, so this is not about the panel still being laid out.
#
# Track the systray WRAPPER PROCESS as well as the selection: both must be
# present and unchanged across consecutive polls before the tray is final.
# PIDs of systray wrappers belonging to the CURRENT panel.
#
# Wrappers whose panel has died get reparented to init and can linger for
# hours still holding X windows, so an unfiltered list would contain a PID
# which never changes and would dilute the signal we are waiting on. Only
# wrappers parented to a live xfce4-panel say anything about whether the tray
# is finished being rebuilt.
systray_wrapper_pids() {
    local pid ppid

    for pid in $(pgrep -f 'xfce4/panel/wrapper-2.0.*libsystray' 2>/dev/null); do
        ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        [ -n "$ppid" ] || continue
        [ "$(ps -o comm= -p "$ppid" 2>/dev/null)" = "xfce4-panel" ] || continue
        echo "$pid"
    done | sort | tr '\n' ','
}

wait_for_stable_tray() {
    local deadline=$((SECONDS + 25))
    local required_stable_polls=6
    local stable=0
    local state=""
    local previous=""

    while [ "$SECONDS" -lt "$deadline" ]; do
        # Both halves matter: the selection says a tray is claimable, the
        # wrapper PIDs say the plugin behind it is not about to be replaced.
        state="$(tray_selection_owner):$(systray_wrapper_pids)"

        case "$state" in
            :*|*:)
                # Missing one half or the other; not ready.
                stable=0
                ;;
            *)
                if [ "$state" = "$previous" ]; then
                    stable=$((stable + 1))
                    if [ "$stable" -ge "$required_stable_polls" ]; then
                        echo "System tray settled: $state"
                        return 0
                    fi
                else
                    stable=0
                fi
                ;;
        esac

        previous="$state"
        sleep 0.5
    done

    echo "WARNING: system tray did not settle within 25s (state: ${state:-none});" \
         "starting nm-applet anyway" >&2
    return 1
}

# Snapshot tray/panel state after everything has been restarted, so the
# intermittent "nm-applet icon never appears" failure (dc-fka) is captured
# automatically rather than depending on someone running tray-diag by hand
# before restarting fluxbox, which is what normally clears it.
#
# nm-applet needs a moment to dock before the icon geometry means anything;
# a too-early snapshot shows no icon regardless of whether it would appear.
capture_tray_diag() {
    local dir=~/.log/tray-diag
    local out

    command -v tray-diag >/dev/null 2>&1 || return 0

    mkdir -p "$dir" || return 0
    out="$dir/$(date +%Y%m%d-%H%M%S).${layout:-unknown}.txt"

    (
        sleep 5
        set -o pipefail

        # Prune to 199 before writing. If retention cannot be enforced, skip
        # this capture rather than allowing repeated failures to grow forever.
        stale_captures=$(
            find "$dir" -maxdepth 1 -name '*.txt' -printf '%T@ %p\n' 2>/dev/null |
                sort -rn | tail -n +200 | cut -d' ' -f2-
        ) || exit 0
        while IFS= read -r stale; do
            [ -z "$stale" ] || rm -f -- "$stale" || exit 0
        done <<< "$stale_captures"

        # A failed diagnostic may leave partial output, but pre-pruning keeps
        # that file inside the same 200-capture bound.
        tray-diag "$out" >/dev/null 2>&1 || true

        # Wrapper respawns arrive about six seconds after the panel restart.
        # Update the outstanding-evidence report after that boundary.
        sleep 2
        if command -v panel-debug-status >/dev/null 2>&1; then
            panel-debug-status >/dev/null 2>&1 || true
        fi
    ) >/dev/null 2>&1 &
}

# Snapshot the shadow controller's audit log around a display transition, so
# the trace scenarios dc-a5y.11 needs accumulate from normal use instead of
# Adam being asked to perform dock/undock/suspend cycles deliberately.  See
# AGENTS.md, "Blocking on Hardware Events".
#
# The shadow controller already writes a rotating audit log, but rotation can
# discard a transition before anyone looks at it, and nothing in the log says
# which of the seven required scenarios a given stretch covers.  This records
# the tail plus the topology that produced it, which is what makes a capture
# classifiable afterwards.
#
# Cheap and non-fatal by construction: no shadow log means no work, and every
# failure path returns success so a capture problem can never fail a relayout.
capture_shadow_trace() {
    local state_home=${XDG_STATE_HOME:-$HOME/.local/state}
    local audit=$state_home/monitor-controller/shadow/audit.jsonl
    local dir=~/.log/shadow-traces
    local out

    [ -r "$audit" ] || return 0

    mkdir -p "$dir" || return 0
    out="$dir/$(date +%Y%m%d-%H%M%S).${layout:-unknown}.json"

    (
        # Let the controller observe and settle before sampling, so the tail
        # contains this transition rather than only the state preceding it.
        sleep 8

        {
            printf '{\n'
            printf '  "captured_at": "%s",\n' "$(date --iso-8601=seconds)"
            printf '  "layout": "%s",\n' "${layout:-unknown}"
            printf '  "expected_layout": "%s",\n' "${expected_layout:-}"
            printf '  "identity": "%s",\n' "$(monitor-identity 2>/dev/null)"
            printf '  "uptime_seconds": %s,\n' "$(cut -d' ' -f1 /proc/uptime)"
            # Cumulative suspended time; a change since the previous capture
            # identifies a suspend/resume transition rather than a hotplug.
            printf '  "suspended_seconds": %s,\n' \
                "$(python3 -c 'import time
print(int(time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)))' 2>/dev/null || echo null)"
            printf '  "outputs": '
            xrandr --query 2>/dev/null |
                python3 -c 'import json,sys
outputs=[]
for line in sys.stdin:
    parts=line.split()
    if len(parts)>=2 and parts[1]=="connected":
        outputs.append({"name":parts[0],
                        "geometry":next((p for p in parts if "x" in p and "+" in p),None)})
print(json.dumps(outputs))' 2>/dev/null || printf '[]'
            printf ',\n  "audit_tail": '
            # Bounded tail, with each record's full reducer state dropped.
            # State snapshots are ~20KB each, so keeping them would make a
            # single capture 2MB and the retained set hundreds of megabytes.
            # What classifies a transition is the event sequence, the effects,
            # and the profile the reducer selected -- not its entire state.
            tail -n 400 "$audit" 2>/dev/null |
                python3 -c 'import json,sys

def summarise(state):
    """Keep the few state fields that identify a transition."""
    if not isinstance(state, dict):
        return None
    keep = ("phase", "current_profile", "target_profile",
            "desktop_finalized_profile", "pending_action",
            "display_identity", "authority_allowed")
    return {k: state[k] for k in keep if k in state}

recs = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        rec = json.loads(line)
    except ValueError:
        continue
    if isinstance(rec, dict):
        for field in ("state", "initial_state"):
            if field in rec:
                rec[field] = summarise(rec[field])
        # raw_evidence is ~13KB of verbatim xrandr lines per observation and
        # is reconstructible from "outputs" above.  live_fingerprints are
        # kept: they are the EDID identities, which is exactly what the
        # slow/broken-EDID scenarios turn on.
        observation = rec.get("event", {}).get("observation")
        if isinstance(observation, dict):
            evidence = observation.pop("raw_evidence", None)
            if evidence is not None:
                observation["raw_evidence_count"] = len(evidence)
    recs.append(rec)
print(json.dumps(recs))' 2>/dev/null || printf '[]'
            printf '\n}\n'
        } > "$out" 2>/dev/null

        # Keep the newest 200 captures; older transitions have either been
        # reconciled into fixtures or are no longer interesting.
        find "$dir" -maxdepth 1 -name '*.json' -printf '%T@ %p\n' 2>/dev/null |
            sort -rn | tail -n +201 | cut -d' ' -f2- |
            while IFS= read -r stale; do rm -f "$stale"; done
    ) >/dev/null 2>&1 &
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
