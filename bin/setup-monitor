#!/bin/bash

#exec >& ~/.log/setup-monitor.log

STALE_EXIT_CODE=75

layout=""
expected_layout=""
expected_md5=""
skip_xrandr=0
terminated=0
localhost_nickname=""
screen_0_name=""
screen_1_name=""
screen_2_name=""

# shellcheck source=/home/adam/lib/libhost.sh
. ~/lib/libhost.sh
read_localhost_nickname

usage() {
    cat <<EOF
Usage: setup-monitor [--layout LAYOUT] [--expected-layout LAYOUT] [--expected-md5 MD5] [--skip-xrandr]

--skip-xrandr skips the xrandr invocation, for when something else
(e.g. autorandr; see specs/autorandr-hybrid-monitor-plan.md) has
already applied it.
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --layout)
                layout="$2"
                shift 2
                ;;
            --expected-layout)
                expected_layout="$2"
                shift 2
                ;;
            --expected-md5)
                expected_md5="$2"
                shift 2
                ;;
            --skip-xrandr)
                skip_xrandr=1
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                echo "ERROR: Unknown argument: $1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

monitor_md5_file=~/.cache/libdpy/inxi-Gxx.monitors.json.md5

current_monitor_md5() {
    ~/lib/libdpy.py --inxi-json >/dev/null
    if [ -f "$monitor_md5_file" ]; then
        cat "$monitor_md5_file"
    fi
}

current_layout_name() {
    local current_layout_file

    if ! current_layout_file=$(get-layout); then
        return 1
    fi

    basename -s .yaml "$current_layout_file"
}

stale_exit() {
    echo "STALE: $1" >&2
    exit "$STALE_EXIT_CODE"
}

assert_expected_state() {
    local current_md5
    local current_layout

    if [ "$terminated" -ne 0 ]; then
        stale_exit "termination requested"
    fi

    if [ -n "$expected_md5" ]; then
        current_md5=$(current_monitor_md5)
        if [ -z "$current_md5" ]; then
            stale_exit "failed to determine current monitor md5"
        fi
        if [ "$current_md5" != "$expected_md5" ]; then
            stale_exit "monitor md5 changed from $expected_md5 to $current_md5"
        fi
    fi

    if [ -n "$expected_layout" ]; then
        current_layout=$(current_layout_name) || stale_exit "failed to determine current layout"
        if [ "$current_layout" != "$expected_layout" ]; then
            stale_exit "layout changed from $expected_layout to $current_layout"
        fi
    fi
}

handle_term() {
    terminated=1
}

trap handle_term TERM

get_layout() {
    if [ -n "$layout" ]; then
        echo "$layout"
        return 0
    fi

    echo -n "Getting layout ... "
    if ! layout=$( get-layout ); then
        exit 1
    fi

    layout=$(basename -s .yaml "$layout")
    echo "$layout"
}

load_display_data() {
    eval "$(~/lib/libdpy.py)"
}

validate_layout() {
    if ! ~/lib/liblayout.py --check-screen-counts "$layout" >/dev/null; then
        echo "ERROR: Layout '$layout' validation failed" >&2
        echo "This usually means 'xrandr --auto' hasn't been run to activate all connected monitors" >&2
        echo "Run 'xrandr --auto' and clear the libdpy cache, or check monitor-watcher logs" >&2
        exit 1
    fi
}

# Check whether OUTPUT advertises MODE at roughly RATE Hz, so we only
# request an explicit mode/rate combo which actually exists (e.g. the
# ultrawide via a dock may not offer 5120x2160@60).
output_has_mode_rate() {
    local output="$1" mode="$2" rate="$3"

    xrandr --query | awk -v output="$output" -v mode="$mode" -v rate="$rate" '
        /^[^ ]/ { in_output = ($1 == output) }
        in_output && $1 == mode {
            # Rate fields may carry current/preferred markers, e.g.
            # "60.00*+"; awk numeric coercion strips them.
            for (i = 2; i <= NF; i++)
                if ($i + 0 >= rate - 0.5 && $i + 0 < rate + 0.5) {
                    found = 1
                    exit
                }
        }
        END { exit !found }
    '
}

setup_xrandr() {
    celtic_width=2880
    celtic_height=1920
    celtic_size="${celtic_width}x${celtic_height}"
    BenQ_width=2560

    case "$layout" in
        celtic)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --primary --auto
            ;;
        celtic+external)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto
            ;;
        celtic+ultrawide)
            local ultrawide_mode_args=()
            if output_has_mode_rate "${screen_1_name}" 5120x2160 60; then
                ultrawide_mode_args=(--rate 60 --mode 5120x2160)
            else
                echo "WARNING: ${screen_1_name} doesn't offer 5120x2160@60; using preferred mode" >&2
            fi
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto "${ultrawide_mode_args[@]}"
            ;;
        celtic+external-secondary)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --primary --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --auto
            ;;
        celtic+BenQ)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto
            ;;
        celtic+BenQ+Dell)
            xrandr \
                --output "${screen_0_name}" --pos 0x0 --scale 1 --size "$celtic_size" --auto \
                --output "${screen_1_name}" --pos "${celtic_width}x0" --scale 1 --primary --auto \
                --output "${screen_2_name}" --pos "$(( celtic_width + BenQ_width ))x0" --scale 1 --auto
            # Alternate setup where laptop screen is off
            # xrandr \
            #     --output ${screen_0_name} --pos 0x0 --scale 1 --off \
            #     --output ${screen_1_name} --pos 0x0 --scale 1 --primary --auto \
            #     --output ${screen_2_name} --pos ${BenQ_width}x0 --scale 1 --auto
            ;;
        ionian)
            xrandr \
                --output DP-0 --pos 0x0 --scale 1 --primary --auto \
                --output DP-2.8 --pos 2560x0 --scale 1 --auto
            ;;
        *)
            echo "setup-monitor: don't know how to handle layout $layout"
            exit 1
            ;;
    esac

    # xrandr state changed; invalidate stale cache so subsequent
    # commands (e.g. setup-panels) see the correct primary.
    clear-dpy-cache
}

refresh_display_cache() {
    ~/lib/libdpy.py --inxi-json
    eval "$(~/lib/libdpy.py)"
}

setup_overlay() {
    local layout="$1"

    # Highest priority: layout-specific overlay
    if [ -e ~/.fluxbox/overlay."$layout" ]; then
        ln -sf "overlay.$layout" ~/.fluxbox/overlay
        return
    fi

    # Second priority: host-specific overlay
    if [ -e ~/.fluxbox/overlay."$localhost_nickname" ]; then
        ln -sf "overlay.$localhost_nickname" ~/.fluxbox/overlay
        return
    fi

    # Fallback: generate dynamically based on DPI
    echo "Generating dynamic overlay"
    local scale_factor
    local base_font=10
    local title_font
    local menu_font

    scale_factor=$(~/lib/libdpy.py --calculate-ui-scale)
    title_font=$(printf "%.0f" "$(echo "$base_font * $scale_factor" | bc)")
    menu_font=$(printf "%.0f" "$(echo "($base_font + 1) * $scale_factor" | bc)")

    cat > ~/.fluxbox/overlay <<EOF
window.borderWidth:               1
window.handleWidth:               8
window.font:                      sans-${title_font}:bold
window.title.height:              $(( 24 + (title_font - 10) * 2 ))
menu.title.font:                  sans-${title_font}:bold
menu.frame.font:                  sans-${menu_font}
menu.titleHeight:                 $(( 20 + (title_font - 10) * 2 ))
menu.itemHeight:                  10
EOF
}

setup_keyboard () {
    if host-has-prop laptop; then
        if BenQ-connected; then
            # Connect to Kinesis Advantage 360 over Bluetooth
            adv &
        else
            adv off &
        fi
    fi
}

main () {
    parse_args "$@"

    get_layout
    assert_expected_state

    load_display_data
    validate_layout
    if [ "$skip_xrandr" -eq 1 ]; then
        echo "Skipping xrandr setup (already applied, e.g. by autorandr)"
    else
        setup_xrandr
    fi
    assert_expected_state

    refresh_display_cache
    assert_expected_state

    setup_overlay "$layout"
    setup-panels
    setup_keyboard
    set-layout-dpi "$layout"
    setup-terminals
    assert_expected_state

    sleep 1

    fluxbox-reconfigure  # update ~/.fluxbox/keys
    assert_expected_state

    echo "Loading as-fonts via emacsclient ..."
    emacsclient -e '(load "as-fonts")'

    sleep 1

    echo "Fluxbox layout ..."
    run-with-local-X-display ly
    assert_expected_state

    echo "Fluxbox restart ..."
    fr

    echo "Restarting xfce4-panel ..."
    xfce4-panel -r
    assert_expected_state

    pkill nm-applet
    wait_for_stable_tray
    nohup nm-applet >&~/.log/nm-applet.log &

    capture_tray_diag
}

# Report the window owning the system tray selection, or nothing when there is
# no owner.
#
# The tray is an X SELECTION, not a root window property, so
# 'xprop -root _NET_SYSTEM_TRAY_S0' always reports "not found" no matter what
# and must never be used for this.
tray_selection_owner() {
    python3 - <<'EOF' 2>/dev/null
from ctypes import CDLL, c_void_p, c_char_p, c_int, c_ulong
import os

x = CDLL('libX11.so.6')
x.XOpenDisplay.argtypes = [c_char_p]
x.XOpenDisplay.restype = c_void_p
x.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
x.XInternAtom.restype = c_ulong
x.XGetSelectionOwner.argtypes = [c_void_p, c_ulong]
x.XGetSelectionOwner.restype = c_ulong

display = x.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
if not display:
    raise SystemExit(1)
atom = x.XInternAtom(display, b'_NET_SYSTEM_TRAY_S0', 1)
owner = x.XGetSelectionOwner(display, atom) if atom else 0
if owner:
    print(hex(owner))
EOF
}

# Wait for the system tray to exist and stop moving before starting nm-applet.
#
# nm-applet negotiates its icon size once, at dock time, and never
# re-negotiates. Docking against a tray which is subsequently torn down leaves
# it re-docked to the replacement but still carrying the size it agreed with
# the old one, producing a 21x21 icon positioned one pixel below the bottom
# edge of the screen: present in the tray, correctly reported by xwininfo, and
# completely invisible.
#
# Watching the selection owner alone is NOT enough, which an earlier version
# of this function got wrong. 'xfce4-panel -r' restarts the panel process
# first and respawns its plugin wrappers several seconds later, so the
# selection can be held by an instance that is about to die. Observed:
#
#   23:06:24  xfce4-panel starts
#   23:06:27  selection owner stable, nm-applet starts and docks
#   23:06:30  every plugin wrapper respawns, systray included
#
# The icon was wrong despite panel-1 already having correct geometry when
# nm-applet docked, so this is not about the panel still being laid out.
#
# Track the systray WRAPPER PROCESS as well as the selection: both must be
# present and unchanged across consecutive polls before the tray is final.
systray_wrapper_pids() {
    pgrep -f 'xfce4/panel/wrapper-2.0.*libsystray' 2>/dev/null | sort | tr '\n' ','
}

wait_for_stable_tray() {
    local deadline=$((SECONDS + 25))
    local required_stable_polls=6
    local stable=0
    local state=""
    local previous=""

    while [ "$SECONDS" -lt "$deadline" ]; do
        # Both halves matter: the selection says a tray is claimable, the
        # wrapper PIDs say the plugin behind it is not about to be replaced.
        state="$(tray_selection_owner):$(systray_wrapper_pids)"

        case "$state" in
            :*|*:)
                # Missing one half or the other; not ready.
                stable=0
                ;;
            *)
                if [ "$state" = "$previous" ]; then
                    stable=$((stable + 1))
                    if [ "$stable" -ge "$required_stable_polls" ]; then
                        echo "System tray settled: $state"
                        return 0
                    fi
                else
                    stable=0
                fi
                ;;
        esac

        previous="$state"
        sleep 0.5
    done

    echo "WARNING: system tray did not settle within 25s (state: ${state:-none});" \
         "starting nm-applet anyway" >&2
    return 1
}

# Snapshot tray/panel state after everything has been restarted, so the
# intermittent "nm-applet icon never appears" failure (dc-fka) is captured
# automatically rather than depending on someone running tray-diag by hand
# before restarting fluxbox, which is what normally clears it.
#
# nm-applet needs a moment to dock before the icon geometry means anything;
# a too-early snapshot shows no icon regardless of whether it would appear.
capture_tray_diag() {
    local dir=~/.log/tray-diag
    local out

    command -v tray-diag >/dev/null 2>&1 || return 0

    mkdir -p "$dir" || return 0
    out="$dir/$(date +%Y%m%d-%H%M%S).${layout:-unknown}.txt"

    (
        sleep 5
        tray-diag "$out" >/dev/null 2>&1
    ) &
}

main "$@"
