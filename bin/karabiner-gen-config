#!/usr/bin/env python3
"""Generate .config/karabiner/karabiner.json for the work MacBook.

The requirements are in specs/mac-keyboard-window-parity.md; section
numbers below refer to it. Edit this script, not the JSON: Karabiner's own
settings UI rewrites karabiner.json and would drop the generated rules on
the next run of this script.

    bin/karabiner-gen-config          # rewrite the JSON
    bin/karabiner-gen-config --check  # exit 1 if the JSON is out of date

Karabiner facts this relies on, from its docs
(https://karabiner-elements.pqrs.org/docs/):

- Complex rules are tried top to bottom and the first matching
  manipulator wins; its output is not fed to later complex rules
  (manual/misc/event-modification-chaining/,
  json/complex-modifications-manipulator-evaluation-priority/).
- Profile `devices[]` entries cannot match the built-in keyboard without
  its vendor and product IDs, but the `device_if` condition can, with
  `is_built_in_keyboard` (Karabiner 14.9.0 and later). So every remap here
  is a complex rule, and rules that match letters list the built-in
  keyboard's physical key separately (see `variants`).
- `from.modifiers.mandatory` modifiers are removed from the output, and
  without `optional` a rule does not match when other modifiers are held
  (json/complex-modifications-manipulator-definition/from/modifiers/).
  Modifier conditions see the output of earlier remaps, which is why
  Thumb+Ctrl bindings match both `command` and `control` (see `MODS`).
- `shell_command` runs under `/bin/sh -c` with a minimal environment and
  no Homebrew on PATH, and a new one kills any still running
  (.../to/shell-command/).
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any

Json = dict[str, Any]

REPO = Path(__file__).resolve().parent.parent
OUTPUT = REPO / ".config/karabiner/karabiner.json"

AEROSPACE = "/opt/homebrew/bin/aerospace"
JUMP = "~/bin/mac-jump"

# Bundle IDs are the vendors' published CFBundleIdentifier values, not
# checked on the Mac; check with `osascript -e 'id of app "Name"'`.
TERMINALS = [
    r"^com\.apple\.Terminal$",
    r"^com\.googlecode\.iterm2$",
    r"^net\.kovidgoyal\.kitty$",
    r"^com\.mitchellh\.ghostty$",
    r"^org\.alacritty$",
    r"^com\.github\.wez\.wezterm$",
]
EMACS = r"^org\.gnu\.Emacs$"
# Orca is one app whose editor and terminal panes Karabiner cannot tell
# apart, so all of it keeps Control as Control, like a terminal (spec 5.2).
ORCA = r"^com\.stablyai\.orca$"
VMS_AND_REMOTE_DESKTOPS = [
    r"^com\.microsoft\.rdc\.macos$",
    r"^com\.vmware\.fusion$",
    r"^com\.parallels\.desktop\.console$",
    r"^org\.virtualbox\.app\.VirtualBoxVM$",
    r"^com\.utmapp\.UTM$",
    r"^com\.citrix\.receiver\.icaviewer\.mac$",
]
# Apps where Control stays Control (spec 2.5).
# choose (mac-jump's picker) is fzf-like, so it takes Control as a terminal
# does: Ctrl+C / Ctrl+G cancel, Ctrl+N / Ctrl+P move (Adam, 2026-11-14).
CHOOSE = r"^org\.senkbeil\.choose$"
CONTROL_APPS = TERMINALS + [EMACS, ORCA, CHOOSE] + VMS_AND_REMOTE_DESKTOPS
# choose is a bare executable, not an .app, so Karabiner may not see its
# bundle ID; match its path too (Adam, 2026-11-14: Ctrl+C still copied).
CONTROL_APP_PATHS = [r"/choose$"]

# USB IDs from .config/keyd/daemon/*.conf.
ADVANTAGE2 = [(0x29EA, 0x0102), (0x29EA, 0x0103)]
ADVANTAGE_360 = [(0x29EA, 0x0362), (0x1D50, 0x615E)]
# The Keyboardio boards differ: the Atreus has two keys per side under
# the thumbs, the Model 01 a four-key thumb arc and a palm key (spec 5.6).
ATREUS = [(0x1209, 0x2302)]
MODEL_01 = [(0x1209, 0x2301)]

# Left-hand alpha shift on the built-in keyboard (spec 2.1): physical key
# -> key it types. On the MacBook's ISO keyboard Karabiner reports the key
# left of `1` (labelled §) as non_us_backslash and the key left of Z as
# grave_accent_and_tilde, the other way round from Linux (checked on the
# Mac, 2026-11-14: the Linux-style mapping typed q and x swapped).
ALPHA_SHIFT = {
    "non_us_backslash": "q",
    "q": "w",
    "w": "e",
    "e": "r",
    "r": "t",
    "t": "grave_accent_and_tilde",
    "caps_lock": "a",
    "a": "s",
    "s": "d",
    "d": "f",
    "f": "g",
    "g": "backslash",
    "fn": "z",
    "grave_accent_and_tilde": "x",
    "z": "c",
    "x": "v",
}
TYPED_BY = {typed: physical for physical, typed in ALPHA_SHIFT.items()}

# Thumb+Ctrl matches whichever modifier the Control-position key sends:
# Command in ordinary apps, Control in CONTROL_APPS.
MODS = {
    "ctrl": ["command", "control"],
    "control": ["control"],
    "alt": ["option"],
    "shift": ["shift"],
}

# Keys the Thumb layer swallows when unbound, so Thumb+key never types.
PRINTABLE = (
    list("abcdefghijklmnopqrstuvwxyz1234567890")
    + [
        "hyphen", "equal_sign", "open_bracket", "close_bracket", "backslash",
        "semicolon", "quote", "grave_accent_and_tilde", "comma", "period",
        "slash", "non_us_backslash", "spacebar", "return_or_enter", "tab",
        "delete_or_backspace", "left_arrow", "right_arrow", "up_arrow",
        "down_arrow",
    ]
)


def device(*ids: tuple[int, int]) -> Json:
    return {
        "type": "device_if",
        "identifiers": [{"vendor_id": v, "product_id": p} for v, p in ids],
    }


BUILT_IN = {"type": "device_if", "identifiers": [{"is_built_in_keyboard": True}]}
NOT_BUILT_IN = {**BUILT_IN, "type": "device_unless"}


def variable(name: str, value: int = 1) -> Json:
    return {"type": "variable_if", "name": name, "value": value}


def set_var(name: str, value: int) -> Json:
    return {"set_variable": {"name": name, "value": value}}


def notify(name: str, text: str = "") -> Json:
    """Show Karabiner's on-screen notification `name`, or clear it with no
    text. Marks the modes, which change what keys do (Adam, 2026-11-14)."""
    return {"set_notification_message": {"id": f"desktop-config.{name}", "text": text}}


PASSTHROUGH_ON = notify("passthrough", "Pass-through mode: Q leaves")
REORGANISE_ON = notify("reorganise", "Reorganise mode: Q, Esc or Space leaves")


def apps(patterns: list[str], negate: bool = False, paths: list[str] | None = None) -> Json:
    kind = "frontmost_application_unless" if negate else "frontmost_application_if"
    condition: Json = {"type": kind, "bundle_identifiers": patterns}
    if paths:
        condition["file_paths"] = paths
    return condition


def shell(command: str) -> list[Json]:
    return [{"shell_command": command}]


def key(code: str, *modifiers: str) -> list[Json]:
    event: Json = {"key_code": code}
    if modifiers:
        event["modifiers"] = list(modifiers)
    return [event]


def aerospace(args: str) -> list[Json]:
    return shell(f"{AEROSPACE} {args}")


def jump(args: str) -> list[Json]:
    return shell(f"{JUMP} {args}")


def open_bundle(bundle: str) -> list[Json]:
    return shell(f"open -b {bundle}")


def variants(typed: str) -> list[tuple[str, list[Json]]]:
    """Physical keys that type `typed`, each with its device condition."""
    # On the built-in keyboard the key named `typed` may type something
    # else, and `c` and `v` are typed by two keys each.
    same = [(typed, [NOT_BUILT_IN] if typed in ALPHA_SHIFT else [])]
    moved = [(TYPED_BY[typed], [BUILT_IN])] if typed in TYPED_BY else []
    return same + moved


def manipulators(
    typed: str,
    to: list[Json],
    mods: str = "",
    conditions: list[Json] | None = None,
    optional: list[str] | None = None,
) -> list[Json]:
    """One manipulator per physical variant and per alternative modifier."""
    mod_options: list[list[str]] = [[]]
    for name in mods.split("+") if mods else []:
        mod_options = [m + [alt] for m in mod_options for alt in MODS[name]]
    result = []
    for physical, device_conditions in variants(typed):
        for mandatory in mod_options:
            source: Json = {"key_code": physical}
            modifiers: Json = {}
            if mandatory:
                modifiers["mandatory"] = mandatory
            if optional:
                modifiers["optional"] = optional
            if modifiers:
                source["modifiers"] = modifiers
            result.append(
                {
                    "type": "basic",
                    "from": source,
                    "to": to,
                    "conditions": (conditions or []) + device_conditions,
                }
            )
    return result


def rule(description: str, manips: list[Json]) -> Json:
    return {"description": description, "manipulators": manips}


THUMB = variable("thumb")

# Adam's personal Chrome profile folder, from chrome://version; the other
# is for work (Adam, 2026-11-16).
PERSONAL_CHROME_PROFILE = "Profile 1"

# What Thumb+8 (push-to-talk) and Thumb+9 (toggle) dictate with:
# "macos" for macOS Dictation, "sussurro" to send Sussurro's hotkeys.
DICTATION = "macos"
# Sussurro's hotkeys on the Mac: its Linux super+8 / super+9, with Super
# as Command. Match these to ~/.sussurro/config.yaml there.
SUSSURRO_HOTKEYS = {"8": ("8", "command"), "9": ("9", "command")}


def thumb(typed: str, to: list[Json], mods: str = "", extra: list[Json] | None = None) -> list[Json]:
    return manipulators(typed, to, mods, [THUMB] + (extra or []))


def hide_if_frontmost(typed: str, bundle: str, mods: str = "") -> list[Json]:
    """Hide the app if it is frontmost. `mac-jump hide` rather than Cmd+H,
    so AeroSpace stays on this workspace instead of following macOS to
    whichever app it activates next (Adam, 2026-11-16)."""
    return thumb(typed, jump(f"hide {bundle}"), mods, [apps([f"^{re.escape(bundle)}$"])])


def toggle(typed: str, bundle: str, mods: str = "") -> list[Json]:
    """Hide the app if frontmost, else focus or launch it (spec 3.1, T)."""
    return hide_if_frontmost(typed, bundle, mods) + thumb(typed, open_bundle(bundle), mods)


def settings_toggle(typed: str, pane: str, mods: str = "") -> list[Json]:
    """Open a System Settings pane, or hide System Settings if it is
    frontmost, as toggle() does for apps (Adam, 2026-11-16). Karabiner cannot
    tell which pane is showing, so any settings key hides it."""
    return hide_if_frontmost(typed, "com.apple.systempreferences", mods) + thumb(
        typed, shell(f"open 'x-apple.systempreferences:{pane}'"), mods
    )


def thumb_trigger_rule() -> Json:
    # Thumb (spec 5.1): right Command on every keyboard, plus the key in
    # Thumb's position on keyboards that send something else there: the
    # Atreus's Space sends left GUI when held, and the Advantage 360's GUI
    # key side is unknown. The Model 01's Thumb key sends right GUI.
    triggers = [("right_command", [])]
    triggers += [("right_control", [device(*ADVANTAGE2)])]
    triggers += [("left_command", [device(*ADVANTAGE_360, *ATREUS)])]
    manips = []
    for code, conditions in triggers:
        manips.append(
            {
                "type": "basic",
                "from": {"key_code": code, "modifiers": {"optional": ["any"]}},
                "to": [set_var("thumb", 1)],
                "to_after_key_up": [set_var("thumb", 0)],
                "conditions": [variable("passthrough", 0)] + conditions,
            }
        )
    return rule(
        "Thumb layer: hold right Command (Advantage2: right Ctrl). "
        "Generated by bin/karabiner-gen-config; edit that, not this file",
        manips,
    )


def jumps() -> list[Json]:
    """Spec 3.1."""
    m: list[Json] = []
    # Cycles, then hides after the last window (Adam, 2026-11-16).
    m += thumb("a", jump(r"cycle --toggle --launch com.anthropic.claudefordesktop '^(com\.anthropic\.claudefordesktop|com\.openai\.chat)$'"))
    # shortcut: cycles every Chrome window, not just those on the main
    # monitor as on Linux; filter by %{monitor-id} if that matters.
    m += thumb("b", jump(r"cycle --launch com.google.Chrome '^com\.google\.Chrome$'"))
    m += toggle("c", "com.stablyai.orca")
    m += thumb("d", jump("emacs ~/lib/emacs/shortcuts/org-agenda-today.el"))
    m += toggle("e", "org.gnu.Emacs")
    m += thumb("f", open_bundle("org.mozilla.firefox"))
    m += thumb("g", shell("open -a Telegram"))
    m += thumb("h", jump(r"tab --pick --open https://github.com/ '^https://github\.com/'"))
    # Jira in Chrome tabs, picked like GitHub's (Adam, 2026-11-16: no Jira
    # web app any more). Its URL is private: "jira" in ~/.config/mac-jump/sites.
    m += thumb("j", jump("tab --pick --site jira"))
    m += thumb("k", jump("emacs '(org-capture)'"))
    # With Outlook in front, cycle its windows and hide it after the last;
    # otherwise go to its mail (Adam, 2026-11-16).
    outlook = r"^com\.microsoft\.Outlook$"
    m += thumb("m", jump(f"cycle --toggle '{outlook}'"), extra=[apps([outlook])])
    m += thumb("m", jump("outlook mail"))
    m += thumb("n", jump("emacs '(as-find-personal-note)'"))
    m += thumb("o", jump("teams planner"))
    m += settings_toggle("p", "com.apple.Sound-Settings.extension")
    # Cycles when Slack has several windows, then hides it (Adam, 2026-11-16).
    m += thumb("s", jump(r"cycle --toggle --launch com.tinyspeck.slackmacgap '^com\.tinyspeck\.slackmacgap$'"))
    # Hides Teams when it is frontmost, as toggle() does (Adam, 2026-11-16).
    m += hide_if_frontmost("t", "com.microsoft.teams2")
    m += thumb("t", jump("teams chat"))
    m += settings_toggle("u", "com.apple.BluetoothSettings")
    m += thumb("v", jump("emacs ~/lib/emacs/shortcuts/org-agenda-daily-review.el"))
    m += settings_toggle("w", "com.apple.wifi-settings-extension")
    terminals = "|".join(p.strip("^$") for p in TERMINALS)
    m += thumb("x", jump(f"cycle --launch com.apple.Terminal '^({terminals})$'"))
    m += thumb("y", jump(r"tab --pick --open https://www.youtube.com/ '^https://(www\.)?youtube\.com/'"))
    m += thumb("z", shell("open -a Zulip"))
    m += toggle("grave_accent_and_tilde", "com.apple.ActivityMonitor")
    m += thumb("quote", shell("open -a Beeper"))
    # Linux: chrome-session-rofi, a fuzzy picker of every Chrome tab.
    m += thumb("tab", jump("tab --pick '.'"))

    m += thumb("a", shell("open -a Anytype"), "shift")
    m += thumb("a", jump(r"tab --toggle --app-window --open https://open.spotify.com/ '^https://open\.spotify\.com/'"), "ctrl")
    m += thumb("b", jump(r"tab --toggle --app-window --open http://localhost:19847/ '^http://localhost:19847/'"), "ctrl")
    m += thumb(
        "c",
        jump(rf"tab --profile '{PERSONAL_CHROME_PROFILE}' --open https://calendar.google.com/calendar/u/0 '^https://calendar\.google\.com/calendar/u/0'"),
        "shift",
    )
    m += thumb("c", jump("outlook calendar"), "ctrl")
    m += thumb("d", shell("open -a Discord"), "ctrl")
    # Linux: xfce4-display-settings.
    m += settings_toggle("d", "com.apple.Displays-Settings.extension", "ctrl+alt")
    m += thumb("e", jump(r"tab --pick --open https://linear.app/ '^https://linear\.app/'"), "shift")
    m += thumb("f", jump(r"tab --pick --open https://www.messenger.com/ '^https://(www\.)?messenger\.com/'"), "ctrl")
    m += thumb("g", jump(r"tab --open https://meet.google.com/ '^https://meet\.google\.com/'"), "shift")
    m += thumb("g", jump(r"tab '^https://meet\.google\.com/[a-z]+-[a-z]+-[a-z]+'"), "ctrl")
    m += thumb("h", jump(r"tab --toggle --app-window --open https://octobox.io/ '^https://octobox\.io/'"), "ctrl")
    m += thumb("n", shell("open -a Notion"), "alt")
    m += thumb("n", jump(r"tab --pick --open https://www.notion.so/ '^https://(www|app)\.notion\.(so|com)/'"), "shift")
    m += thumb("r", jump(r"tab --open https://app.reclaim.ai/ '^https://app\.reclaim\.ai/'"), "shift")
    m += thumb("t", jump("teams meeting"), "ctrl")
    # Light / dark mode: Linux has it as T in the terminal menu
    # (set-colour-theme --toggle); the Mac has no terminal menu (Adam,
    # 2026-11-16). Needs Automation permission for System Events.
    m += thumb(
        "t",
        shell("osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to not dark mode'"),
        "shift",
    )
    m += thumb("w", jump(r"tab --open https://web.whatsapp.com/ '^https://web\.whatsapp\.com/'"), "alt")
    m += thumb("z", jump(r"tab --pick 'zoom\.us/'"), "shift")
    m += thumb("z", jump(r"tab 'zoom\.us/(wc|j)/'"), "ctrl")
    m += thumb("2", jump("emacs '(as-find-personal-todo)'"), "ctrl")
    m += thumb("7", jump("emacs ~/lib/emacs/shortcuts/org-agenda-weekly-review.el"), "ctrl")
    return m


ARROWS = {"left_arrow": "left", "right_arrow": "right", "up_arrow": "up", "down_arrow": "down"}
VIM = {"h": "left", "j": "down", "k": "up", "l": "right"}


def window_operations() -> list[Json]:
    """Spec 3.2, as AeroSpace commands."""
    m: list[Json] = []
    for code, direction in ARROWS.items():
        m += thumb(code, aerospace(f"focus {direction}"))
        m += thumb(code, aerospace(f"focus {direction}"), "ctrl")
    # Tiling windows move between tiles, not by pixels (spec 5.7).
    for code, direction in {**ARROWS, **VIM}.items():
        m += thumb(code, aerospace(f"move {direction}"), "shift")
        m += thumb(code, aerospace(f"join-with {direction}"), "alt+shift")
    cycle = "focus --boundaries-action wrap-around-the-workspace"
    m += thumb("slash", aerospace(f"{cycle} dfs-next"))
    m += thumb("slash", aerospace(f"{cycle} dfs-prev"), "shift")
    # AeroSpace cannot focus minimised windows, so Ctrl adds nothing.
    m += thumb("slash", aerospace(f"{cycle} dfs-next"), "ctrl")
    m += thumb("return_or_enter", jump("windows"), "alt")
    for n in range(1, 7):
        m += thumb(str(n), aerospace(f"workspace {n}"))
        m += thumb(str(n), aerospace(f"move-node-to-workspace --focus-follows-window {n}"), "alt")
    # next/prev step through workspaces 1-6 in order, empty ones included,
    # stopping at either end (Adam, 2026-11-14: no wrapping round). The list
    # goes on stdin, which AeroSpace 0.20 reads only with --stdin.
    numbered = "printf '%s\\n' 1 2 3 4 5 6 | " + AEROSPACE
    for code, step in {"comma": "prev", "period": "next"}.items():
        m += thumb(code, shell(f"{numbered} workspace --stdin {step}"))
        m += thumb(
            code,
            shell(f"{numbered} move-node-to-workspace --stdin --focus-follows-window {step}"),
            "alt",
        )
    # Previous / next monitor, wrapping round, not left / right: with the
    # laptop below the external monitor, left and right found nothing
    # (Adam, 2026-11-15). With two monitors either key reaches the other.
    for code, step in {"comma": "prev", "period": "next"}.items():
        m += thumb(code, aerospace(f"focus-monitor --wrap-around {step}"), "shift")
        m += thumb(code, aerospace(f"move-node-to-monitor --wrap-around --focus-follows-window {step}"), "alt+shift")
    for n in range(1, 4):
        m += thumb(str(n), aerospace(f"move-node-to-monitor --focus-follows-window {n}"), "alt+shift")
    m += thumb("i", aerospace("macos-native-minimize"))
    # Sticky, as near as AeroSpace gets: toggle onto workspace S (spec 3.2).
    m += thumb("s", jump("sticky"), "shift")
    # Thumb+Ctrl+m, not Linux's Thumb+Ctrl+Shift+m: AeroSpace has no
    # horizontal-only maximise for Ctrl+m to keep (Adam, 2026-11-16).
    m += thumb("m", aerospace("fullscreen"), "ctrl")
    # Raise means nothing when tiling; Adam chose float/tile instead (5.7).
    m += thumb("spacebar", aerospace("layout floating tiling"))
    m += thumb("q", aerospace("close"))
    m += thumb("q", aerospace("close --quit-if-last-window"), "ctrl")
    # Modes. Thumb's own variable resets when Thumb is released.
    m += thumb("p", [set_var("passthrough", 1), PASSTHROUGH_ON], "ctrl")
    m += thumb("r", [set_var("reorganise", 1), REORGANISE_ON])
    m += thumb("hyphen", [set_var("grid_level", 1)])
    return m


def other_bindings() -> list[Json]:
    """Spec 3.5."""
    m: list[Json] = []
    m += thumb("open_bracket", [{"consumer_key_code": "volume_decrement"}])
    m += thumb("close_bracket", [{"consumer_key_code": "volume_increment"}])
    m += thumb("0", [{"consumer_key_code": "mute"}])
    # Ctrl, not Shift (Adam, 2026-11-14). The same brightness keys F1 / F2
    # send, which MonitorControl also picks up for external displays. (The
    # laptop keyboard cannot send Thumb+Ctrl+[ at all: it drops the key with
    # both Command keys held.)
    m += thumb("open_bracket", [{"consumer_key_code": "display_brightness_decrement"}], "ctrl")
    m += thumb("close_bracket", [{"consumer_key_code": "display_brightness_increment"}], "ctrl")
    m += thumb("s", key("4", "command", "shift"), "ctrl")
    m += thumb("w", shell("screencapture -iWo \"$HOME/Desktop/Screenshot $(date '+%F at %H.%M.%S').png\""), "ctrl")
    m += thumb("spacebar", key("spacebar", "command"), "ctrl")
    # Linux: Shift+Control+Alt+Super+l runs xflock4 (.fluxbox/keys.erb);
    # the spec first left out Shift (Adam, 2026-11-16).
    m += thumb("l", key("q", "control", "command"), "ctrl+alt+shift")
    # Linux: Control+Alt+Super+b runs blank-all-screens. macOS sleeps the
    # displays without suspending (Adam, 2026-11-16).
    m += thumb("b", shell("pmset displaysleepnow"), "ctrl+alt")
    m += dictation_bindings()
    return m


def dictation_bindings() -> list[Json]:
    """Thumb+8 push-to-talk, Thumb+9 toggle, as Sussurro's super+8 /
    super+9 on Linux. DICTATION picks the engine (Adam, 2026-11-14:
    macOS Dictation for now, keeping Sussurro a one-line switch)."""
    if DICTATION == "sussurro":
        # Karabiner holds the hotkey down for as long as Thumb+8 is held,
        # so Sussurro's own push-to-talk sees a held key.
        return [m for n, (code, *mods) in SUSSURRO_HOTKEYS.items() for m in thumb(n, key(code, *mods))]
    if DICTATION != "macos":
        sys.exit(f"DICTATION must be macos or sussurro, not {DICTATION!r}")
    # The Dictation key toggles macOS Dictation, so push-to-talk presses
    # it again on release. Karabiner holds the last key of `to` until
    # Thumb+8/9 is released, and held, the key brought up Siri instead
    # (Adam, 2026-11-14), so vk_none goes last to make it a tap.
    tap = [{"consumer_key_code": "dictation"}, {"key_code": "vk_none"}]
    return [{**manip, "to_after_key_up": tap[:1]} for manip in thumb("8", tap)] + thumb("9", tap)


def kinesis_end_rule() -> Json:
    """Spec 2.4: the Kinesis End key sends Esc (firmware), and with Thumb
    gives End, which was in the spec but never built (Adam, 2026-11-16).
    End as PC-style editing has it (2.5): Cmd+Right in ordinary apps, End
    in the exception apps, Shift selecting."""
    kinesis = [device(*ADVANTAGE2, *ADVANTAGE_360)]
    m = manipulators("escape", key("right_arrow", "command"), conditions=[THUMB] + kinesis + [apps(CONTROL_APPS, negate=True, paths=CONTROL_APP_PATHS)], optional=["shift"])
    m += manipulators("escape", key("end"), conditions=[THUMB] + kinesis, optional=["shift"])
    return rule("Kinesis: Thumb+End key (which sends Esc) gives End (spec 2.4)", m)


def block_unbound() -> Json:
    manips = [
        {
            "type": "basic",
            "from": {"key_code": code, "modifiers": {"optional": ["any"]}},
            "to": [{"key_code": "vk_none"}],
            "conditions": [THUMB],
        }
        for code in PRINTABLE + ["caps_lock", "fn"]
    ]
    return rule("Thumb layer: swallow unbound keys, so Thumb+key never types", manips)


def passthrough_rule() -> Json:
    # Thumb+Ctrl+p: Thumb reaches apps as plain right Command until q.
    return rule(
        "Pass-through mode: q leaves it (spec 3.2)",
        manipulators("q", [set_var("passthrough", 0), notify("passthrough")], conditions=[variable("passthrough")]),
    )


def reorganise_rule() -> Json:
    """Reorganise mode, entered with Thumb+r (spec 5.7)."""
    mode = [variable("reorganise")]
    m: list[Json] = []
    for code in ["q", "escape", "spacebar"]:
        m += manipulators(code, [set_var("reorganise", 0), notify("reorganise")], conditions=mode)
    for code, direction in VIM.items():
        m += manipulators(code, aerospace(f"focus {direction}"), conditions=mode)
    for code, direction in ARROWS.items():
        m += manipulators(code, aerospace(f"move {direction}"), conditions=mode)
        m += manipulators(code, aerospace(f"join-with {direction}"), "shift", mode)
    # As on Linux, Left and Up shrink, Right and Down grow.
    resize = {"left_arrow": "width -", "right_arrow": "width +", "up_arrow": "height -", "down_arrow": "height +"}
    for code, change in resize.items():
        m += manipulators(code, aerospace(f"resize {change}50"), "ctrl", mode)
        m += manipulators(code, aerospace(f"resize {change}200"), "ctrl+shift", mode)
    for typed, args in {
        "m": "fullscreen",
        "t": "layout tiles horizontal vertical",
        "a": "layout accordion horizontal vertical",
        "f": "layout floating tiling",
        "b": "balance-sizes",
        "0": "flatten-workspace-tree",
    }.items():
        m += manipulators(typed, aerospace(args), conditions=mode)
    m += manipulators("2", aerospace("layout --root h_tiles"), "shift", mode)
    m += manipulators("semicolon", aerospace("layout --root v_tiles"), "shift", mode)
    return rule("Reorganise mode: q, Escape or Space leaves it", m)


def control_app_rules() -> Json:
    m: list[Json] = []
    # Linux terminals copy and paste with Ctrl+Shift+C / V.
    for typed in ("c", "v"):
        # In these apps the Control-position key always sends Control.
        m += manipulators(typed, key(typed, "command"), "control+shift", [apps(TERMINALS + [ORCA])])
    # Spec 2.6: cycle Orca agents waiting for attention. The helper comes
    # from Adam's ai-config repository; unchecked on macOS.
    orca = [apps([ORCA])]
    m += manipulators("up_arrow", shell("~/bin/orca-cycle-attention-agent previous"), "alt+shift", orca)
    m += manipulators("down_arrow", shell("~/bin/orca-cycle-attention-agent next"), "alt+shift", orca)
    return rule("Terminals and Orca: Ctrl+Shift+C/V copy and paste; Orca attention cycling", m)


def editing_rule() -> Json:
    """Spec 2.5, approach A2 (spec 5.2): the Control-position key sends
    Command in ordinary apps, so Cmd+C etc. need no rules; only keys whose
    Mac equivalent differs are translated."""
    ordinary = [apps(CONTROL_APPS, negate=True, paths=CONTROL_APP_PATHS)]
    # left_command is the Control-position key. In ordinary apps the
    # Compose-position key sends Control, never Command (spec 5.2).
    ctrl = {"mandatory": ["left_command"], "optional": ["shift"]}
    m: list[Json] = []

    def add(code: str, modifiers: Json | None, to: list[Json]) -> None:
        source: Json = {"key_code": code}
        if modifiers:
            source["modifiers"] = modifiers
        m.append({"type": "basic", "from": source, "to": to, "conditions": ordinary})

    add("left_arrow", ctrl, key("left_arrow", "option"))
    add("right_arrow", ctrl, key("right_arrow", "option"))
    add("home", ctrl, key("up_arrow", "command"))
    add("end", ctrl, key("down_arrow", "command"))
    add("home", {"optional": ["shift"]}, key("left_arrow", "command"))
    add("end", {"optional": ["shift"]}, key("right_arrow", "command"))
    # Ctrl+Tab switches tabs as on Linux, and the Compose-position key
    # (Control here) takes over Cmd+Tab, so the two are swapped (Adam,
    # 2026-11-14). Unchecked: whether the app switcher stays open while
    # the key is held, as Karabiner may release Command after each Tab.
    add("tab", ctrl, key("tab", "control"))
    # Ctrl+Page Up / Down switch tabs, as on Linux (Adam, 2026-11-16).
    add("page_up", ctrl, key("page_up", "control"))
    add("page_down", ctrl, key("page_down", "control"))
    add("tab", {"mandatory": ["right_control"], "optional": ["shift"]}, key("tab", "command"))
    return rule("PC-style editing outside terminals, Emacs, VMs and Orca (spec 2.5)", m)


def modifier_rules() -> Json:
    """Spec 2.2 bottom-row roles."""
    any_mods = {"optional": ["any"]}
    control_apps = apps(CONTROL_APPS, paths=CONTROL_APP_PATHS)
    ordinary = apps(CONTROL_APPS, negate=True, paths=CONTROL_APP_PATHS)

    def remap(code: str, to: str, conditions: list[Json]) -> Json:
        return {
            "type": "basic",
            "from": {"key_code": code, "modifiers": any_mods},
            "to": [{"key_code": to}],
            "conditions": conditions,
        }

    # Approach A2 (spec 5.2): in every app exactly one key is Command and
    # one is Control. The Control-position key is Command in ordinary apps
    # and Control in CONTROL_APPS; the Compose-position key is the reverse.
    # Kinesis Compose keys send right Alt (keyd configs), like the MacBook's
    # right option.
    compose_keyboards = [[BUILT_IN], [device(*ADVANTAGE2, *ADVANTAGE_360)]]
    return rule(
        "Bottom row: Control position is Command and Compose position is "
        "Control, swapped in terminals, Emacs, VMs and Orca; MacBook left "
        "control is fn",
        [
            remap("left_command", "left_control", [BUILT_IN, control_apps]),
            remap("left_control", "fn", [BUILT_IN]),
            # External keyboards send Control from the Control position.
            remap("left_control", "left_command", [NOT_BUILT_IN, ordinary]),
        ]
        + [remap("right_option", "right_control", d + [ordinary]) for d in compose_keyboards]
        + [remap("right_option", "right_command", d + [control_apps]) for d in compose_keyboards]
        # The Atreus has no Compose-position key; its layer 4 Ctrl sends
        # right Control instead (.config/chrysalis/atreus.json), which
        # stays Control in ordinary apps.
        + [remap("right_control", "right_command", [device(*ATREUS), control_apps])],
    )


def characters_rule() -> Json:
    """Spec 2.3: Shift+2 types " and Shift+' types @, as on a UK PC. macOS's
    "British" layout has them the US way round, and its "British - PC"
    layout changes other keys too, so swap just these two (Adam,
    2026-11-16)."""
    shift = {"mandatory": ["shift"], "optional": ["caps_lock"]}
    return rule(
        'UK characters: Shift+2 types " and Shift+\' types @ (spec 2.3)',
        [
            {"type": "basic", "from": {"key_code": "2", "modifiers": shift}, "to": key("quote", "shift")},
            {"type": "basic", "from": {"key_code": "quote", "modifiers": shift}, "to": key("2", "shift")},
        ],
    )


def advantage_360_characters_rule() -> Json:
    """The Advantage 360 as on Linux (keyd kinesis-advantage-360.conf, US
    base with UK keys): Shift+3 types #, the key right of P (the firmware
    sends 102nd) types \\ and |, and the top right key (which sends \\)
    types £ and €. On macOS's "British" layout # is Option+3 and € is
    Option+2, sent with right Option so terminals that treat left Option as
    Meta still type them (Adam, 2026-11-16)."""
    on_360 = [device(*ADVANTAGE_360)]
    shift = {"mandatory": ["shift"], "optional": ["caps_lock"]}
    plain = {"optional": ["caps_lock"]}

    def remap(code: str, modifiers: Json, to: list[Json]) -> Json:
        return {"type": "basic", "from": {"key_code": code, "modifiers": modifiers}, "to": to, "conditions": on_360}

    return rule(
        "Advantage 360: Shift+3 types #, right of P types \\ |, top right types £ € (spec 2.3)",
        [
            remap("3", shift, key("3", "right_option")),
            remap("non_us_backslash", {"optional": ["shift", "caps_lock"]}, key("backslash")),
            remap("backslash", shift, key("2", "right_option")),
            remap("backslash", plain, key("3", "shift")),
        ],
    )


def chord(typed: tuple[str, str], to: list[Json], conditions: list[Json], options: Json | None = None) -> list[Json]:
    """Manipulators for two keys pressed together, on each keyboard: the
    built-in keyboard types some letters from other keys (spec 2.1)."""
    result = []
    for device_conditions in ([NOT_BUILT_IN], [BUILT_IN]):
        built_in = device_conditions == [BUILT_IN]
        keys = [TYPED_BY.get(t, t) if built_in else t for t in typed]
        if not built_in and not any(t in ALPHA_SHIFT or t in TYPED_BY for t in typed):
            device_conditions = []
        result.append(
            {
                "type": "basic",
                "from": {
                    "simultaneous": [{"key_code": k} for k in keys],
                    "simultaneous_options": {"key_down_order": "insensitive", **(options or {})},
                },
                "to": to,
                "conditions": conditions + device_conditions,
                # fievel's chord_timeout: short, so fast typing rarely chords.
                "parameters": {"basic.simultaneous_threshold_milliseconds": 25},
            }
        )
        if not device_conditions:
            break
    return result


MOUSE_LAYERS = [variable("mouse"), variable("mouse_lock")]
MOVE = 1536
SCROLL = 64


# Grid mode (spec 3.4, Neru's grid on Linux): Karabiner can place the
# pointer but draw nothing, so the cells are learnt, laid out like a
# numpad: u i o / j k l / m , . (Adam, 2026-11-16).
GRID_KEYS = ["u", "i", "o", "j", "k", "l", "m", "comma", "period"]
GRID_DEPTH = 3
# Relative to the focused window, which picks the monitor too, or the
# screen when no window is focused. Set to None for the whole screen.
GRID_RELATIVE_TO: str | None = "focused_window"
IN_GRID = {"type": "variable_unless", "name": "grid_level", "value": 0}


def grid_point(cells: tuple[int, ...]) -> list[Json]:
    """Pointer to the middle of the cell picked by `cells`, outermost first."""
    x = y = 0.0
    size = 1.0
    for cell in cells:
        size /= 3
        x += (cell % 3) * size
        y += (cell // 3) * size
    position: Json = {"x": f"{round((x + size / 2) * 100)}%", "y": f"{round((y + size / 2) * 100)}%"}
    if GRID_RELATIVE_TO:
        position |= {"relative_to": GRID_RELATIVE_TO, "fallback_to": "screen"}
    return [{"software_function": {"set_mouse_cursor_position": position}}]


def grid_rule() -> Json:
    """Thumb+- enters grid mode; each grid key moves the pointer to a cell
    and the next narrows within it, GRID_DEPTH levels deep (the last level
    can be re-picked). Space / ; click and leave; Return or Escape leave,
    and so does any other key, which then acts as usual."""
    from itertools import product

    leave = [set_var("grid_level", 0)]
    m: list[Json] = []
    for code, to in [
        ("spacebar", [{"pointing_button": "button1"}]),
        ("semicolon", [{"pointing_button": "button2"}]),
        ("return_or_enter", []),
        ("escape", []),
    ]:
        m += manipulators(code, to + leave, conditions=[IN_GRID])
    for level in range(1, GRID_DEPTH + 1):
        for chosen in product(range(9), repeat=level - 1):
            conditions = [variable("grid_level", level)]
            conditions += [variable(f"grid_cell{i + 1}", c) for i, c in enumerate(chosen)]
            for cell, code in enumerate(GRID_KEYS):
                to = grid_point(chosen + (cell,))
                if level < GRID_DEPTH:
                    to += [set_var(f"grid_cell{level}", cell), set_var("grid_level", level + 1)]
                m += manipulators(code, to, conditions=conditions)
    # Any other key leaves grid mode and does what it normally does (Adam,
    # 2026-11-16). This rule's output skips later rules, so the key is sent
    # as typed, from the built-in keyboard's moved letters too.
    others = PRINTABLE + ["backslash", "home", "end", "page_up", "page_down", "delete_forward"]
    for typed in dict.fromkeys(others):
        m += manipulators(typed, leave + [{"key_code": typed}], conditions=[IN_GRID], optional=["any"])
    return rule("Grid mode: Thumb+- then u i o / j k l / m , . (spec 3.4)", m)


def mouse_rule() -> Json:
    """Spec 3.4: fievel's free mouse mode, from Linux, in Karabiner, since
    fievel itself needs IT approval on the work Mac (Adam, 2026-11-16: as
    close to Linux as possible). Hold d+f, or press z while holding them
    to lock the mode until z again."""
    m: list[Json] = []
    # Home and End: , + m and n + . together, before the single keys.
    for layer in MOUSE_LAYERS:
        m += chord(("comma", "m"), key("home"), [layer])
        m += chord(("n", "period"), key("end"), [layer])
    # z unlocks if locked, else locks.
    m += manipulators("z", [set_var("mouse_lock", 0), set_var("mouse", 0)], conditions=[variable("mouse_lock")])
    m += manipulators("z", [set_var("mouse_lock", 1)], conditions=[variable("mouse")])
    layer_keys: list[tuple[str, list[Json]]] = [
        ("j", [{"mouse_key": {"x": -MOVE}}]),
        ("k", [{"mouse_key": {"y": MOVE}}]),
        ("i", [{"mouse_key": {"y": -MOVE}}]),
        ("l", [{"mouse_key": {"x": MOVE}}]),
        ("spacebar", [{"pointing_button": "button1"}]),
        ("semicolon", [{"pointing_button": "button2"}]),
        ("a", [{"mouse_key": {"speed_multiplier": 0.33}}]),
        ("s", [{"mouse_key": {"speed_multiplier": 3.0}}]),
        ("n", [{"mouse_key": {"horizontal_wheel": SCROLL}}]),
        ("m", [{"mouse_key": {"vertical_wheel": SCROLL}}]),
        ("comma", [{"mouse_key": {"vertical_wheel": -SCROLL}}]),
        ("period", [{"mouse_key": {"horizontal_wheel": -SCROLL}}]),
    ]
    for layer in MOUSE_LAYERS:
        for typed, to in layer_keys:
            m += manipulators(typed, to, conditions=[layer], optional=["any"])
    # Hold d+f: the mode lasts until either is released.
    m += chord(
        ("d", "f"),
        [set_var("mouse", 1)],
        [variable("mouse", 0), variable("mouse_lock", 0)],
        {"key_up_when": "any", "to_after_key_up": [set_var("mouse", 0)]},
    )
    return rule("Free mouse mode: hold d+f, as fievel on Linux (spec 3.4)", m)


def alpha_shift_rule() -> Json:
    manips = [
        {
            "type": "basic",
            "from": {"key_code": physical, "modifiers": {"optional": ["any"]}},
            "to": [{"key_code": typed}],
            "conditions": [BUILT_IN],
        }
        for physical, typed in ALPHA_SHIFT.items()
    ]
    return rule("MacBook keyboard: left-hand letters one column left (spec 2.1)", manips)


def check_no_clashes(manips: list[Json]) -> None:
    """Fail if two Thumb bindings claim the same keys."""
    seen: dict[str, Json] = {}
    for manip in manips:
        signature = json.dumps(
            [manip["from"], [c for c in manip["conditions"] if c.get("type", "").startswith("device")],
             [c for c in manip["conditions"] if c.get("type", "").startswith("frontmost")]],
            sort_keys=True,
        )
        assert signature not in seen, f"Thumb binding clash: {manip['from']} -> {manip['to']} and {seen[signature]['to']}"
        seen[signature] = manip


def modified_devices() -> list[Json]:
    """Make Karabiner modify the external keyboards' events. It leaves some
    devices alone by default, such as ones that also report a mouse, and
    left the Advantage 360's alone, so its Thumb key did nothing (Adam,
    2026-11-15). Device entries must match exactly, pointing device or not,
    so each ID gets both."""
    return [
        {
            "identifiers": {
                "vendor_id": vendor,
                "product_id": product,
                "is_keyboard": True,
                "is_pointing_device": pointing,
            },
            "ignore": False,
        }
        for vendor, product in ADVANTAGE2 + ADVANTAGE_360 + ATREUS + MODEL_01
        for pointing in (False, True)
    ]


def configuration() -> Json:
    bound = jumps() + window_operations() + other_bindings()
    check_no_clashes(bound)
    rules = [
        passthrough_rule(),
        thumb_trigger_rule(),
        kinesis_end_rule(),
        rule("Thumb layer: app jumps, window management, volume and more (spec 3)", bound),
        block_unbound(),
        reorganise_rule(),
        grid_rule(),
        mouse_rule(),
        control_app_rules(),
        editing_rule(),
        modifier_rules(),
        advantage_360_characters_rule(),
        characters_rule(),
        alpha_shift_rule(),
    ]
    return {
        "profiles": [
            {
                "name": "Default profile",
                "selected": True,
                # ANSI, not ISO: with ISO, macOS types § for
                # grave_accent_and_tilde (Adam, 2026-11-14: "I don't think
                # we should be using the ISO setting").
                "virtual_hid_keyboard": {"keyboard_type_v2": "ansi"},
                "complex_modifications": {"rules": rules},
                "devices": modified_devices(),
            }
        ]
    }


def render() -> str:
    # Karabiner writes 4-space JSON, so its own saves give small diffs.
    return json.dumps(configuration(), indent=4) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="exit 1 if the JSON is out of date")
    args = parser.parse_args()
    text = render()
    if args.check:
        if OUTPUT.read_text() != text:
            print(f"{OUTPUT.relative_to(REPO)} is out of date; run {Path(__file__).name}", file=sys.stderr)
            return 1
        return 0
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
