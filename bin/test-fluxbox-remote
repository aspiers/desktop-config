#!/bin/bash

# Prove lib/fluxbox_remote.py delivers every command to a Fluxbox that keeps
# stalling, where bare fluxbox-remote loses all but the last, and that
# lib/window_placement.py detects and repairs a rule whose command was lost
# (dc-yhr0).
# Runs a private Xvfb and Fluxbox with a temporary HOME, so the live session
# and its ~/.fluxbox/lastwallpaper are never touched.

set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/test-fluxbox-remote.XXXXXX")
display=:$((200 + RANDOM % 500))
pids=()

cleanup() {
    kill -CONT "${pids[@]}" 2>/dev/null || true
    kill "${pids[@]}" 2>/dev/null || true
    rm -r -- "$work"
}
trap cleanup EXIT

export HOME=$work DISPLAY=$display
unset XAUTHORITY
mkdir -p "$HOME/.fluxbox"
printf 'session.screen0.allowRemoteActions: true\n' > "$HOME/.fluxbox/init"

Xvfb "$display" -nolisten tcp -screen 0 1600x1200x24 >/dev/null 2>&1 &
pids+=($!)
for _ in $(seq 50); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.1; done
fluxbox -rc "$HOME/.fluxbox/init" -log "$work/fluxbox.log" 2>/dev/null &
fluxbox_pid=$!
pids+=("$fluxbox_pid")
for i in 1 2 3 4 5; do
    xlogo -name "w$i" -geometry 50x50+0+0 &
    pids+=($!)
done
for _ in $(seq 50); do
    [ "$(xdotool search --classname '^w[0-9]$' 2>/dev/null | wc -l)" -eq 5 ] && break
    sleep 0.1
done

python3 - "$repo/lib" "$fluxbox_pid" <<'PY'
import os
import signal
import subprocess
import sys
import threading
import time

sys.path.insert(0, sys.argv[1])
import fluxbox_remote

fluxbox = int(sys.argv[2])
done = threading.Event()


def stall():
    # Pause Fluxbox for longer than the old 100ms pacing, over and over.
    while not done.is_set():
        os.kill(fluxbox, signal.SIGSTOP)
        time.sleep(0.3)
        os.kill(fluxbox, signal.SIGCONT)
        time.sleep(0.02)


def x_of(name):
    window = subprocess.check_output(
        ['xdotool', 'search', '--classname', f'^{name}$'], text=True).split()[0]
    info = subprocess.check_output(['xwininfo', '-id', window], text=True)
    return int(info.split('Absolute upper-left X:')[1].split()[0])


staller = threading.Thread(target=stall)
staller.start()
try:
    for i in range(1, 6):
        fluxbox_remote.send(
            f'Map {{MoveTo {400 + i * 30} 300}} {{Matches (Name=w{i})}}')
finally:
    done.set()
    staller.join()
    os.kill(fluxbox, signal.SIGCONT)

time.sleep(0.5)
moved = [i for i in range(1, 6) if x_of(f'w{i}') >= 400 + i * 30]
print(f'moved {len(moved)}/5: {moved}')
assert len(moved) == 5, 'a command was lost'
print('ok - every command reached a stalling Fluxbox')

import window_placement as wp

assert wp.top_level_commands('MacroCmd {SetHead 2} {If {Matches (Stuck=no)} {Stick}}') == [
    'SetHead 2', 'If {Matches (Stuck=no)} {Stick}']
assert wp.expectation(['MacroCmd {SetHead 1} {SendToWorkspace 3}', wp.STICK]) == (
    wp.Expectation(head=1, workspace=3, stuck=True))
heads = [(0, 0, 1000, 800), (1000, 0, 500, 800)]
state = wp.WindowState(1, 1100, 10, 100, 100, 'w')
assert wp.head_of(state, heads) == 2
assert wp.problems(1, state, wp.Expectation(head=2, workspace=2), heads) == []
assert len(wp.problems(1, state, wp.Expectation(head=1, workspace=3, stuck=True), heads)) == 3
assert wp.problems(1, None, wp.Expectation(head=1), heads) == []
print('ok - rule expectations and checks')

w1 = int(subprocess.check_output(
    ['xdotool', 'search', '--classname', '^w1$'], text=True).split()[0])
assert fluxbox_remote.matching_windows('(Name=w1)') == [w1]
assert fluxbox_remote.matching_windows('(Name=nothing-matches)') == []
print('ok - Fluxbox reports which windows a pattern matches')

heads = wp.monitor_heads()
rule = 'Map {MacroCmd {SendToWorkspace 2} {MoveTo 100 100}} {Matches (Name=w2)}'
commands = ['SendToWorkspace 2', 'MoveTo 100 100']
outcome = wp.apply_rule('(Name=w2)', rule, commands, heads)
assert outcome == wp.RuleOutcome('(Name=w2)', 1, 0, ()), outcome

# Lose the rule's first send, as a busy Fluxbox used to.
real_send, dropped = fluxbox_remote.send, []
def lossy_send(command, timeout=fluxbox_remote.TIMEOUT_SECONDS):
    if command.startswith('Map') and not dropped:
        dropped.append(command)
        return
    real_send(command, timeout)
fluxbox_remote.send = lossy_send
rule = 'Map {MacroCmd {SendToWorkspace 3} {MoveTo 200 200}} {Matches (Name=w3)}'
outcome = wp.apply_rule('(Name=w3)', rule, ['SendToWorkspace 3', 'MoveTo 200 200'], heads)
assert dropped and outcome.repairs == 1 and not outcome.problems, outcome
# A move-only rule has no head or workspace to check: only repeating it
# shows the first send was lost.
dropped.clear()
rule = 'Map {MoveTo 300 300} {Matches (Name=w4)}'
outcome = wp.apply_rule('(Name=w4)', rule, ['MoveTo 300 300'], heads)
fluxbox_remote.send = real_send
assert dropped and outcome.repairs == 1 and not outcome.problems, outcome
print('ok - a lost rule is detected and repaired, and counted as a repair')

# Emacs snaps to its character grid shortly after each resize; a window that
# settles on its own must not count as a repair.
w5 = subprocess.check_output(
    ['xdotool', 'search', '--classname', '^w5$'], text=True).split()[0]
snapping = threading.Event()


def snap_to_grid():
    while not snapping.is_set():
        out = subprocess.check_output(['xdotool', 'getwindowgeometry', w5], text=True)
        width, height = map(int, out.split('Geometry:')[1].split()[0].split('x'))
        if width % 7 or height % 7:
            subprocess.call(['xdotool', 'windowsize', w5,
                             str(width - width % 7), str(height - height % 7)])
        time.sleep(0.002)


snapper = threading.Thread(target=snap_to_grid)
snapper.start()
try:
    rule = 'Map {MacroCmd {MoveTo 50 60} {ResizeTo 403 302}} {Matches (Name=w5)}'
    outcome = wp.apply_rule('(Name=w5)', rule, ['MoveTo 50 60', 'ResizeTo 403 302'], heads)
finally:
    snapping.set()
    snapper.join()
assert outcome.repairs == 0 and not outcome.problems, outcome
print('ok - a window that snaps its own size after a move is not a repair')
PY
