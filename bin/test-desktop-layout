#!/bin/bash

set -eu

repo_root=$(cd "$(dirname "$0")/.." && pwd)

python3 - "$repo_root" <<'PY'
import runpy
import subprocess
import sys
from pathlib import Path

repo = Path(sys.argv[1])
module = runpy.run_path(repo / "bin/desktop-layout")
combine = module["combine_commands"]
adapter = module["desktop_layout"]

original_screens = adapter.libdpy.get_xrandr_screen_geometries
try:
    adapter.libdpy.get_xrandr_screen_geometries = lambda use_cache=False: [{}]
    screens, layout = adapter.get_layout_params(
        ".fluxbox/layouts/celtic.yaml", screens_only=True
    )
    assert screens == []
    assert layout["screens"] == 1

    adapter.libdpy.get_xrandr_screen_geometries = lambda use_cache=False: [
        {
            "name": "eDP",
            "width": 2880,
            "height": 1920,
            "x_offset": 0,
            "y_offset": 0,
            "x_mm": 285,
            "y_mm": 190,
            "primary": False,
        },
        {
            "name": "DisplayPort-1",
            "width": 5120,
            "height": 2160,
            "x_offset": 2880,
            "y_offset": 0,
            "x_mm": 930,
            "y_mm": 400,
            "primary": True,
        },
    ]
    screens, _ = adapter.get_layout_params(
        repo / ".fluxbox/layouts/celtic+ultrawide.yaml"
    )
    assert screens[0]["right"] == "external"
finally:
    adapter.libdpy.get_xrandr_screen_geometries = original_screens

assert combine(["MoveTo 1 2"]) == "MoveTo 1 2"
assert combine(["MoveTo 1 2", "ResizeTo 3 4"]) == (
    "MacroCmd {MoveTo 1 2} {ResizeTo 3 4}"
)
assert combine([
    "MacroCmd {SetHead 1} {MoveTo 1 2}",
    "Sticky {yes}",
    "MacroCmd {ResizeTo 3 4} {Activate}",
]) == (
    "MacroCmd {SetHead 1} {MoveTo 1 2} {Sticky {yes}} "
    "{ResizeTo 3 4} {Activate}"
)

output = subprocess.check_output(
    [repo / "bin/desktop-layout", "--dump", "celtic+ultrawide"],
    text=True,
)
map_lines = [line for line in output.splitlines() if line.startswith("   Map ")]
assert len(map_lines) == 24, len(map_lines)
assert not any("MacroCmd {MacroCmd" in line for line in map_lines)
assert sum("{Matches (Name=orca)}" in line for line in map_lines) == 1
print("ok - desktop-layout batches each matcher's commands into one flat MacroCmd")
PY
