#!/bin/bash

# See .xsession-progs.d/person-adam.spiers/50-keyboard and
# .config/systemd/user/keyboard-watcher.service for how this gets run.
# (Nothing relevant in .cfg-post.d/desktop-config.)
#
# See also the other *-watcher services.
#
# Reads udevadm monitor in property mode and only re-runs keyboard
# setup for events on input devices that look like real keyboards
# (ID_INPUT_KEYBOARD=1 and not ID_INPUT_MOUSE=1). Bluetooth/USB mice
# advertising consumer-control keys would otherwise churn this every
# time they wake/sleep.

SETUP=$HOME/bin/setup-keyboard

if ! which $SETUP >&/dev/null; then
    echo "ERROR: Couldn't find $SETUP; aborting." >&2
    exit 1
fi

log=~/.log/udev-hid.log

# Property-mode monitor: each event is a block of KEY=VALUE lines
# terminated by a blank line. -s input restricts to input subsystem.
udevadm monitor -u -p -s input | tee "$log" | awk '
    /^$/ {
        if (action != "" && kbd && !mouse) {
            print action, devpath
            fflush()
        }
        action=""; devpath=""; kbd=0; mouse=0
        next
    }
    /^UDEV  \[/ {
        # Header line: "UDEV  [timestamp] ACTION   DEVPATH (subsystem)"
        action=$3
        devpath=$4
        next
    }
    /^ACTION=/      { sub("ACTION=", "", $0); action=$0; next }
    /^DEVPATH=/     { sub("DEVPATH=", "", $0); devpath=$0; next }
    /^ID_INPUT_KEYBOARD=1/ { kbd=1; next }
    /^ID_INPUT_MOUSE=1/    { mouse=1; next }
' | while read -r action devpath; do
    case "$action" in
        add|bind|change)
            logger "keyboard-watcher: $action $devpath; sleeping 1"
            sleep 1
            $SETUP
            ;;
        *)
            # remove/unbind: skip; setup will re-run on next add/bind.
            ;;
    esac
done
