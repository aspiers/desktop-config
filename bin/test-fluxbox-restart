#!/bin/zsh

set -eu

repo_root=${0:A:h:h}
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT
FLUXBOX_DESKTOP_UNIT_FILE="$tmp_dir/fluxbox-desktop-unit"
FLUXBOX_DESKTOP_LOCK_FILE="$tmp_dir/fluxbox-desktop.lock"
FLUXBOX_HEALTH_CHECK="$tmp_dir/fluxbox-health-check"
print '#!/bin/sh\nexit 0' > "$FLUXBOX_HEALTH_CHECK"
chmod +x "$FLUXBOX_HEALTH_CHECK"
FLUXBOX_RESTART_LIB_ONLY=1 source "$repo_root/bin/fluxbox-restart"

failures=0

pass () {
    print "ok - $1"
}

fail () {
    print -u2 "not ok - $1"
    failures=$((failures + 1))
}

assert_equal () {
    local description="$1"
    local expected="$2"
    local actual="$3"

    if [ "$actual" = "$expected" ]; then
        pass "$description"
    else
        fail "$description (expected '$expected', got '$actual')"
    fi
}

lock_for_display () {
    DISPLAY="$1" XDG_RUNTIME_DIR="$tmp_dir/runtime" \
        FLUXBOX_RESTART_LIB_ONLY=1 zsh -c \
        'source "$1/bin/fluxbox-restart"; print -r -- "$FLUXBOX_DESKTOP_LOCK_FILE"' \
        zsh "$repo_root"
}
assert_equal "display aliases share the Fluxbox mutation lock" \
    "$(lock_for_display :0)" "$(lock_for_display :0.0)"

mkdir -p "$tmp_dir/runtime"
print 'fluxbox-123.service' > "$tmp_dir/runtime/fluxbox-desktop-unit._0.0"
legacy_record=$(
    DISPLAY=:0.0 XDG_RUNTIME_DIR="$tmp_dir/runtime" \
        FLUXBOX_RESTART_LIB_ONLY=1 zsh -c \
        'source "$1/bin/fluxbox-restart"; read_recorded_fluxbox_unit' \
        zsh "$repo_root"
)
assert_equal "reads a pre-canonicalization display unit record" \
    'fluxbox-123.service' "$legacy_record"

if require_fluxbox_shell "$tmp_dir/missing-shell" 2>/dev/null; then
    fail "rejects a missing Fluxbox command shell"
else
    pass "rejects a missing Fluxbox command shell"
fi
mkdir "$tmp_dir/shell-directory"
if require_fluxbox_shell "$tmp_dir/shell-directory" 2>/dev/null; then
    fail "rejects a directory as the Fluxbox command shell"
else
    pass "rejects a directory as the Fluxbox command shell"
fi
fluxbox_shell=$tmp_dir/fluxbox-shell
print '#!/bin/sh' > "$fluxbox_shell"
chmod +x "$fluxbox_shell"
if require_fluxbox_shell "$fluxbox_shell"; then
    pass "accepts an executable Fluxbox command shell"
else
    fail "accepts an executable Fluxbox command shell"
fi

pgrep () {
    printf '%s\n' 123 456
}
assert_equal "renders multiple process IDs compactly" '123,456' "$(is_running fluxbox)"
pgrep () { return 1; }
if is_running fluxbox >/dev/null; then
    fail "reports an absent process as running"
else
    pass "preserves pgrep failure for an absent process"
fi

# Unit discovery requires the identity recorded by the launcher as well as a
# live Fluxbox desktop and a matching unit MainPID/cgroup. It never infers the
# desktop owner from process or unit names alone.
desktop_fluxbox_pid () { print 1234; }
systemctl () { return 0; }
unit_has_fluxbox_main_process () { return 0; }
unit_main_pid () { print 1234; }
print 'fluxbox-123.service' > "$FLUXBOX_DESKTOP_UNIT_FILE"
assert_equal "finds the recorded live desktop unit" \
    'fluxbox-123.service' "$(find_desktop_fluxbox_unit)"

desktop_fluxbox_pid () { return 1; }
assert_equal "finds the exact recorded unit during a WM-selection gap" \
    'fluxbox-123.service' "$(find_recorded_fluxbox_unit)"

rm -f "$FLUXBOX_DESKTOP_UNIT_FILE"
desktop_fluxbox_pid () { return 1; }
systemctl () {
    # This unrelated matching unit would have been selected by the old
    # name/count heuristic, but the new protocol never lists candidates.
    print 'fluxbox-999.service loaded active running Unrelated'
}
if find_desktop_fluxbox_unit >/dev/null; then
    fail "ignores a sole unrelated matching unit"
else
    assert_equal "unrelated unit is not adopted" 1 "$?"
fi

print 'not-a-safe-unit.service' > "$FLUXBOX_DESKTOP_UNIT_FILE"
desktop_fluxbox_pid () { print 1234; }
error () { :; }
if find_desktop_fluxbox_unit >/dev/null; then
    fail "rejects an invalid recorded unit name"
else
    assert_equal "invalid unit record has a distinct failure" 2 "$?"
fi

print 'fluxbox-1evil.service' > "$FLUXBOX_DESKTOP_UNIT_FILE"
if find_recorded_fluxbox_unit >/dev/null; then
    fail "rejects a near-match recorded unit name"
else
    assert_equal "near-match unit record has a distinct failure" 2 "$?"
fi

print 'fluxbox-123.service' > "$FLUXBOX_DESKTOP_UNIT_FILE"
unit_main_pid () { print 9999; }
if find_desktop_fluxbox_unit >/dev/null; then
    fail "rejects a recorded unit belonging to another Fluxbox client"
else
    assert_equal "desktop PID must match the recorded unit MainPID" 2 "$?"
fi

# A crashed transient unit remains loaded with no MainPID. That exact record is
# sufficient only while no Fluxbox process survived the crash.
mock_recorded_unit_property () {
    print "LoadState=${mock_load_state:-loaded}"
    print "ActiveState=${mock_active_state:-failed}"
    print "Job=${mock_job:-}"
    print "MainPID=${mock_main_pid:-0}"
    print "Transient=${mock_transient:-yes}"
    print "FragmentPath=${mock_fragment:-${XDG_RUNTIME_DIR:-/run/user/$UID}/systemd/transient/fluxbox-123.service}"
    print "Environment=${mock_environment:-SHELL=$fluxbox_shell}"
    print "KillMode=${mock_kill_mode:-process}"
    print "ExecStart=${mock_exec_start:-{ path=/usr/bin/fluxbox ; argv[]=/usr/bin/fluxbox -log $HOME/.log/fluxbox.log ; ignore_errors=no ; }}"
}
systemctl () { mock_recorded_unit_property "$@"; }
pgrep () { return 1; }
assert_equal "accepts the stopped exact transient unit after a crash" \
    'fluxbox-123.service' "$(find_recoverable_recorded_fluxbox_unit "$fluxbox_shell")"

mock_active_state=active
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a record whose unit is still active without its main process"
else
    pass "rejects a record whose unit is still active without its main process"
fi
unset mock_active_state

mock_job='42/start'
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a recorded unit with a queued systemd job"
else
    pass "rejects a recorded unit with a queued systemd job"
fi
unset mock_job

mock_load_state=not-found
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a stale record for an unknown unit"
else
    pass "rejects a stale record for an unknown unit"
fi
unset mock_load_state

mock_main_pid=4567
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects an inactive recorded unit which still has a MainPID"
else
    pass "rejects an inactive recorded unit which still has a MainPID"
fi
unset mock_main_pid

mock_transient=no
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a non-transient recorded unit"
else
    pass "rejects a non-transient recorded unit"
fi
unset mock_transient

mock_fragment=/tmp/fluxbox-123.service
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a recorded unit outside the user runtime directory"
else
    pass "rejects a recorded unit outside the user runtime directory"
fi
unset mock_fragment

mock_environment='SHELL=/bin/zsh'
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a recorded unit with the wrong Fluxbox command shell"
else
    pass "rejects a recorded unit with the wrong Fluxbox command shell"
fi
unset mock_environment

mock_kill_mode=control-group
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a recorded unit which could kill Fluxbox children"
else
    pass "rejects a recorded unit which could kill Fluxbox children"
fi
unset mock_kill_mode

mock_exec_start='{ path=/usr/bin/false ; argv[]=/usr/bin/false ; }'
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null; then
    fail "rejects a recorded unit with an unexpected command"
else
    pass "rejects a recorded unit with an unexpected command"
fi
unset mock_exec_start

pgrep () { print 4567; }
if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null 2>&1; then
    fail "rejects recovery while any Fluxbox process survives"
else
    pass "rejects recovery while any Fluxbox process survives"
fi
for pgrep_error in 2 3 127; do
    pgrep () { return "$pgrep_error"; }
    if find_recoverable_recorded_fluxbox_unit "$fluxbox_shell" >/dev/null 2>&1; then
        fail "rejects recovery when pgrep exits $pgrep_error"
    else
        pass "rejects recovery when pgrep exits $pgrep_error"
    fi
done
pgrep () { return 1; }

# Polling rechecks the condition after every sleep and caps the final interval
# to the remaining timeout. A unit which exits after one second therefore
# succeeds at the 1.4s poll instead of being misreported as a timeout.
typeset fake_elapsed stop_at
fake_elapsed=0
stop_at=1.0
info () { :; }
debug () { :; }
unit_main_pid () { print 1234; }
unit_is_running () {
    (( $(echo "$fake_elapsed < $stop_at" | bc -l) ))
}
sleep () {
    fake_elapsed=$(echo "$fake_elapsed + $1" | bc -l)
}
if ensure_unit_stopped fluxbox-desktop.service 3; then
    pass "rechecks a stopped unit before declaring timeout"
else
    fail "rechecks a stopped unit before declaring timeout"
fi
assert_equal "successful polling records the actual final poll" 1.4 "$fake_elapsed"

fake_elapsed=0
stop_at=99
if ensure_unit_stopped fluxbox-desktop.service 1; then
    fail "times out a unit which remains running"
else
    assert_equal "timeout uses the exact configured budget" 1.0 "$fake_elapsed"
fi

# Exercise the complete escalation path with mocks. Every signal must retain
# the captured desktop unit; an unrelated process named fluxbox has no role.
typeset -ga calls
calls=()
integer stop_checks=0
info () { :; }
debug () { :; }
ensure_unit_stopped () {
    stop_checks=$((stop_checks + 1))
    [ "$stop_checks" -ge 2 ]
}
signal_fluxbox_unit () { calls+=("signal:$1:$2"); }
ensure_fluxbox_stopped fluxbox-desktop.service
actual_calls=$(printf '%s\n' "${calls[@]}")
assert_equal "termination and escalation stay unit-scoped" \
    $'signal:fluxbox-desktop.service:TERM\nsignal:fluxbox-desktop.service:KILL' \
    "$actual_calls"

if grep -Eq 'pkill([[:space:]]+-[^[:space:]]*)*[[:space:]]+fluxbox' \
    "$repo_root/bin/fluxbox-restart"; then
    fail "contains no process-name-scoped Fluxbox kill"
else
    pass "contains no process-name-scoped Fluxbox kill"
fi

if grep -Fq -- '-E "SHELL=$fluxbox_shell"' \
    "$repo_root/bin/fluxbox-restart"; then
    pass "routes Fluxbox Exec commands through the journal wrapper"
else
    fail "routes Fluxbox Exec commands through the journal wrapper"
fi

start_marker=$tmp_dir/unsafe-second-fluxbox
stop_marker=$tmp_dir/unsafe-unit-stop
if (
    SSH_CONNECTION=
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () { return 2; }
    desktop_is_fluxbox () { return 0; }
    find_recorded_fluxbox_unit () { print fluxbox-999.service; }
    ensure_fluxbox_stopped () { touch "$stop_marker"; }
    systemd-run () { touch "$start_marker"; }
    main --require-recorded-unit --expected-xrandr-state expected-state
); then
    fail "supervised recovery rejects a recorded-unit ownership mismatch"
elif [ -e "$stop_marker" ] || [ -e "$start_marker" ]; then
    fail "supervised recovery mutated after an ownership mismatch"
else
    pass "supervised recovery rejects a recorded-unit ownership mismatch"
fi

if (
    SSH_CONNECTION=
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () { return 1; }
    find_recorded_fluxbox_unit () { return 1; }
    desktop_is_fluxbox () { return 1; }
    find_recoverable_recorded_fluxbox_unit () { return 1; }
    systemd-run () { touch "$start_marker"; }
    main --require-recorded-unit --expected-xrandr-state expected-state
); then
    fail "supervised recovery rejects an unavailable recorded unit"
elif [ -e "$start_marker" ]; then
    fail "supervised recovery started a competing Fluxbox"
else
    pass "supervised recovery rejects an unavailable recorded unit"
fi

rm -f "$start_marker"
if (
    SSH_CONNECTION=
    no_xfwm=1
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () { return 1; }
    desktop_is_fluxbox () { return 1; }
    find_recorded_fluxbox_unit () { return 1; }
    is_running () {
        [ "$1" != fluxbox ] || { print 4567; return 0; }
        return 1
    }
    systemd-run () { touch "$start_marker"; }
    main
); then
    fail "new-unit launch rejects a surviving Fluxbox process"
elif [ -e "$start_marker" ]; then
    fail "new-unit launch started a second Fluxbox process"
else
    pass "new-unit launch rejects a surviving Fluxbox process"
fi

rm -f "$start_marker" "$stop_marker"
if (
    SSH_CONNECTION=
    no_xfwm=1
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () { return 1; }
    desktop_is_fluxbox () { return 1; }
    find_recorded_fluxbox_unit () { return 1; }
    is_running () { return 1; }
    systemd-run () { touch "$start_marker"; }
    ensure_unit_started () { return 0; }
    record_desktop_fluxbox_unit () { return 1; }
    systemctl () {
        [ "$2" = stop ] || return 1
        touch "$stop_marker"
    }
    main
); then
    fail "record failure stops the new unrecorded Fluxbox unit"
elif [ ! -e "$start_marker" ] || [ ! -e "$stop_marker" ]; then
    fail "record failure left the new Fluxbox unit running"
else
    pass "record failure stops the new unrecorded Fluxbox unit"
fi

rm -f "$start_marker"
if (
    SSH_CONNECTION=
    no_xfwm=1
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () { return 1; }
    desktop_is_fluxbox () { return 1; }
    find_recorded_fluxbox_unit () { return 1; }
    is_running () { return 1; }
    systemctl () { return 0; }
    systemd-run () { return 1; }
    ensure_unit_started () { touch "$start_marker"; return 0; }
    main
); then
    fail "propagates a failed new-unit launch"
elif [ -e "$start_marker" ]; then
    fail "waited for a unit whose launch command failed"
else
    pass "propagates a failed new-unit launch"
fi

record_marker=$tmp_dir/recovered-unit-record
rm -f "$start_marker" "$record_marker"
if (
    SSH_CONNECTION=
    no_xfwm=1
    require_fluxbox_shell () { return 0; }
    find_desktop_fluxbox_unit () {
        [ -e "$record_marker" ] || return 1
        cat "$record_marker"
    }
    desktop_is_fluxbox () { return 1; }
    find_recorded_fluxbox_unit () { return 1; }
    find_recoverable_recorded_fluxbox_unit () { print fluxbox-123.service; }
    is_running () { return 1; }
    systemd-run () { touch "$start_marker"; }
    ensure_unit_started () { return 0; }
    record_desktop_fluxbox_unit () { print "$1" > "$record_marker"; }
    dismiss_panel_plugin_dialogs () { return 0; }
    sleep () { return 0; }
    main --require-recorded-unit --expected-xrandr-state expected-state
); then
    if [ -e "$start_marker" ] && [ -s "$record_marker" ]; then
        pass "supervised recovery recreates and proves a crashed Fluxbox unit"
    else
        fail "supervised recovery reported success without a recorded replacement"
    fi
else
    fail "supervised recovery recreates and proves a crashed Fluxbox unit"
fi

if [ "$failures" -ne 0 ]; then
    print -u2 "$failures test(s) failed"
    exit 1
fi

print "1..39"
