#!/usr/bin/env python3
"""Reconcile captured shadow-controller traces against monitor-watcher-ng.

For each dc-a5y.11 scenario this selects a raw capture from
~/.log/shadow-traces/, normalizes the shadow controller's decisions from its
embedded audit tail, extracts the authoritative monitor-watcher-ng journal
window covering the same wall-clock period, and reports the two policies side
by side so every difference can be fixed or justified against a named
invariant.

With --emit DIR it also writes the accepted capture as a sanitized live
fixture plus provenance sidecar, following the deterministic sanitization
procedure documented in
.local/lib/monitor-controller/tests/monitor_controller/fixtures/traces/README.md:
state objects are projected onto a fixed whitelist and every live fingerprint
value is replaced by its SHA-256 and byte length.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path

TRACE_DIR = Path.home() / ".log" / "shadow-traces"
NG_UNIT = "monitor-watcher-ng.service"

# Fixed state projection from the traces README; anything not listed is
# dropped rather than redacted, so a new state field never leaks by accident.
STATE_WHITELIST = frozenset(
    {
        "action_sequence_high_water",
        "aggressive_deadline_ms",
        "application",
        "baseline_adoption",
        "candidate",
        "controller_instance",
        "desktop_finalized_profile",
        "event_generation",
        "external_intent",
        "finalization",
        "next_timer_ms",
        "observation_generation",
        "phase",
        "physical_epoch",
        "physical_token",
        "planning",
        "planning_state",
        "preparation",
        "preparation_state",
        "probe",
        "reconcile_epoch",
        "stable_x_profile",
        "transition_sequence_high_water",
        "unknown_key",
        "unknown_since_ms",
        "unplug_proof",
        "verify_since_ms",
        "latest_observation",
    }
)

NG_PATTERNS = (
    ("reconcile_start", "Starting display reconciliation"),
    ("attempt", "Reconciliation attempt "),
    ("reload", "Reloading previously matched autorandr profile "),
    ("load", "Loading autorandr profile "),
    ("current", "already current"),
    ("deferred", "postswitch deferred"),
    ("change", "DRM change:"),
    ("settle", "Topology stable"),
    ("fallback", "fallback"),
    ("fail", "failed"),
)


@dataclass
class ShadowSummary:
    """Normalized policy outcome of one capture's audit tail."""

    decisions: int
    event_counts: dict[str, int]
    phase_counts: dict[str, int]
    effect_counts: dict[str, int]
    would_kinds: list[str]
    exact_profiles: list[str]
    final_phase: str | None
    final_timer_gap_ms: int | None
    span_ms: int


def summarize_shadow(records: list[dict]) -> ShadowSummary:
    events: dict[str, int] = {}
    phases: dict[str, int] = {}
    effects: dict[str, int] = {}
    would: list[str] = []
    exact: list[str] = []
    stamps: list[int] = []
    final_phase = None
    final_gap = None
    decisions = 0
    for record in records:
        kind = record.get("record")
        if kind == "would_dispatch":
            would.append(record.get("kind", "?"))
            continue
        if kind != "decision":
            continue
        decisions += 1
        events[record["event_type"]] = events.get(record["event_type"], 0) + 1
        state = record.get("state", {})
        phase = state.get("phase")
        phases[phase] = phases.get(phase, 0) + 1
        final_phase = phase
        for effect in record.get("effects", ()):
            name = effect.get("effect_type", "?")
            effects[name] = effects.get(name, 0) + 1
        audit = record.get("audit", {})
        if "monotonic_ms" in audit:
            stamps.append(audit["monotonic_ms"])
            if state.get("next_timer_ms") is not None:
                final_gap = state["next_timer_ms"] - audit["monotonic_ms"]
        observation = (record.get("event") or {}).get("observation") or {}
        profile = observation.get("exact_profile")
        if profile and (not exact or exact[-1] != profile):
            exact.append(profile)
    span = max(stamps) - min(stamps) if len(stamps) > 1 else 0
    return ShadowSummary(
        decisions=decisions,
        event_counts=events,
        phase_counts=phases,
        effect_counts=effects,
        would_kinds=would,
        exact_profiles=exact,
        final_phase=final_phase,
        final_timer_gap_ms=final_gap,
        span_ms=span,
    )


def ng_journal_window(since: datetime, until: datetime) -> list[str]:
    completed = subprocess.run(
        [
            "journalctl",
            "--user",
            "-u",
            NG_UNIT,
            "--since",
            since.strftime("%Y-%m-%d %H:%M:%S"),
            "--until",
            until.strftime("%Y-%m-%d %H:%M:%S"),
            "--no-pager",
            "-o",
            "short-iso",
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=60,
    )
    return [
        line
        for line in completed.stdout.splitlines()
        if line and not line.startswith("-- ")
    ]


def summarize_ng(lines: list[str]) -> dict:
    counts: dict[str, int] = {}
    profiles: list[str] = []
    interesting: list[str] = []
    for line in lines:
        for key, needle in NG_PATTERNS:
            if needle in line:
                counts[key] = counts.get(key, 0) + 1
                if key in {"reload", "load"}:
                    profile = line.split(needle, 1)[1].split()[0]
                    if not profiles or profiles[-1] != profile:
                        profiles.append(profile)
                if key not in {"attempt", "change"}:
                    interesting.append(line.split("]: ", 1)[-1])
                break
    return {
        "lines": len(lines),
        "counts": counts,
        "profiles": profiles,
        "interesting": interesting[-12:],
    }


def capture_window(data: dict, span_ms: int) -> tuple[datetime, datetime]:
    captured = datetime.fromisoformat(data["captured_at"])
    margin = timedelta(seconds=120)
    return (
        captured - timedelta(milliseconds=span_ms) - margin,
        captured + timedelta(seconds=30),
    )


def _redact_fingerprints(observation: dict) -> dict:
    result = dict(observation)
    fingerprints = []
    for item in result.get("live_fingerprints") or ():
        entry = dict(item)
        value = entry.pop("value", None)
        if isinstance(value, str):
            try:
                decoded = bytes.fromhex(value)
            except ValueError:
                decoded = value.encode("utf-8")
            entry["value_redaction"] = {
                "sha256": hashlib.sha256(decoded).hexdigest(),
                "bytes": len(decoded),
            }
        fingerprints.append(entry)
    if fingerprints:
        result["live_fingerprints"] = fingerprints
    return result


def _sanitize_state(state: dict) -> dict:
    projected = {
        key: value for key, value in state.items() if key in STATE_WHITELIST
    }
    observation = projected.get("latest_observation")
    if isinstance(observation, dict):
        projected["latest_observation"] = _redact_fingerprints(observation)
    return projected


def _sanitize_event(event: dict) -> dict:
    result = dict(event)
    observation = result.get("observation")
    if isinstance(observation, dict):
        result["observation"] = _redact_fingerprints(observation)
    return result


def sanitize_records(records: list[dict]) -> tuple[list[dict], list[dict]]:
    """Return (sanitized records, per-record source hashes)."""
    sanitized: list[dict] = []
    provenance: list[dict] = []
    for index, record in enumerate(records):
        source_line = json.dumps(record, sort_keys=True, separators=(",", ":"))
        provenance.append(
            {
                "index": index,
                "record": record.get("record", "?"),
                "source_sha256": hashlib.sha256(
                    (source_line + "\n").encode()
                ).hexdigest(),
            }
        )
        clean = dict(record)
        if record.get("record") == "header" and isinstance(
            record.get("initial_state"), dict
        ):
            clean["initial_state"] = _sanitize_state(record["initial_state"])
        if record.get("record") == "decision":
            if isinstance(record.get("state"), dict):
                clean["state"] = _sanitize_state(record["state"])
            if isinstance(record.get("event"), dict):
                clean["event"] = _sanitize_event(record["event"])
        sanitized.append(clean)
    return sanitized, provenance


def emit_fixture(
    case: str,
    capture_path: Path,
    data: dict,
    ng_lines: list[str],
    output_dir: Path,
) -> None:
    records = data.get("audit_tail") or []
    sanitized, provenance = sanitize_records(records)
    audit_path = output_dir / f"live_{case}.audit.jsonl"
    with audit_path.open("w", encoding="ascii") as stream:
        for record in sanitized:
            json.dump(
                record,
                stream,
                sort_keys=True,
                ensure_ascii=True,
                separators=(",", ":"),
            )
            stream.write("\n")
    transactions = (
        Path("/run/user/1000/monitor-controller/shadow/transactions")
    )
    evidence = {
        "case": case,
        "capture_source": str(capture_path),
        "capture_source_sha256": hashlib.sha256(
            capture_path.read_bytes()
        ).hexdigest(),
        "captured_at": data.get("captured_at"),
        "layout": data.get("layout"),
        "expected_layout": data.get("expected_layout"),
        "outputs": data.get("outputs"),
        "suspended_seconds": data.get("suspended_seconds"),
        "record_provenance": provenance,
        "shadow_transactions_directory_absent": not transactions.exists(),
        "ng_journal": {
            "unit": NG_UNIT,
            "lines": [
                {
                    "line": line,
                    "sha256": hashlib.sha256((line + "\n").encode()).hexdigest(),
                }
                for line in ng_lines
            ],
        },
        "sanitization": (
            "state whitelist projection plus live_fingerprints value "
            "hash+length redaction per fixtures/traces/README.md"
        ),
    }
    sidecar = output_dir / f"live_{case}.evidence.json"
    sidecar.write_text(
        json.dumps(evidence, indent=1, sort_keys=True, ensure_ascii=True) + "\n",
        encoding="ascii",
    )
    print(f"  emitted {audit_path.name} + {sidecar.name}")


def report(case: str, capture_path: Path) -> dict:
    data = json.loads(capture_path.read_text())
    records = data.get("audit_tail") or []
    shadow = summarize_shadow(records)
    since, until = capture_window(data, shadow.span_ms)
    ng_lines = ng_journal_window(since, until)
    ng = summarize_ng(ng_lines)
    print(f"== {case}: {capture_path.name}")
    print(
        f"  shadow: {shadow.decisions} decisions over {shadow.span_ms}ms | "
        f"events {shadow.event_counts} | final phase {shadow.final_phase} "
        f"(next timer +{shadow.final_timer_gap_ms}ms)"
    )
    print(
        f"  shadow: effects {shadow.effect_counts} | would {shadow.would_kinds} "
        f"| exact profiles {shadow.exact_profiles}"
    )
    print(
        f"  ng: {ng['lines']} journal lines in window | counts {ng['counts']} "
        f"| profiles {ng['profiles']}"
    )
    for line in ng["interesting"]:
        print(f"    ng| {line}")
    return {
        "case": case,
        "capture": str(capture_path),
        "data": data,
        "shadow": shadow,
        "ng": ng,
        "ng_lines": ng_lines,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("captures", nargs="*", help="case=capture-path pairs")
    parser.add_argument("--emit", type=Path, help="write sanitized fixtures here")
    args = parser.parse_args()
    if not args.captures:
        parser.error("expected case=capture-path arguments")
    for pair in args.captures:
        case, _, path_value = pair.partition("=")
        capture_path = Path(path_value)
        if not capture_path.is_file():
            print(f"missing capture: {capture_path}", file=sys.stderr)
            return 1
        result = report(case, capture_path)
        if args.emit:
            args.emit.mkdir(parents=True, exist_ok=True)
            emit_fixture(
                case,
                capture_path,
                result["data"],
                result["ng_lines"],
                args.emit,
            )
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
