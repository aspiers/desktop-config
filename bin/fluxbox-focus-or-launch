#!/bin/bash
#
# Downsides of using this:
#
# - There's no way to reliably tell whether a program is minimized
#   vs. not running.

me=$(basename "$0")

CONFIG_DIR="$HOME/.config/fluxbox-focus-or-launch"
DESKTOP_FILE="$CONFIG_DIR/previous-desktop.txt"

usage () {
    # Call as: usage [EXITCODE] [USAGE MESSAGE]
    exit_code=1
    if [[ "$1" == [0-9] ]]; then
        exit_code="$1"
        shift
    fi

    me=$(basename "$0")

    cat <<EOF >&2
Usage: $me [OPTIONS] WINDOW-PATTERN LAUNCH-CMD
Options:
  -h, --help     Show this help and exit
  -c, --class    Match WINDOW-PATTERN against class rather than title
  -r, --role     Match WINDOW-PATTERN against role rather than title
  -i, --instance Match WINDOW-PATTERN against instance (WM_CLASS name),
                 e.g. crx_<app-id> for a Chrome app
  -t, --toggle   If a matching window is focused, hide it and show the next
                 matching one, or none after the last; otherwise focus/launch
  -f, --focus    Focus the window after launching (if launched)
  -n, --no-stick In toggle mode, don't make the shown window sticky

WINDOW-PATTERN is a regexp matching the window title, class, role or instance.
LAUNCH-CMD is a command for launching the program if it's not found.
EOF

    if [ -n "$1" ]; then
        echo >&2
        echo >&2 "$*"
    fi

    exit "$exit_code"
}

main () {
    if [ "$1" == '-h' ] || [ "$1" == '--help' ]; then
        usage 0
    fi

    while [[ "$1" =~ ^- ]]; do
        case "$1" in
            -c|--class)
                class=y
                shift
                ;;
            -r|--role)
                role=y
                shift
                ;;
            -i|--instance)
                instance=y
                shift
                ;;
            -t|--toggle)
                toggle=y
                shift
                ;;
            -f|--focus)
                focus_after_launch=y
                shift
                ;;
            -n|--no-stick)
                no_stick=y
                shift
                ;;
            *)
                usage 1 "Unknown option: $1"
                ;;
        esac
    done

    if [ $# -lt 2 ]; then
        usage 1
    fi

    window_pattern="$1"
    shift

    # In toggle mode, each press hides the focused match and shows the
    # next one, so repeated presses cycle through all matches then none.
    if [ -n "$toggle" ] && window_is_focused; then
        local next
        next=$(next_matching_window "$(xdotool getactivewindow)")
        if [ -z "$next" ]; then
            hide_window
            restore_previous_desktop
            exit 0
        fi
        # One fluxbox-remote call, not hide then fetch: back-to-back calls
        # can drop the first, leaving the next window on the hiding workspace.
        fetch_window "$(xdotool get_desktop)" Minimize
        show_window "$next"
        exit 0
    fi

    # In toggle mode, store current desktop before focusing/launching
    if [ -n "$toggle" ]; then
        store_current_desktop
        # First try to fetch window from other workspaces if it exists
        fetch_window "$(xdotool get_desktop)"
        # Start each cycle from the first match, not the last one focused.
        first=$(matching_windows | head -n 1)
        [ -z "$first" ] || show_window "$first"
    else
        focus_window
    fi

    sleep 0.2
    exit_if_window_focused

    # Exec seems to have been disabled from fluxbox-remote, presumably
    # for the security reasons mentioned in the fluxbox-remote(1) man
    # page.  So we have to launch programs ourselves.
    echo "Launching $* ..."
    # Start through the user manager so the application gets a fresh journal
    # stream labelled with its own executable rather than this helper.
    run-with-new-privs "$@"

    if [ -n "$focus_after_launch" ]; then
        # N.B. this can steal focus unexpectedly if launching takes
        # a while and the user carries on doing other stuff while
        # waiting
        wait_until_window_focused
    fi
}

store_current_desktop () {
    # Create config directory if it doesn't exist
    mkdir -p "$CONFIG_DIR"

    # Get current desktop/workspace number
    local current_desktop
    current_desktop=$(xdotool get_desktop)
    echo "$current_desktop" > "$DESKTOP_FILE"
    echo "Stored current desktop: $current_desktop"
}

restore_previous_desktop () {
    if [ -f "$DESKTOP_FILE" ]; then
        local previous_desktop
        previous_desktop=$(cat "$DESKTOP_FILE")
        echo "Restoring previous desktop: $previous_desktop"
        xdotool set_desktop "$previous_desktop"
        rm "$DESKTOP_FILE"
    fi
}

get_active_window_attribute () {
    local active_window
    active_window=$(xdotool getactivewindow 2>/dev/null) || return
    get_window_attribute "$active_window"
}

get_window_attribute () {
    local window="$1"
    if [ -n "$class" ]; then
        xdotool getwindowclassname "$window" 2>/dev/null
    elif [ -n "$role" ]; then
        # For role, we need to use xprop to get the WM_WINDOW_ROLE property
        xprop -id "$window" WM_WINDOW_ROLE 2>/dev/null | sed -n 's/.*= "\(.*\)"/\1/p'
    elif [ -n "$instance" ]; then
        xprop -id "$window" WM_CLASS 2>/dev/null | sed -n 's/.*= "\([^"]*\)".*/\1/p'
    else
        xdotool getwindowname "$window" 2>/dev/null
    fi
}

# Print the decimal IDs of managed windows matching the pattern, sorted
# by ID so the cycle order stays the same however focus moves.
matching_windows () {
    local window
    for window in $(xprop -root _NET_CLIENT_LIST | sed 's/.*#//; s/,/ /g'); do
        window=$(( window ))
        [[ "$(get_window_attribute "$window")" =~ $window_pattern ]] && echo "$window"
    done | sort -n
}

next_matching_window () {
    matching_windows | awk -v current="$1" 'found { print; exit } $0 == current { found = 1 }'
}

window_is_focused () {
    local window_attribute="${1:-$(get_active_window_attribute)}"
    [[ "$window_attribute" =~ $window_pattern ]]
}

get_fluxbox_pattern () {
    if [ -n "$class" ]; then
        echo "(Class=$window_pattern)"
    elif [ -n "$role" ]; then
        echo "(Role=$window_pattern)"
    elif [ -n "$instance" ]; then
        echo "(Name=$window_pattern)"
    else
        echo "(Title=$window_pattern)"
    fi
}

# Usage: fetch_window DESKTOP [COMMAND-TO-RUN-FIRST-ON-EACH-MATCH]
fetch_window () {
    local fluxbox_pattern
    fluxbox_pattern=$(get_fluxbox_pattern)
    echo "Fetching window matching $fluxbox_pattern to workspace $1..."
    cmd="TakeToWorkspace $(( $1 + 1 ))"
    [ -n "$no_stick" ] || cmd="MacroCmd {$cmd} {If {Matches (Stuck=no)} {Stick}}"
    [ -z "${2:-}" ] || cmd="MacroCmd {$2} {$cmd}"
    fluxbox-remote "ForEach {$cmd} {Matches $fluxbox_pattern}"
}

hide_window () {
    local fluxbox_pattern
    fluxbox_pattern=$(get_fluxbox_pattern)
    echo "Hiding window matching $fluxbox_pattern..."
    # Minimize before leaving the workspace: the other order leaves Chrome
    # apps without keyboard focus in the page when shown again.
    cmd="MacroCmd {If {Matches (Stuck=yes)} {Stick}} {Minimize} {SendToWorkspace 6}"
    fluxbox-remote "ForEach {$cmd} {Matches $fluxbox_pattern}"
}

show_window () {
    echo "Activating window $1"
    xdotool windowactivate "$1"
}

focus_window () {
    local fluxbox_pattern
    fluxbox_pattern=$(get_fluxbox_pattern)
    echo "NextWindow $fluxbox_pattern"
    fluxbox-remote "NextWindow $fluxbox_pattern"
    sleep 0.1
    # {If {Matches $focus} {Exec focus-active-window}"
}

exit_if_window_focused () {
    local window_attribute
    window_attribute="$(get_active_window_attribute)"

    if window_is_focused "$window_attribute"; then
        echo "Focused window '$window_attribute' matches '$window_pattern'"
        exit 0
    fi
    echo "Focused window '$window_attribute' doesn't match '$window_pattern'"
}

wait_until_window_focused () {
    sleep=0.1
    while (( $(echo "$sleep < 30" | bc) )); do
        echo "Sleeping $sleep ..."
        sleep "$sleep"
        focus_window
        exit_if_window_focused
        sleep=$(echo "$sleep * 2" | bc)
    done
}

main "$@"
