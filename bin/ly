#!/bin/bash

if [ "$1" = --debug ]; then
    shift
    exec >  >(tee -ia ~/.log/ly.log)
    exec 2> >(tee -ia ~/.log/ly.log >&2)
fi

if [ "${1:-}" = --resolved-actions ]; then
    [ "$#" -eq 2 ] || {
        echo "Usage: ly [--debug] --resolved-actions FILE" >&2
        exit 2
    }
    # The controller discards leaf output and fluxbox-remote exits 0 whether
    # or not Fluxbox acted, so keep our own record of each placement (dc-yhr0).
    capture=$(window-layout-capture start 2>/dev/null) || capture=/dev/null
    window-layout-capture snapshot before "$capture" 2>/dev/null
    desktop-layout --resolved-actions "$2" 2>&1 | tee -a "$capture"
    status=${PIPESTATUS[0]}
    window-layout-capture snapshot after "$capture" 2>/dev/null
    window-layout-capture later "$capture" 2>/dev/null
    exit "$status"
fi

# Legacy interactive callers retain layout discovery. The monitor controller
# always uses --resolved-actions so finalization consumes only its hashed plan.
# ZDOTDIR is the deployed home/config root, which static analysis cannot resolve.
# shellcheck disable=SC1091
. "$ZDOTDIR/lib/libhost.sh"
read_localhost_nickname

if layout="$(get-layout)"; then
    desktop-layout "$@" "$layout"
else
    exit 1
fi
