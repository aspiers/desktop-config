#!/bin/bash

# Harmless tests for setup-monitor's Fluxbox restart safety checks.

set -u

repo=$(cd "$(dirname "$0")/.." && pwd)
setup_monitor=$repo/bin/setup-monitor
failures=0

run_test() {
    local name=$1
    shift
    if "$@"; then
        printf 'ok - %s\n' "$name"
    else
        printf 'not ok - %s\n' "$name" >&2
        failures=$((failures + 1))
    fi
}

prepare_case() {
    local root=$1

    mkdir -p "$root/home/lib" "$root/state"
    cat > "$root/home/lib/libhost.sh" <<'EOF'
read_localhost_nickname() { localhost_nickname=test-host; }
EOF
}

run_case() (
    local actual_geometry=$1
    local response=$2
    local root

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"

    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    export SETUP_MONITOR_FLUXBOX_TEST_MODE=1
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    layout=celtic+ultrawide
    STUB_ACTUAL_GEOMETRY=$actual_geometry
    STUB_RESPONSE=$response
    FR_LOG=$root/fr.log

    xrandr() {
        case "$*" in
            *--current*)
                printf '%s\n' \
                    'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
                    'eDP connected 2880x1920+0+0' \
                    'DisplayPort-1 connected primary 5120x2160+2880+0'
                ;;
            *--query*)
                printf '%s\n' \
                    'eDP connected 2880x1920+0+0' \
                    'DisplayPort-1 connected primary 5120x2160+2880+0'
                ;;
        esac
    }
    xprop() {
        if [[ $* == *-remove* ]]; then
            return 0
        fi
        printf '_NET_DESKTOP_GEOMETRY(CARDINAL) = %s\n' \
            "${STUB_ACTUAL_GEOMETRY/x/, }"
    }
    fluxbox-remote() {
        if [ "${1:-}" = result ] && [ "$STUB_RESPONSE" != none ]; then
            printf '%s\n' "$STUB_RESPONSE"
        fi
    }
    pgrep() { printf '4242\n'; }
    fr() { printf 'called\n' >> "$FR_LOG"; }
    sleep() { :; }

    run_fluxbox_restart_test >/dev/null

    capture=$(find "$HOME/.log/setup-monitor-fluxbox-test" -name '*.txt' -print -quit)
    [ -n "$capture" ] || return

    case "$actual_geometry:$response" in
        8000x2160:0)
            [ ! -e "$FR_LOG" ] &&
                grep -qx 'result=success' "$capture" &&
                grep -qx 'fallback_reason=' "$capture"
            ;;
        7999x2160:0)
            [ "$(cat "$FR_LOG")" = called ] &&
                grep -qx 'result=fallback' "$capture" &&
                grep -qx 'fallback_reason=geometry_mismatch' "$capture"
            ;;
        8000x2160:none|8000x2160:unexpected)
            [ "$(cat "$FR_LOG")" = called ] &&
                grep -qx 'result=fallback' "$capture" &&
                grep -qx 'fallback_reason=fluxbox_unresponsive' "$capture"
            ;;
        *)
            return 1
            ;;
    esac
)

test_success_skips_restart() {
    run_case 8000x2160 0
}

test_geometry_mismatch_restarts() {
    run_case 7999x2160 0
}

test_unresponsive_fluxbox_restarts() {
    run_case 8000x2160 none
}

test_unexpected_response_restarts() {
    run_case 8000x2160 unexpected
}

test_capture_retention_and_progress() (
    local root capture_dir index output

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    export SETUP_MONITOR_FLUXBOX_TEST_MODE=1
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    capture_dir=$HOME/.log/setup-monitor-fluxbox-test
    mkdir -p "$capture_dir" "$XDG_STATE_HOME/setup-monitor"
    for index in $(seq 1 205); do
        printf 'result=success\ntransition=other\n' > "$capture_dir/$index.txt"
        touch -d "@$index" "$capture_dir/$index.txt"
    done
    printf 'layout=celtic\nactive_outputs=1\n' \
        > "$XDG_STATE_HOME/setup-monitor/fluxbox-test-last-layout"

    layout=celtic+ultrawide
    fluxbox_expected_geometry=8000x2160
    fluxbox_actual_geometry=8000x2160
    fluxbox_verified_outputs=2
    xrandr() {
        printf '%s\n' \
            'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
            'eDP connected 2880x1920+0+0' \
            'DisplayPort-1 connected primary 5120x2160+2880+0'
    }

    output=$(record_fluxbox_test_result success '' 4242 4242 3)

    [ "$(find "$capture_dir" -name '*.txt' | wc -l)" -eq 200 ] &&
        grep -q 'dock 1/2' <<< "$output" &&
        grep -q 'outstanding dock=1 undock=2' <<< "$output" &&
        find "$capture_dir" -name '*.txt' -exec grep -l '^transition=dock$' {} + |
            grep -q .
)

test_failed_topology_does_not_change_baseline() (
    local root capture state_file

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    state_file=$XDG_STATE_HOME/setup-monitor/fluxbox-test-last-layout
    mkdir -p "$(dirname "$state_file")"
    printf 'layout=celtic\nactive_outputs=1\n' > "$state_file"
    layout=unknown
    fluxbox_expected_geometry=8000x2160
    fluxbox_actual_geometry=8000x2160
    xrandr() { return 1; }

    record_fluxbox_test_result success '' 4242 4242 2 >/dev/null
    capture=$(find "$HOME/.log/setup-monitor-fluxbox-test" -name '*.txt' -print -quit)

    grep -qx 'transition=unknown' "$capture" &&
        grep -qx 'active_outputs=unknown' "$capture" &&
        [ "$(cat "$state_file")" = $'layout=celtic\nactive_outputs=1' ]
)

test_capture_lock_serializes_transitions() (
    local root capture_dir state_file dock_count other_count

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    capture_dir=$HOME/.log/setup-monitor-fluxbox-test
    state_file=$XDG_STATE_HOME/setup-monitor/fluxbox-test-last-layout
    mkdir -p "$capture_dir" "$(dirname "$state_file")"
    printf 'layout=celtic\nactive_outputs=1\n' > "$state_file"
    layout=celtic+ultrawide
    fluxbox_expected_geometry=8000x2160
    fluxbox_actual_geometry=8000x2160
    fluxbox_verified_outputs=2
    xrandr() {
        printf '%s\n' \
            'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
            'eDP connected 2880x1920+0+0' \
            'DisplayPort-1 connected primary 5120x2160+2880+0'
    }

    record_fluxbox_test_result success '' 4242 4242 2 >/dev/null &
    first=$!
    record_fluxbox_test_result success '' 4242 4242 2 >/dev/null &
    second=$!
    wait "$first" "$second"

    dock_count=$(grep -l '^transition=dock$' "$capture_dir"/*.txt | wc -l)
    other_count=$(grep -l '^transition=other$' "$capture_dir"/*.txt | wc -l)
    [ "$(find "$capture_dir" -name '*.txt' | wc -l)" -eq 2 ] &&
        [ "$dock_count" -eq 1 ] &&
        [ "$other_count" -eq 1 ]
)

test_prune_failure_skips_capture() (
    local root state_file

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    state_file=$XDG_STATE_HOME/setup-monitor/fluxbox-test-last-layout
    mkdir -p "$(dirname "$state_file")"
    printf 'layout=celtic\nactive_outputs=1\n' > "$state_file"
    layout=celtic+ultrawide
    fluxbox_expected_geometry=8000x2160
    fluxbox_actual_geometry=8000x2160
    fluxbox_verified_outputs=1
    xrandr() {
        printf '%s\n' \
            'Screen 0: minimum 320 x 200, current 2880 x 1920, maximum 16384 x 16384' \
            'eDP connected 2880x1920+0+0'
    }
    find() { return 1; }

    record_fluxbox_test_result success '' 4242 4242 2 >/dev/null

    [ "$(/usr/bin/find "$HOME/.log/setup-monitor-fluxbox-test" -name '*.txt' | wc -l)" -eq 0 ] &&
        [ "$(cat "$state_file")" = $'layout=celtic\nactive_outputs=1' ]
)

test_geometry_command_failures_are_not_accepted() (
    local root

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    xrandr() {
        printf '%s\n' \
            'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
            'eDP connected 2880x1920+0+0'
        return 1
    }
    if xrandr_state >/dev/null; then
        return 1
    fi

    xprop() {
        printf '_NET_DESKTOP_GEOMETRY(CARDINAL) = 8000, 2160\n'
        return 1
    }
    ! fluxbox_desktop_geometry >/dev/null
)

test_probe_round_trips_are_serialized() (
    local root log first second

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"
    log=$root/probes

    xprop() { :; }
    fluxbox-remote() {
        if [ "${1:-}" = result ]; then
            printf '0\n'
        else
            printf 'start %s\n' "$BASHPID" >> "$log"
            /bin/sleep 0.1
            printf 'end %s\n' "$BASHPID" >> "$log"
        fi
    }

    fluxbox_responds &
    first=$!
    fluxbox_responds &
    second=$!
    wait "$first" "$second"

    awk '
        /^start / {
            if (active)
                exit 1
            active = $2
        }
        /^end / {
            if (!active || active != $2)
                exit 1
            active = 0
        }
        END { exit active != 0 }
    ' "$log" && [ "$(wc -l < "$log")" -eq 4 ]
)

test_topology_change_after_check_restarts() (
    local root counter capture

    root=$(mktemp -d)
    trap 'rm -rf "${root:-}"' EXIT
    prepare_case "$root"
    export HOME=$root/home
    export XDG_STATE_HOME=$root/state
    export SETUP_MONITOR_FLUXBOX_TEST_MODE=1
    # shellcheck source=bin/setup-monitor
    source "$setup_monitor"

    counter=$root/xrandr-calls
    printf '0\n' > "$counter"
    layout=celtic+ultrawide
    FR_LOG=$root/fr.log
    xrandr() {
        local call
        call=$(cat "$counter")
        call=$((call + 1))
        printf '%s\n' "$call" > "$counter"
        if [ "$call" -lt 3 ]; then
            printf '%s\n' \
                'Screen 0: minimum 320 x 200, current 8000 x 2160, maximum 16384 x 16384' \
                'eDP connected 2880x1920+0+0' \
                'DisplayPort-1 connected primary 5120x2160+2880+0'
        else
            printf '%s\n' \
                'Screen 0: minimum 320 x 200, current 2880 x 1920, maximum 16384 x 16384' \
                'eDP connected 2880x1920+0+0'
        fi
    }
    xprop() {
        if [[ $* == *-remove* ]]; then
            return 0
        fi
        printf '_NET_DESKTOP_GEOMETRY(CARDINAL) = 8000, 2160\n'
    }
    fluxbox-remote() {
        [ "${1:-}" != result ] || printf '0\n'
    }
    pgrep() { printf '4242\n'; }
    fr() { printf 'called\n' >> "$FR_LOG"; }
    sleep() { :; }

    run_fluxbox_restart_test >/dev/null
    capture=$(find "$HOME/.log/setup-monitor-fluxbox-test" -name '*.txt' -print -quit)

    [ "$(cat "$FR_LOG")" = called ] &&
        grep -qx 'result=fallback' "$capture" &&
        grep -qx 'fallback_reason=xrandr_changed_after_check' "$capture"
)

run_test 'healthy Fluxbox skips restart' test_success_skips_restart
run_test 'geometry mismatch restarts Fluxbox' test_geometry_mismatch_restarts
run_test 'unresponsive Fluxbox restarts automatically' test_unresponsive_fluxbox_restarts
run_test 'unexpected Fluxbox response restarts automatically' \
    test_unexpected_response_restarts
run_test 'captures stay bounded and report outstanding events' \
    test_capture_retention_and_progress
run_test 'failed topology reads do not change evidence baseline' \
    test_failed_topology_does_not_change_baseline
run_test 'capture lock serializes overlapping relayouts' \
    test_capture_lock_serializes_transitions
run_test 'pruning failure skips capture safely' test_prune_failure_skips_capture
run_test 'nonzero geometry commands are rejected' \
    test_geometry_command_failures_are_not_accepted
run_test 'Fluxbox response probes are serialized' \
    test_probe_round_trips_are_serialized
run_test 'topology change after check triggers restart' \
    test_topology_change_after_check_restarts

exit "$failures"
