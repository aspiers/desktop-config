#!/bin/bash

# Functions sourced from monitor-watcher-ng deliberately call the test doubles
# below; ShellCheck cannot see those dynamic references.
# shellcheck disable=SC2034,SC2317

set -u

watcher=$(cd "$(dirname "$0")" && pwd)/monitor-watcher-ng
repo=$(cd "$(dirname "$0")/.." && pwd)
postswitch=$repo/.config/autorandr/postswitch
failure_fixture=$repo/specs/fixtures/monitor-watcher/samsung-invalid-extension-20260818.fingerprint
failures=0

run_test () {
    local name=$1
    shift

    if ("$@"); then
        printf 'ok - %s\n' "$name"
    else
        printf 'not ok - %s\n' "$name" >&2
        failures=$((failures + 1))
    fi
}

prepare_watcher () {
    local tmp=$1

    # shellcheck disable=SC1090
    source "$watcher"
    runtime_dir=$tmp/runtime
    pending_profile_file=$runtime_dir/pending
    output_mapping_file=$runtime_dir/output-mappings
    RECONCILE_TIMEOUT_SECONDS=999
    MAX_RECONCILE_ATTEMPTS=5
    PROFILE_STABILITY_SECONDS=0
    mkdir -p "$runtime_dir"

    read_drm_event () { return 1; }
    wait_before_retry () { return 0; }
    profile_matches_connected_outputs () { return 0; }
    profile_matches_active_outputs () { return 0; }
    connected_external_present () { return 1; }
    profile_live_edids_ready () { return 0; }
    find_activation_probe_candidate () { return 1; }
    run_activation_probe () { return 1; }
}

install_celtic_to_samsung_doubles () {
    wait_for_quiescence () { return 0; }
    get_detected_profiles () {
        [[ $attempts -eq 1 ]] && printf '%s\n' celtic || printf '%s\n' samsung
    }
    get_current_profiles () {
        [[ $attempts -eq 1 ]] && printf '%s\n' celtic || printf '%s\n' samsung
    }
    profile_outputs_connected () { [[ $1 == samsung ]]; }
    profile_matches_connected_outputs () { [[ $1 == samsung ]]; }
    profile_matches_active_outputs () { [[ $1 == samsung ]]; }
    finalize_postswitch () {
        finalizations=$((finalizations + 1))
        finalized_profile=$1
    }
}

test_event_during_apply_is_retried () {
    local tmp attempts finalizations finalized_profile
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    finalized_profile=""
    prepare_watcher "$tmp"

    apply_profile () {
        attempts=$((attempts + 1))
        printf '%s\n' samsung > "$pending_profile_file"
    }
    wait_for_quiescence () {
        [[ $attempts -gt 1 ]]
    }
    get_detected_profiles () { printf '%s\n' samsung; }
    get_current_profiles () { printf '%s\n' samsung; }
    finalize_postswitch () {
        finalizations=$((finalizations + 1))
        finalized_profile=$1
    }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == samsung ]]
}

test_detected_but_not_current_is_retried () {
    local tmp attempts finalizations
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    prepare_watcher "$tmp"

    apply_profile () {
        attempts=$((attempts + 1))
        printf '%s\n' samsung > "$pending_profile_file"
    }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () { printf '%s\n' samsung; }
    get_current_profiles () {
        [[ $attempts -gt 1 ]] && printf '%s\n' samsung
    }
    finalize_postswitch () { finalizations=$((finalizations + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $finalizations -eq 1 ]]
}

test_already_current_skips_relayout () {
    local tmp attempts finalizations
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    prepare_watcher "$tmp"
    LAST_CONVERGED_PROFILE=celtic

    apply_profile () { attempts=$((attempts + 1)); }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () { printf '%s\n' celtic; }
    get_current_profiles () { printf '%s\n' celtic; }
    finalize_postswitch () { finalizations=$((finalizations + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 1 ]] &&
        [[ $finalizations -eq 0 ]]
}

test_previously_matched_profile_is_explicitly_retried () {
    local tmp attempts finalizations retry_arg
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    retry_arg="unset"
    prepare_watcher "$tmp"

    apply_profile () {
        attempts=$((attempts + 1))
        retry_arg=${1:-}
        printf '%s\n' samsung > "$pending_profile_file"
    }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () {
        [[ $attempts -eq 1 ]] && printf '%s\n' samsung
        return 0
    }
    get_current_profiles () {
        [[ $attempts -gt 1 ]] && printf '%s\n' samsung
        return 0
    }
    profile_outputs_connected () { return 0; }
    finalize_postswitch () { finalizations=$((finalizations + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $retry_arg == samsung ]] &&
        [[ $finalizations -eq 1 ]]
}

test_transient_fallback_preserves_external_profile () {
    local tmp attempts finalizations finalized_profile applied stability_reads
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    finalized_profile=""
    applied=""
    stability_reads=0
    prepare_watcher "$tmp"
    LAST_CONVERGED_PROFILE=celtic
    PROFILE_STABILITY_SECONDS=2
    PROFILE_STABILITY_POLL_SECONDS=1

    apply_profile () {
        attempts=$((attempts + 1))
        applied=${applied:+$applied,}${1:-change}
        if [[ $attempts -eq 1 ]]; then
            printf '%s\n' samsung > "$pending_profile_file"
        else
            # Simulate autorandr briefly loading the internal-only profile and
            # its hook attempting to replace the earlier Samsung marker.
            printf '%s\n' celtic > "$pending_profile_file"
        fi
    }
    install_celtic_to_samsung_doubles
    read_drm_event () { stability_reads=$((stability_reads + 1)); return 1; }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $applied == change,samsung ]] &&
        [[ $stability_reads -eq 6 ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == samsung ]]
}

test_genuine_unplug_replaces_pending_external_profile () {
    local tmp attempts finalizations finalized_profile retry_arg stability_reads
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    finalized_profile=""
    retry_arg=""
    stability_reads=0
    prepare_watcher "$tmp"
    LAST_CONVERGED_PROFILE=samsung
    PROFILE_STABILITY_SECONDS=2
    PROFILE_STABILITY_POLL_SECONDS=1
    printf '%s\n' samsung > "$pending_profile_file"

    apply_profile () {
        attempts=$((attempts + 1))
        retry_arg=${1:-}
        printf '%s\n' celtic > "$pending_profile_file"
    }
    wait_for_quiescence () { return 0; }
    read_drm_event () { stability_reads=$((stability_reads + 1)); return 1; }
    get_detected_profiles () { printf '%s\n' celtic; }
    get_current_profiles () { printf '%s\n' celtic; }
    profile_outputs_connected () { return 1; }
    profile_matches_connected_outputs () { [[ $1 == celtic ]]; }
    finalize_postswitch () {
        finalizations=$((finalizations + 1))
        finalized_profile=$1
    }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 1 ]] &&
        [[ -z $retry_arg ]] &&
        [[ $stability_reads -eq 5 ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == celtic ]]
}

test_internal_marker_can_expand_without_another_event () {
    local tmp attempts finalizations finalized_profile applied
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    finalized_profile=""
    applied=""
    prepare_watcher "$tmp"
    LAST_CONVERGED_PROFILE=celtic

    apply_profile () {
        attempts=$((attempts + 1))
        applied=${applied:+$applied,}${1:-change}
        if [[ $attempts -eq 1 ]]; then
            printf '%s\n' celtic > "$pending_profile_file"
        else
            printf '%s\n' samsung > "$pending_profile_file"
        fi
    }
    install_celtic_to_samsung_doubles
    # This test isolates deferred-marker replacement; both synthetic markers
    # are considered connected-topology matches here.
    profile_matches_connected_outputs () { return 0; }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $applied == change,celtic ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == samsung ]]
}

test_activation_probe_requires_unique_valid_base_identity () {
    local tmp zeros valid_base invalid_base xrandr_output fingerprint_output detected_output
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    mkdir -p "$tmp/home/.config/autorandr/samsung" \
             "$tmp/home/.config/autorandr/other" "$tmp/runtime"
    printf -v zeros '%0238d' 0
    valid_base="00ffffffffffff00${zeros}06"
    invalid_base="00ffffffffffff00${zeros}07"
    printf '%s\n' "DisplayPort-1 ${valid_base}abcd" 'eDP internal' \
        > "$tmp/home/.config/autorandr/samsung/setup"
    HOME=$tmp/home
    runtime_dir=$tmp/runtime
    output_mapping_file=$runtime_dir/output-mappings
    xrandr_output='eDP connected primary 2880x1920+0+0
DisplayPort-1 connected
   3440x1440     59.97 +'
    fingerprint_output="DisplayPort-1 ${valid_base}abcd"
    detected_output=""

    xrandr () { printf '%s\n' "$xrandr_output"; }
    autorandr () { printf '%s\n' "$fingerprint_output"; }
    get_detected_profiles () { printf '%s\n' "$detected_output"; }
    profile_matches_connected_outputs () { return 0; }
    get_drm_edid_for_output () { printf '%s\n' "${fingerprint_output#* }"; }

    [[ $(find_activation_probe_candidate) == 'samsung DisplayPort-1 eDP 3440x1440' ]] || return 1

    xrandr_output='eDP connected primary 2880x1920+0+0
DisplayPort-1 connected
   3440x1440     59.97'
    ! find_activation_probe_candidate || return 1

    xrandr_output='eDP connected primary 2880x1920+0+0
DisplayPort-1 connected
   3440x1440     59.97 +
DisplayPort-2 connected 1920x1080+6320+0'
    ! find_activation_probe_candidate || return 1

    xrandr_output='eDP connected primary 2880x1920+0+0
DisplayPort-1 connected
   3440x1440     59.97 +'
    fingerprint_output="DisplayPort-1 ${valid_base}"
    ! find_activation_probe_candidate || return 1

    fingerprint_output="DisplayPort-1 ${invalid_base}abcd"
    ! find_activation_probe_candidate || return 1

    fingerprint_output="DisplayPort-1 ${valid_base}abcd"
    detected_output=samsung
    cp "$tmp/home/.config/autorandr/samsung/setup" \
        "$tmp/home/.config/autorandr/other/setup"
    ! find_activation_probe_candidate || return 1

    printf '%s\n' 'DisplayPort-1 unrelated' "eDP ${valid_base}abcd" \
        > "$tmp/home/.config/autorandr/other/setup"
    [[ $(find_activation_probe_candidate) == 'samsung DisplayPort-1 eDP 3440x1440' ]]
}

test_captured_samsung_failure_is_probe_candidate () {
    local tmp xrandr_output fingerprint_output
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    HOME=$repo
    runtime_dir=$tmp/runtime
    output_mapping_file=$runtime_dir/output-mappings
    mkdir -p "$runtime_dir"
    xrandr_output='eDP connected primary 2880x1920+0+0
DisplayPort-1 connected
   3440x1440     59.97 +'
    fingerprint_output=$(grep -v '^#' "$failure_fixture")

    xrandr () { printf '%s\n' "$xrandr_output"; }
    autorandr () { printf '%s\n' "$fingerprint_output"; }
    get_detected_profiles () { return 0; }
    profile_matches_connected_outputs () { return 0; }
    get_drm_edid_for_output () { printf '%s\n' "${fingerprint_output#* }"; }

    [[ $(find_activation_probe_candidate) == \
        'celtic+Samsung-Odyssey-G75F DisplayPort-1 eDP 3440x1440' ]]
}

test_profile_readiness_requires_checksum_valid_drm_edid () {
    local tmp zeros valid_base fingerprint_output drm_output
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    printf -v zeros '%0238d' 0
    valid_base="00ffffffffffff00${zeros}06"
    fingerprint_output="DisplayPort-1 ${valid_base}"
    drm_output=$valid_base

    autorandr () { printf '%s\n' "$fingerprint_output"; }
    resolve_profile_outputs () { printf '%s\n' DisplayPort-1; }
    get_drm_edid_for_output () { printf '%s\n' "$drm_output"; }

    profile_live_edids_ready samsung || return 1
    drm_output="${valid_base}abcd"
    ! profile_live_edids_ready samsung
}

test_activation_probe_uses_admitted_mode () {
    local command=""
    # shellcheck disable=SC1090
    source "$watcher"
    xrandr () { command=$*; }

    run_activation_probe samsung DisplayPort-1 eDP 3440x1440 >/dev/null 2>&1 &&
        [[ $command == '--output DisplayPort-1 --mode 3440x1440 --right-of eDP' ]]
}

test_activation_probe_waits_for_full_profile_match () {
    local tmp attempts probes finalizations finalized_profile applied detection_count_file
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    probes=0
    finalizations=0
    finalized_profile=""
    applied=""
    detection_count_file=$tmp/detection-count
    printf '%s\n' 0 > "$detection_count_file"
    prepare_watcher "$tmp"

    connected_external_present () { return 0; }
    profile_live_edids_ready () { return 0; }
    find_activation_probe_candidate () {
        printf '%s\n' 'samsung DisplayPort-1 eDP 3440x1440'
    }
    run_activation_probe () {
        probes=$((probes + 1))
        [[ $1 == samsung && $2 == DisplayPort-1 && $3 == eDP && $4 == 3440x1440 ]]
    }
    get_detected_profiles () {
        local count
        count=$(<"$detection_count_file")
        count=$((count + 1))
        printf '%s\n' "$count" > "$detection_count_file"
        ((count >= 2)) && printf '%s\n' samsung
        return 0
    }
    apply_profile () {
        attempts=$((attempts + 1))
        applied=${1:-change}
        printf '%s\n' samsung > "$pending_profile_file"
    }
    wait_for_quiescence () { return 0; }
    get_current_profiles () { printf '%s\n' samsung; }
    profile_outputs_connected () { [[ $1 == samsung ]]; }
    profile_matches_connected_outputs () { [[ $1 == samsung ]]; }
    profile_matches_active_outputs () { [[ $1 == samsung ]]; }
    finalize_postswitch () {
        finalizations=$((finalizations + 1))
        finalized_profile=$1
    }

    reconcile test >/dev/null 2>&1 &&
        [[ $probes -eq 1 ]] &&
        [[ $attempts -eq 1 ]] &&
        [[ $applied == samsung ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == samsung ]]
}

test_kernel_only_external_presence_blocks_laptop_fallback () {
    local tmp xrandr_status=0
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    drm_sysfs_dir=$tmp/drm
    mkdir -p "$drm_sysfs_dir/card1-DP-2"
    printf '%s\n' connected > "$drm_sysfs_dir/card1-DP-2/status"
    xrandr () {
        ((xrandr_status == 0)) || return "$xrandr_status"
        printf '%s\n' 'eDP connected primary 2880x1920+0+0'
    }

    connected_external_present || return 1
    printf '%s\n' disconnected > "$drm_sysfs_dir/card1-DP-2/status"
    ! connected_external_present || return 1
    xrandr_status=1
    connected_external_present
}

test_unresolved_external_never_reaches_autorandr_fallback () {
    local tmp applications
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    applications=0
    prepare_watcher "$tmp"
    MAX_RECONCILE_ATTEMPTS=2

    connected_external_present () { return 0; }
    get_detected_profiles () { return 0; }
    find_activation_probe_candidate () { return 1; }
    apply_profile () { applications=$((applications + 1)); }

    reconcile test >/dev/null 2>&1 && [[ $applications -eq 0 ]]
}

test_probe_does_not_apply_until_drm_edid_is_ready () {
    local tmp probes applications
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    probes=0
    applications=0
    prepare_watcher "$tmp"
    MAX_RECONCILE_ATTEMPTS=3

    connected_external_present () { return 0; }
    get_detected_profiles () { printf '%s\n' samsung; }
    profile_matches_connected_outputs () { [[ $1 == samsung ]]; }
    profile_live_edids_ready () { return 1; }
    find_activation_probe_candidate () {
        printf '%s\n' 'samsung DisplayPort-1 eDP 3440x1440'
    }
    run_activation_probe () { probes=$((probes + 1)); }
    apply_profile () { applications=$((applications + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $probes -eq 1 ]] && [[ $applications -eq 0 ]]
}

test_changed_probe_evidence_is_not_dispatched () {
    local tmp probes applications count_file
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    probes=0
    applications=0
    count_file=$tmp/candidate-count
    printf '%s\n' 0 > "$count_file"
    prepare_watcher "$tmp"
    MAX_RECONCILE_ATTEMPTS=1

    connected_external_present () { return 0; }
    get_detected_profiles () { return 0; }
    find_activation_probe_candidate () {
        local count
        count=$(<"$count_file")
        count=$((count + 1))
        printf '%s\n' "$count" > "$count_file"
        if ((count == 1)); then
            printf '%s\n' 'samsung DisplayPort-1 eDP 3440x1440'
        else
            printf '%s\n' 'samsung DisplayPort-1 eDP 5120x2160'
        fi
    }
    run_activation_probe () { probes=$((probes + 1)); }
    apply_profile () { applications=$((applications + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $probes -eq 0 ]] && [[ $applications -eq 0 ]]
}

test_retry_profile_requires_exact_connected_outputs () {
    local tmp command exact_match
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    prepare_watcher "$tmp"
    mkdir -p "$tmp/home/bin"
    printf '#!/bin/sh\nexit 0\n' > "$tmp/home/bin/clear-dpy-cache"
    chmod +x "$tmp/home/bin/clear-dpy-cache"
    HOME=$tmp/home
    command=""
    exact_match=0

    profile_matches_connected_outputs () { [[ $exact_match -eq 1 ]]; }
    autorandr_command () { command=$*; }

    ! apply_profile celtic >/dev/null 2>&1 || return 1
    [[ -z $command ]] || return 1

    apply_profile "" >/dev/null 2>&1 || return 1
    [[ $command == --change ]] || return 1

    exact_match=1
    apply_profile samsung >/dev/null 2>&1 || return 1
    [[ $command == '--load samsung' ]]
}

test_active_output_match_rejects_disabled_or_extra_output () {
    local tmp xrandr_output
    # Source before installing the RETURN cleanup trap; sourcing itself counts
    # as a return and would otherwise remove the fixture immediately.
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    mkdir -p "$tmp/home/.config/autorandr/celtic" \
             "$tmp/home/.config/autorandr/samsung"
    printf '%s\n' eDP > "$tmp/home/.config/autorandr/celtic/setup"
    printf '%s\n' DisplayPort-1 eDP > "$tmp/home/.config/autorandr/samsung/setup"

    HOME=$tmp/home
    xrandr () { printf '%s\n' "$xrandr_output"; }

    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-1 connected'
    ! profile_matches_active_outputs celtic &&
        ! profile_matches_active_outputs samsung || return 1

    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-1 connected primary 5120x2160+-5120+0'
    profile_matches_connected_outputs samsung &&
        profile_matches_active_outputs samsung || return 1

    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-1 disconnected'
    profile_matches_connected_outputs celtic &&
        profile_matches_active_outputs celtic
}

test_connector_rename_is_resolved_by_edid () {
    local tmp xrandr_output resolved detected
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    mkdir -p "$tmp/home/.config/autorandr/aoc"
    printf '%s\n' 'DisplayPort-2 aoc-edid' 'eDP laptop-edid' \
        > "$tmp/home/.config/autorandr/aoc/setup"
    HOME=$tmp/home
    runtime_dir=$tmp/runtime
    output_mapping_file=$runtime_dir/output-mappings
    mkdir -p "$runtime_dir"

    autorandr_command () {
        printf '%s\n' 'aoc: renaming display DisplayPort-2 to DisplayPort-1' >&2
        printf '%s\n' aoc
    }
    xrandr () { printf '%s\n' "$xrandr_output"; }

    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-1 connected primary 3840x2160+2880+0'
    detected=$(get_detected_profiles) || return 1
    [[ $detected == aoc ]] || return 1
    resolved=$(resolve_profile_outputs aoc) || return 1
    [[ $resolved == $'DisplayPort-1\neDP' ]] &&
        profile_matches_connected_outputs aoc &&
        profile_matches_active_outputs aoc || return 1

    xrandr_output+=$'\nDisplayPort-3 connected 1920x1080+6720+0'
    ! profile_matches_connected_outputs aoc &&
        ! profile_matches_active_outputs aoc || return 1

    # Returning to the saved connector emits no rename diagnostic. Detection
    # must replace the stale DisplayPort-1 mapping with the identity mapping.
    autorandr_command () { printf '%s\n' aoc; }
    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-2 connected primary 3840x2160+2880+0'
    get_detected_profiles >/dev/null || return 1
    resolved=$(resolve_profile_outputs aoc) || return 1
    [[ $resolved == $'DisplayPort-2\neDP' ]] &&
        profile_matches_active_outputs aoc
}

test_applied_rename_survives_lost_detection () {
    local tmp xrandr_output
    # shellcheck disable=SC1090
    source "$watcher"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    mkdir -p "$tmp/home/.config/autorandr/aoc" "$tmp/runtime"
    printf '%s\n' 'DisplayPort-2 aoc-edid' 'eDP laptop-edid' \
        > "$tmp/home/.config/autorandr/aoc/setup"
    HOME=$tmp/home
    runtime_dir=$tmp/runtime
    output_mapping_file=$runtime_dir/output-mappings

    autorandr_command () {
        printf '%s\n' 'aoc: renaming display DisplayPort-2 to DisplayPort-1' >&2
    }
    autorandr_recording_mappings --change >/dev/null 2>&1 || return 1

    # Simulate the following detection query seeing no usable external EDID.
    autorandr_command () { return 0; }
    [[ -z $(get_detected_profiles) ]] || return 1
    xrandr_output='eDP connected 2880x1920+0+0
DisplayPort-1 connected'
    xrandr () { printf '%s\n' "$xrandr_output"; }

    [[ $(resolve_profile_outputs aoc) == $'DisplayPort-1\neDP' ]] &&
        profile_matches_connected_outputs aoc
}

test_autorandr_commands_match_by_edid () {
    local command
    # shellcheck disable=SC1090
    source "$watcher"
    command=""
    AUTORANDR_SKIP_OPTIONS=gamma

    autorandr () { command=$*; }

    autorandr_command --detected >/dev/null 2>&1 &&
        [[ $command == '--match-edid --detected --skip-options gamma' ]]
}

test_profile_stability_rechecks_current_state () {
    local tmp samples
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    samples=0
    prepare_watcher "$tmp"
    PROFILE_STABILITY_SECONDS=3
    PROFILE_STABILITY_POLL_SECONDS=1

    read_drm_event () { samples=$((samples + 1)); return 1; }
    get_detected_profiles () { printf '%s\n' samsung; }
    get_current_profiles () {
        [[ $samples -lt 2 ]] && printf '%s\n' samsung || printf '%s\n' celtic
    }
    profile_outputs_connected () { return 0; }

    ! wait_for_profile_stability samsung >/dev/null 2>&1 &&
        [[ $samples -eq 2 ]]
}

test_profile_stability_catches_event_after_final_query () {
    local tmp reads
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    reads=0
    prepare_watcher "$tmp"
    PROFILE_STABILITY_SECONDS=1
    PROFILE_STABILITY_POLL_SECONDS=1

    read_drm_event () {
        reads=$((reads + 1))
        [[ $reads -eq 2 ]] && return 0
        return 1
    }
    get_detected_profiles () { printf '%s\n' samsung; }
    get_current_profiles () { printf '%s\n' samsung; }
    profile_outputs_connected () { return 0; }

    ! wait_for_profile_stability samsung >/dev/null 2>&1 &&
        [[ $reads -eq 2 ]]
}

test_automatically_current_new_profile_runs_relayout () {
    local tmp attempts finalizations finalized_profile
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    finalized_profile=""
    prepare_watcher "$tmp"
    LAST_CONVERGED_PROFILE=samsung

    # Simulate X automatically reaching the internal-only profile before
    # autorandr runs, so no deferred postswitch marker is produced.
    apply_profile () { attempts=$((attempts + 1)); }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () { printf '%s\n' celtic; }
    get_current_profiles () { printf '%s\n' celtic; }
    finalize_postswitch () {
        finalizations=$((finalizations + 1))
        finalized_profile=$1
    }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 1 ]] &&
        [[ $finalizations -eq 1 ]] &&
        [[ $finalized_profile == celtic ]]
}

test_unmatched_topology_is_retried_without_relayout () {
    local tmp attempts finalizations
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    prepare_watcher "$tmp"
    MAX_RECONCILE_ATTEMPTS=2

    apply_profile () { attempts=$((attempts + 1)); }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () { return 0; }
    get_current_profiles () { return 0; }
    finalize_postswitch () { finalizations=$((finalizations + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $finalizations -eq 0 ]]
}

test_retry_count_is_bounded () {
    local tmp attempts finalizations
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    attempts=0
    finalizations=0
    prepare_watcher "$tmp"
    MAX_RECONCILE_ATTEMPTS=2

    apply_profile () {
        attempts=$((attempts + 1))
        printf '%s\n' samsung > "$pending_profile_file"
    }
    wait_for_quiescence () { return 0; }
    get_detected_profiles () { printf '%s\n' samsung; }
    get_current_profiles () { return 0; }
    finalize_postswitch () { finalizations=$((finalizations + 1)); }

    reconcile test >/dev/null 2>&1 &&
        [[ $attempts -eq 2 ]] &&
        [[ $finalizations -eq 0 ]] &&
        [[ $(cat "$pending_profile_file") == samsung ]]
}

test_postswitch_deferral_records_profile_only () {
    local tmp pending output
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    pending=$tmp/pending

    output=$(AUTORANDR_CURRENT_PROFILE=samsung \
        MONITOR_WATCHER_NG_DEFER_POSTSWITCH=1 \
        MONITOR_WATCHER_NG_PENDING_PROFILE_FILE="$pending" \
        bash "$postswitch" 2>&1) &&
        [[ $(cat "$pending") == samsung ]] &&
        [[ $output == *"deferred desktop reconfiguration"* ]]
}

run_test 'DRM event during apply causes a retry' test_event_during_apply_is_retried
run_test 'detected-but-not-current profile causes a retry' test_detected_but_not_current_is_retried
run_test 'previously matched profile is explicitly retried' test_previously_matched_profile_is_explicitly_retried
run_test 'transient fallback preserves the pending external profile' test_transient_fallback_preserves_external_profile
run_test 'genuine unplug replaces a pending external profile' test_genuine_unplug_replaces_pending_external_profile
run_test 'internal marker expands to Samsung without another event' test_internal_marker_can_expand_without_another_event
run_test 'activation probe requires one valid known base identity' test_activation_probe_requires_unique_valid_base_identity
run_test 'captured Samsung failure is a unique probe candidate' test_captured_samsung_failure_is_probe_candidate
run_test 'profile readiness requires checksum-valid DRM EDID' test_profile_readiness_requires_checksum_valid_drm_edid
run_test 'activation probe uses only the admitted preferred mode' test_activation_probe_uses_admitted_mode
run_test 'activation probe waits for complete profile before apply' test_activation_probe_waits_for_full_profile_match
run_test 'kernel-only external presence blocks laptop fallback' test_kernel_only_external_presence_blocks_laptop_fallback
run_test 'unresolved external never reaches autorandr fallback' test_unresolved_external_never_reaches_autorandr_fallback
run_test 'probe waits for checksum-valid DRM EDID before apply' test_probe_does_not_apply_until_drm_edid_is_ready
run_test 'changed probe evidence is not dispatched' test_changed_probe_evidence_is_not_dispatched
run_test 'retry profile must exactly match connected outputs' test_retry_profile_requires_exact_connected_outputs
run_test 'active-output matching rejects disabled and extra outputs' test_active_output_match_rejects_disabled_or_extra_output
run_test 'connector renaming is resolved by EDID' test_connector_rename_is_resolved_by_edid
run_test 'applied connector rename survives lost detection' test_applied_rename_survives_lost_detection
