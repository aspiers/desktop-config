#!/bin/bash
#
# tray-diag - snapshot system tray / WM state for diagnosing missing tray
# icons and misplaced windows after a display change.
#
# Run immediately after the failure appears and BEFORE restarting fluxbox,
# xfce4-panel or nm-applet, then again once things work, and diff the two.
#
# The system tray is an X selection, not a root window property, so
# 'xprop -root _NET_SYSTEM_TRAY_S0' always reports "not found" and must not
# be used to test for it.

set -uo pipefail

export DISPLAY="${DISPLAY:-:0}"

# Write straight to the file rather than through 'tee' in a process
# substitution: when stdout is itself redirected (e.g. to /dev/null by an
# unattended caller), the substituted process can be torn down before it
# flushes, leaving no file at all.
out=${1:-}
if [ -n "$out" ]; then
    exec >"$out" 2>&1
fi

section() {
    printf '\n=== %s ===\n' "$1"
}

section "timestamp"
date '+%Y-%m-%d %H:%M:%S'

section "X selection owners"
python3 - <<'EOF'
from ctypes import CDLL, c_void_p, c_char_p, c_int, c_ulong

x = CDLL('libX11.so.6')
x.XOpenDisplay.argtypes = [c_char_p]
x.XOpenDisplay.restype = c_void_p
x.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
x.XInternAtom.restype = c_ulong
x.XGetSelectionOwner.argtypes = [c_void_p, c_ulong]
x.XGetSelectionOwner.restype = c_ulong

import os
d = x.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
if not d:
    raise SystemExit('cannot open display')

for name in (b'_NET_SYSTEM_TRAY_S0', b'_NET_SYSTEM_TRAY_S1', b'MANAGER'):
    atom = x.XInternAtom(d, name, 1)
    owner = x.XGetSelectionOwner(d, atom) if atom else 0
    state = f'0x{owner:x}' if owner else 'NONE'
    print(f'{name.decode():24} {state}')
EOF

section "tray owner details"
owner=$(python3 - <<'EOF'
from ctypes import CDLL, c_void_p, c_char_p, c_int, c_ulong
import os
x = CDLL('libX11.so.6')
x.XOpenDisplay.argtypes = [c_char_p]
x.XOpenDisplay.restype = c_void_p
x.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
x.XInternAtom.restype = c_ulong
x.XGetSelectionOwner.argtypes = [c_void_p, c_ulong]
x.XGetSelectionOwner.restype = c_ulong
d = x.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
atom = x.XInternAtom(d, b'_NET_SYSTEM_TRAY_S0', 1)
print(hex(x.XGetSelectionOwner(d, atom)) if atom else '')
EOF
)
if [ -n "$owner" ] && [ "$owner" != "0x0" ]; then
    echo "owner window: $owner"
    xprop -id "$owner" 2>&1 |
        grep -E '_NET_WM_PID|_NET_SYSTEM_TRAY|WM_NAME' || true
    tray_pid=$(xprop -id "$owner" _NET_WM_PID 2>/dev/null |
        grep -oE '[0-9]+$')
    [ -n "$tray_pid" ] && ps -o pid,lstart,cmd -p "$tray_pid" 2>&1

    # Which panel does the tray belong to? Icon size is derived from the
    # containing panel's height, so a tray parented to a stale or off-screen
    # panel hands out undersized icons positioned outside the visible area.
    echo "--- tray owner ancestry (geometry of each ancestor) ---"
    xwininfo -id "$owner" -all 2>/dev/null |
        grep -E 'Parent|Absolute|Width|Height|Map State' || true
    parent=$(xwininfo -id "$owner" -tree 2>/dev/null |
        grep -oE 'Parent window id: 0x[0-9a-f]+' |
        grep -oE '0x[0-9a-f]+')
    depth=0
    while [ -n "$parent" ] && [ "$parent" != "0x0" ] && [ "$depth" -lt 6 ]; do
        printf 'ancestor[%d] %s  %s\n' \
            "$depth" "$parent" \
            "$(xwininfo -id "$parent" 2>/dev/null |
                grep -E 'Width|Height|Absolute upper-left' |
                tr -s ' \n' ' ')"
        parent=$(xwininfo -id "$parent" -tree 2>/dev/null |
            grep -oE 'Parent window id: 0x[0-9a-f]+' |
            grep -oE '0x[0-9a-f]+')
        depth=$((depth + 1))
    done
else
    echo "NO TRAY OWNER - nothing can dock an icon"
fi

section "panel windows and sizes"
echo "--- configured sizes ---"
for p in 1 2 3; do
    printf 'panel-%s size=%s output=%s\n' "$p" \
        "$(xfconf-query -c xfce4-panel -p "/panels/panel-$p/size" 2>/dev/null)" \
        "$(xfconf-query -c xfce4-panel -p "/panels/panel-$p/output-name" \
            2>/dev/null)"
done
echo "--- live panel window geometry ---"
for w in $(xwininfo -root -tree 2>/dev/null |
    grep -i 'xfce4-panel' | grep -oE '0x[0-9a-f]+'); do
    printf '%s %s\n' "$w" \
        "$(xwininfo -id "$w" 2>/dev/null |
            grep -E 'Width|Height|Absolute upper-left|Map State' |
            tr -s ' \n' ' ')"
done

section "window manager"
wm=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null |
    grep -oE '0x[0-9a-f]+')
if [ -n "$wm" ]; then
    echo "wm check window: $wm"
    xprop -id "$wm" _NET_WM_NAME 2>&1
else
    echo "NO WM MANAGING SCREEN"
fi
# lstart matters: fluxbox's own Shift+Ctrl+Mod4+r re-execs IN PLACE, keeping
# the same PID, so an unchanged PID does not mean fluxbox was never restarted.
ps -o pid,lstart,cmd -C fluxbox 2>&1

section "root window properties"
# Notifications landing at +0+0 after a resume (dc-esm) are not explained by
# any of these - they were byte-identical either side of the fluxbox restart
# that fixed placement. Recorded anyway so the claim can be re-checked rather
# than re-assumed, and because _NET_CURRENT_DESKTOP was the one property NOT
# captured in the failing state.
for prop in _NET_DESKTOP_GEOMETRY _NET_WORKAREA _NET_CURRENT_DESKTOP \
            _NET_NUMBER_OF_DESKTOPS _NET_DESKTOP_VIEWPORT \
            _NET_ACTIVE_WINDOW _NET_SUPPORTED; do
    printf '%-26s %s\n' "$prop" \
        "$(xprop -root "$prop" 2>/dev/null | sed 's/.*= //' | cut -c1-160)"
done

section "monitor views compared"
# Two independent views of the same hardware. If they disagree, a client
# using one will place windows where a client using the other would not.
echo "--- RandR (xrandr) ---"
xrandr --query 2>/dev/null | grep -E ' connected' | sed 's/(.*//'
echo "--- Xinerama (what the WM synthesises) ---"
xdpyinfo -ext XINERAMA 2>/dev/null |
    sed -n '/XINERAMA/,/^$/p' | grep -E 'head #|screen #' || echo "(none)"
echo "--- Gdk monitors (what GTK clients such as notifyd see) ---"
python3 - <<'EOF' 2>&1 || echo "(gdk query failed)"
import gi
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk

display = Gdk.Display.get_default()
if display is None:
    raise SystemExit('(no display)')
for i in range(display.get_n_monitors()):
    m = display.get_monitor(i)
    g = m.get_geometry()
    w = m.get_workarea()
    print(f'  [{i}] {m.get_model()} '
          f'geom={g.width}x{g.height}+{g.x}+{g.y} '
          f'workarea={w.width}x{w.height}+{w.x}+{w.y} '
          f'primary={m.is_primary()} scale={m.get_scale_factor()}')
EOF

section "pointer position"
# xfce4-notifyd is configured show-notifications-on=active-monitor, and the
# pointer is what defines "active", so placement cannot be judged without it.
pointer=$(xdotool getmouselocation --shell 2>/dev/null)
if [ -n "$pointer" ]; then
    echo "$pointer" | tr '\n' ' '
    echo
    # Name the monitor the pointer is on, which is the one notifications
    # should appear on.
    px=$(printf '%s\n' "$pointer" | sed -n 's/^X=//p')
    py=$(printf '%s\n' "$pointer" | sed -n 's/^Y=//p')
    xrandr --query 2>/dev/null |
        awk -v px="$px" -v py="$py" '
            / connected/ && match($0, /([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)/) {
                geo = substr($0, RSTART, RLENGTH)
                split(geo, a, /[x+]/)
                if (px >= a[3] && px < a[3] + a[1] &&
                    py >= a[4] && py < a[4] + a[2])
                    printf "pointer is on %s (%s)\n", $1, geo
            }'
else
    echo "(pointer query failed)"
fi

section "notification daemon"
ps -o pid,lstart,cmd -C xfce4-notifyd 2>&1
for prop in /notify-location /show-notifications-on /do-not-disturb \
            /primary-monitor; do
    printf '%-24s %s\n' "$prop" \
        "$(xfconf-query -c xfce4-notifyd -p "$prop" 2>&1)"
done

section "panel and applets"
ps -o pid,lstart,cmd -C xfce4-panel 2>&1
ps -o pid,lstart,cmd -C nm-applet 2>&1

echo "--- StatusNotifier host and nm-applet item ---"
watcher=org.kde.StatusNotifierWatcher
if busctl --user status "$watcher" >/dev/null 2>&1; then
    busctl --user status "$watcher" 2>&1 |
        grep -E '^(PID|PPID|Comm|Exe|CommandLine)=' || true
    items=$(busctl --user get-property "$watcher" /StatusNotifierWatcher \
        org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>&1)
    printf 'RegisteredStatusNotifierItems: %s\n' "$items"
    item=$(printf '%s\n' "$items" |
        grep -oE '"[^"]*/[^" ]*nm_applet"' | head -1 | tr -d '"')
    if [ -n "$item" ]; then
        destination=${item%%/*}
        path=/${item#*/}
        printf 'nm-applet item: destination=%s path=%s\n' "$destination" "$path"
        for property in Id Title Status IconName; do
            printf '%s: ' "$property"
            busctl --user get-property "$destination" "$path" \
                org.kde.StatusNotifierItem "$property" 2>&1 || true
        done
    else
        echo "NO NM-APPLET STATUSNOTIFIER ITEM REGISTERED"
    fi
else
    echo "NO STATUSNOTIFIER HOST"
fi

echo "--- panel plugin wrappers (start times reveal which respawned) ---"
for p in $(pgrep -f 'xfce4/panel/wrapper-2.0'); do
    printf '%s ppid=%s %s %s\n' \
        "$p" \
        "$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')" \
        "$(ps -o lstart= -p "$p" 2>/dev/null)" \
        "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null |
            grep -oE 'lib[a-z]+\.so')"
done

section "docked tray icons"
xwininfo -root -tree 2>/dev/null |
    grep -iE 'tray|applet|nm-|status_icon' | head -20 ||
    echo "(none found)"

section "monitor geometry"
xrandr --query 2>&1 | grep -E ' connected'

section "notification placement probe"
notify-send "tray-diag" "placement probe" 2>&1
sleep 0.5
nwin=$(wmctrl -lx 2>/dev/null | grep -i notifyd | awk '{print $1}' | head -1)
if [ -n "$nwin" ]; then
    xwininfo -id "$nwin" 2>&1 |
        grep -E 'Absolute|Width|Height|Map State'
else
    echo "(no notification window found)"
fi
