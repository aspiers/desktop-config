#!/usr/bin/env python3
#
# N.B. screen numbers from libdpy and layouts are numbered counting
# from 0 and going left to right by X coordinate.
#
# Debug by:
# - running ~/lib/libdpy.py
# - making sure screens list in layout matches
#   left-to-right order
# - running ~/lib/liblayout.py $layout_name

import argparse
import json
from pprint import pp
import subprocess
import os
import os.path
import sys
import time
import yaml

sys.path.append(os.getenv('HOME') + '/lib')

import libdpy
import liblayout


MAGIC_CMDS = {
    '<stick>': 'If {Matches (Stuck=no)} {Stick}',
    '<unstick>': 'If {Matches (Stuck=yes)} {Stick}',
}


def expand_magic(cmd):
    for magic, expansion in MAGIC_CMDS.items():
        cmd = cmd.replace(magic, expansion)
        #print("cmd %s after expanding %s to %s" % (cmd, magic, expansion))
    return cmd


def combine_commands(cmds):
    """Combine commands into one flat Fluxbox MacroCmd.

    Fluxbox needs a short pause between remote layout operations for reliable
    window matching.  Sending every command for the same matcher separately
    paid that pause repeatedly.  Flatten existing MacroCmd bodies rather than
    nesting them, preserving command order in one Map operation.
    """
    if len(cmds) == 1:
        return cmds[0]

    parts = []
    for cmd in cmds:
        if cmd.startswith('MacroCmd '):
            parts.append(cmd.removeprefix('MacroCmd '))
        else:
            parts.append('{%s}' % cmd)
    return 'MacroCmd %s' % ' '.join(parts)


def exec_window_cmds(window_cmds, args):
    for matcher, *cmds in window_cmds:
        matcher = expand_magic(matcher)
        print(matcher)
        expanded = [expand_magic(cmd) for cmd in cmds]
        combined = combine_commands(expanded)
        map_cmd = "Map {%s} {Matches %s}" % (combined, matcher)
        print("   %s" % map_cmd)
        if not args.dump:
            subprocess.check_call(['fluxbox-remote', map_cmd])
            # A 10ms delay was unreliable (ca44f65); retain the proven 100ms
            # pacing between matchers while avoiding duplicate waits within
            # one matcher's now-atomic command sequence.
            time.sleep(0.1)
        print()


def exec_resolved_actions(actions, args):
    """Apply exact planning-expanded map commands without live discovery."""
    for action in actions:
        print(action['matcher'])
        print("   %s" % action['map_command'])
        if not args.dump:
            subprocess.check_call(['fluxbox-remote', action['map_command']])
            time.sleep(0.1)
        print()


def load_resolved_actions(path):
    if os.path.getsize(path) > 512 * 1024:
        raise ValueError('resolved action payload exceeds size limit')
    with open(path, encoding='utf-8') as stream:
        value = json.load(stream)
    if not isinstance(value, list) or not value or len(value) > 4096:
        raise ValueError('resolved action payload must be a bounded non-empty list')
    for action in value:
        if not isinstance(action, dict) or set(action) != {
                'commands', 'map_command', 'matcher'}:
            raise ValueError('resolved action has an invalid field set')
        if not isinstance(action['matcher'], str) or not action['matcher']:
            raise ValueError('resolved action matcher is invalid')
        if not isinstance(action['map_command'], str) or not action['map_command']:
            raise ValueError('resolved action map command is invalid')
        commands = action['commands']
        if (not isinstance(commands, list) or not commands or
                not all(isinstance(command, str) and command
                        for command in commands)):
            raise ValueError('resolved action commands are invalid')
    return value


def exec_cmds(cmds, args):
    for cmd in cmds:
        expanded = expand_magic(cmd)
        print("   %s" % expanded)
        if not args.dump:
            subprocess.check_call(['fluxbox-remote', expanded])
            time.sleep(0.1)

    print()


def parse_args():
    parser = argparse.ArgumentParser(
        description='Activate a desktop layout')
    parser.add_argument(
        '--dump',
        action='store_true',
        default=False,
        help="Just show expanded layout; don't apply")
    parser.add_argument(
        '--dir',
        type=str,
        default=os.path.expanduser('~/.fluxbox/layouts'),
        help='Directory containing YAML layout files')
    parser.add_argument(
        '-s',
        '--sublayout',
        type=str,
        help='Name of a sublayout to apply instead of full layout')
    parser.add_argument(
        '--resolved-actions',
        type=str,
        help='Planning-staged JSON map commands; bypass all layout discovery')
    parser.add_argument(
        'layout',
        type=str,
        nargs='?',
        help='Name of a layout pointing to a YAML file with '
        'window matching patterns and commands')
    args = parser.parse_args()
    if bool(args.resolved_actions) == bool(args.layout):
        parser.error('supply exactly one of layout or --resolved-actions')
    if args.resolved_actions and args.sublayout:
        parser.error('--sublayout cannot be combined with --resolved-actions')
    return args


def init_magic_cmds(layout_params):
    current_screen = libdpy.get_current_screen_info()
    for i, s in enumerate(layout_params):
        print("Screen %d:" % i)

        for prefix in ('s%d_' % i, 's_%s_' % s['assignment']):
            for k, v in s.items():
                k2 = prefix + k
                v2 = str(v) + ("%" if k.endswith('_pc') else '')
                MAGIC_CMDS['<%s>' % k2] = v2
                if i == current_screen['num']:
                    # define sX to mean the screen the
                    # mouse's currently on
                    MAGIC_CMDS['<sX_%s>' % k] = v2
                print("  %s: %s" % (k2, v2))

    if '<s_primary_num>' not in MAGIC_CMDS:
        sys.stderr.write(
            "Didn't find <s_primary_num> in MAGIC_CMDS; is your primary monitor set?\n"
        )
        sys.exit(1)

    define_place_rhs(layout_params)

    print()


def define_place_rhs(layout_params):
    # <place_RHS> abstracts "put this window where the right-hand-side display
    # goes".  On a multi-monitor layout that is the secondary head (e.g. the
    # Dell in celtic+BenQ+Dell).  On an ultrawide single-screen layout there is
    # no separate head, so it becomes the full-height third column of the
    # primary screen.  Either way the window is made sticky, matching how the
    # RHS display was used before.  Detection: the primary screen advertises a
    # non-zero col3 iff the layout is 3-column (see liblayout col3_* geometry).
    # On a plain single-screen layout (no secondary, no col3) there is no RHS,
    # so <place_RHS> is deliberately left undefined.
    primary = next(
        (s for s in layout_params if s.get('assignment') == 'primary'), None
    )
    if primary and int(primary.get('col3_width', 0)) > 0:
        MAGIC_CMDS['<place_RHS>'] = (
            'MacroCmd '
            '{%s} '
            '{MoveTo %d %d} '
            '{ResizeTo %d %d} '
            '{%s}'
        ) % (
            MAGIC_CMDS['<s_primary_SetHead>'],
            primary['col3_left'], primary['row1_top'],
            primary['col3_width'], primary['active_height'],
            MAGIC_CMDS['<stick>'],
        )
    elif '<s_secondary_SetHead>' in MAGIC_CMDS:
        MAGIC_CMDS['<place_RHS>'] = 'MacroCmd {%s} {%s}' % (
            MAGIC_CMDS['<s_secondary_SetHead>'],
            MAGIC_CMDS['<stick>'],
        )


def apply_sublayout(layout_file, sublayouts, args):
    name = args.sublayout
    if not name in sublayouts:
        sys.stderr.write(
            "Didn't find sublayout '%s' in %s\n" %
            (name, sublayout_file)
        )
        sys.exit(1)

    sublayout = sublayouts[name]
    exec_cmds(sublayout, args)


def main():
    args = parse_args()

    try:
        active_win_id = subprocess.check_output(['xdotool', 'getactivewindow']).rstrip()
    except subprocess.CalledProcessError:
        active_win_id = None

    if args.resolved_actions:
        try:
            actions = load_resolved_actions(args.resolved_actions)
        except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as error:
            sys.stderr.write("Invalid resolved action payload: %s\n" % error)
            return 2
        exec_resolved_actions(actions, args)
        if active_win_id:
            subprocess.call(['wmctrl', '-ia', active_win_id])
        return 0

    layout_file = liblayout.get_layout_file(args.layout, args.dir)
    layout_params, layout = liblayout.get_layout_params(layout_file)
    window_cmds = layout['windows']

    init_magic_cmds(layout_params)

    if args.sublayout:
        sublayout_file = liblayout.get_sublayout_file()
        with open(sublayout_file) as sf:
            sublayouts = yaml.safe_load(sf)
            apply_sublayout(sublayout_file, sublayouts, args)
    else:
        # pp(window_cmds)
        exec_window_cmds(window_cmds, args)

    if active_win_id:
        subprocess.call(['wmctrl', '-ia', active_win_id])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
